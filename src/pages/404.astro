---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <div class="wrap page-body" style="padding-top:var(--sp-8)">
    <p class="label">Error 404</p>
    <h1 style="margin-top:var(--sp-3);max-width:18ch">That page is not in the brief.</h1>
    <p class="lead" style="margin-top:var(--sp-4);max-width:40rem">
      The address may be mistyped, or the page may have moved. Search finds any subtopic, term, tool or case, and the coverage page lists what exists for every part of the course.
    </p>
    <p class="cluster" style="margin-top:var(--sp-5)">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn" href="/topics/">Topics</a>
      <a class="btn" href="/ib/coverage/">Coverage</a>
      <a class="btn" href="/search/">Search</a>
    </p>
  </div>
</BaseLayout>
