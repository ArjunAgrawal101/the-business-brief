---
/**
 * The diagram library: every diagram on the platform, by unit and the
 * toolkit, each with its text description, the subtopics it serves and an
 * SVG download.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import SaveButton from '../../components/ui/SaveButton.astro';
import { DIAGRAMS, DIAGRAM_GROUPS } from '../../lib/diagrams';
import { corpus } from '../../lib/content';
import { allSubtopics, codeKey, subtopicHref } from '../../lib/learning';
import { library } from '../../lib/frameworks-content';
import { frameworkHref } from '../../lib/frameworks';

const c = await corpus();
const subs = allSubtopics(c);
const titleOf = (code: string) => subs.find((x) => x.s.code === code)?.s.title ?? code;
const all = Object.entries(DIAGRAMS);
const groups = DIAGRAM_GROUPS.map((g) => ({
  ...g,
  items: all.filter(([, d]) => d.group === g.id).sort((a, b) => codeKey(a[1].syllabus[0] ?? '0') - codeKey(b[1].syllabus[0] ?? '0')),
})).filter((g) => g.items.length);
const hl = all.filter(([, d]) => d.level === 'HL').length;
// The frameworks library page that explains each diagram, for diagrams beyond the course.
const lib = await library();
const frameworkOf = (did: string) => Object.entries(lib.frameworks).find(([, f]) => f.diagram === did);
const beyond = all.filter(([, d]) => d.group === 'enrichment').length;
---

<BaseLayout title="Diagrams and infographics" description="Original diagrams for IB DP Business Management: models, processes, structures and charts, each drawn from data, with a text description and an SVG download." section="topics">
  <PageIntro
    trail={[{ label: 'Topics', href: '/topics/' }, { label: 'Diagrams' }]}
    kicker="Diagrams and infographics"
    title="See how the ideas fit together"
    lead={`${all.length} original diagrams: models, processes, structures and charts across the five units and the toolkit, ${hl} of them for HL${beyond ? `, and ${beyond} enrichment frameworks beyond the course` : ''}. Each is drawn from data, so every line and label is exact, and each has a text description and an SVG download. Charts use fictional figures, and say so.`}
  />

  <div class="wrap page-body">
    <nav class="dgl-nav" aria-label="Diagram groups">
      <ul>
        {
          groups.map((g) => (
            <li>
              <a href={`#${g.id}`}>
                {g.title.split(':')[0]} <span>{g.items.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((g, gi) => (
        <section class="dgl-group" id={g.id} aria-labelledby={`${g.id}-h`}>
          <SectionHead no={String(gi + 1).padStart(2, '0')} title={g.title} id={`${g.id}-h`} />
          <ul class="dgl-grid">
            {g.items.map(([id, d]) => (
              <li>
                <Diagram id={id} download />
                {d.syllabus.length > 0 ? (
                  <p class="dgl-uses">
                    <span class="label">Used in</span>
                    {d.syllabus.map((code, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={subtopicHref(c, code)}>
                          {code} {titleOf(code)}
                        </a>
                      </>
                    ))}
                  </p>
                ) : (
                  <p class="dgl-uses">
                    <span class="tag tag--enrichment">Beyond the IB course</span>{' '}
                    {frameworkOf(id) ? <a href={frameworkHref(frameworkOf(id)![0])}>{frameworkOf(id)![1].name}: the framework explained</a> : 'Enrichment'}
                  </p>
                )}
                <SaveButton compact title={d.title} kind="diagram" url={`/diagrams/#diagram-${id}`} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .dgl-nav ul {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .dgl-nav a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
    background: var(--surface-sheet);
  }

  .dgl-nav a:hover {
    border-color: var(--navy-900);
  }

  .dgl-nav span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .dgl-group + .dgl-group {
    margin-top: var(--sp-8);
  }

  .dgl-grid {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-6) var(--sp-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 34rem), 1fr));
  }

  .dgl-grid > li {
    min-width: 0;
  }

  .dgl-uses {
    margin: var(--sp-2) 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .dgl-uses .label {
    margin-right: 0.5rem;
  }

  .dgl-grid :global(.save) {
    margin-top: var(--sp-3);
  }
</style>
