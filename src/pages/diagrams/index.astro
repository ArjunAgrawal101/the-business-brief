---
/**
 * The diagram library: every diagram on the platform, by unit and the
 * toolkit, as a catalogue. Each row shows the drawing small, what it teaches,
 * the subtopics it serves, its level and what a reader can do with it, and
 * opens the diagram's own page. Each row keeps the address the rest of the
 * platform links to (/diagrams/#diagram-<id>).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import { DIAGRAMS, DIAGRAM_GROUPS } from '../../lib/diagrams';
import { diagramHref, diagramSize, diagramsInOrder, interactionLabel } from '../../lib/diagram-library';
import { corpus } from '../../lib/content';
import { allSubtopics } from '../../lib/learning';

const c = await corpus();
const subs = allSubtopics(c);
const titleOf = (code: string) => subs.find((x) => x.s.code === code)?.s.title ?? code;
const order = diagramsInOrder();
const groups = DIAGRAM_GROUPS.map((g) => ({ ...g, items: order.filter(([, d]) => d.group === g.id) })).filter((g) => g.items.length);
const all = Object.values(DIAGRAMS);
const hl = all.filter((d) => d.level === 'HL').length;
const beyond = all.filter((d) => d.group === 'enrichment').length;
const interactive = all.filter((d) => interactionLabel(d)).length;
// Drawn again for phones, or built of parts that already fit one: comparison panels and the expanding tree.
const phone = all.filter((d) => d.narrow || d.ix?.kind === 'compare' || d.ix?.kind === 'tree').length;
const thumb = (id: string) => {
  const { w, h } = diagramSize(id);
  // The downloadable file adds a margin and a credit line around the drawing (src/lib/diagrams.ts, standalone).
  return { w: w + 48, h: h + 78 };
};
---

<BaseLayout title="Diagrams and infographics" description="Original diagrams for IB DP Business Management: models, processes, structures and charts, each drawn from data, with a text description, an SVG download and print." section="topics">
  <PageIntro
    trail={[{ label: 'Topics', href: '/topics/' }, { label: 'Diagrams' }]}
    kicker="Diagrams and infographics"
    title="See how the ideas fit together"
    lead={`${all.length} original diagrams: models, processes, structures and charts across the five units and the toolkit, ${hl} of them for HL${beyond ? `, and ${beyond} enrichment frameworks beyond the course` : ''}. ${interactive} of them do more than show: you can change their figures, compare two cases, switch views or explore each part. Each is drawn from data, with a text description, an SVG download and a print view; ${phone} are drawn again for phones, and the rest fit the screen and can be shown larger. Charts use fictional figures, and say so.`}
  />

  <div class="wrap page-body">
    <nav class="dgl-nav" aria-label="Diagram groups">
      <ul>
        {
          groups.map((g) => (
            <li>
              <a href={`#${g.id}`}>
                {g.title.split(':')[0]} <span>{g.items.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((g, gi) => (
        <section class="dgl-group" id={g.id} aria-labelledby={`${g.id}-h`}>
          <SectionHead no={String(gi + 1).padStart(2, '0')} title={g.title} id={`${g.id}-h`} />
          <ul class="dgl-list">
            {g.items.map(([id, d]) => {
              const size = thumb(id);
              const how = interactionLabel(d);
              return (
                <li class="dgl-row" id={`diagram-${id}`}>
                  <img class="dgl-row__img" src={`/downloads/diagrams/${id}.svg`} alt="" width={size.w} height={size.h} loading="lazy" decoding="async" />
                  <div class="dgl-row__body">
                    <h3 class="dgl-row__title">
                      <a href={diagramHref(id)}>{d.title}</a>
                    </h3>
                    {d.caption && <p class="dgl-row__cap">{d.caption}</p>}
                    <p class="dgl-row__meta">
                      {d.syllabus.length > 0 ? (
                        <span>{d.syllabus.map((code) => `${code} ${titleOf(code)}`).join('; ')}</span>
                      ) : (
                        <span>Beyond the IB course</span>
                      )}
                      <span>{d.group === 'enrichment' ? 'Enrichment' : d.level === 'HL' ? 'HL only' : 'SL and HL'}</span>
                      {how && <span class="dgl-row__how">{how}</span>}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .dgl-nav ul {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .dgl-nav li {
    margin: 0;
  }

  .dgl-nav a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
    background: var(--surface-sheet);
  }

  .dgl-nav a:hover {
    border-color: var(--navy-900);
  }

  .dgl-nav span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .dgl-group + .dgl-group {
    margin-top: var(--sp-8);
  }

  .dgl-list {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 32rem), 1fr));
    gap: 0 var(--sp-6);
    border-top: 1px solid var(--rule-hair);
  }

  /* A row: the drawing small, then what it teaches. The title's link covers the row, so the whole row opens the diagram. */
  .dgl-row {
    position: relative;
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: start;
    margin: 0;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule-hair);
    scroll-margin-top: calc(var(--header-h) + var(--sp-3));
  }

  .dgl-row:hover .dgl-row__img {
    border-color: var(--navy-900);
  }

  .dgl-row__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 8rem;
    object-fit: contain;
    object-position: top left;
    padding: 0.35rem;
    background: var(--surface-sheet);
    border: 1px solid var(--rule-hair);
  }

  .dgl-row__body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .dgl-row__title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .dgl-row__title a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .dgl-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .dgl-row__title a:hover,
  .dgl-row__title a:focus-visible {
    text-decoration: underline;
  }

  .dgl-row__cap {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-body);
  }

  .dgl-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .dgl-row__how {
    font-weight: 700;
    color: var(--text-strong);
  }

  @media (max-width: 30rem) {
    .dgl-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
    }

    .dgl-row__img {
      max-height: 10rem;
    }
  }
</style>
