---
/**
 * Advanced financial analysis, beyond the IB course: the break even scenarios tool.
 * The page frame (the head that labels it beyond the course, where the course
 * stops, the sources and the way back to the IB parts) is shared by all four
 * advanced tools; the tool itself is BreakEvenTool.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdvancedFoot from '../../../components/adv-finance/AdvancedFoot.astro';
import AdvancedHead from '../../../components/adv-finance/AdvancedHead.astro';
import BreakEvenTool from '../../../components/adv-finance/BreakEvenTool.astro';
import { advancedTool } from '../../../lib/adv-finance/catalogue';
import '../../../styles/finance-lab.css';
import '../../../styles/adv-finance.css';

const tool = advancedTool('break-even-scenarios');
---

<BaseLayout title={`${tool.name}: advanced financial analysis`} description={`Beyond the IB course: ${tool.description}`} section="finance-desk" room="finance">
  <AdvancedHead tool={tool} />
  <div class="wrap page-body fl-page af-page">
    <BreakEvenTool />
  </div>
  <AdvancedFoot tool={tool} start={5} />
</BaseLayout>
