---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import SectionHead from '../components/layout/SectionHead.astro';
import FactList from '../components/assess/FactList.astro';
import PaperStructure from '../components/assess/PaperStructure.astro';
import IbGuidance from '../components/assess/IbGuidance.astro';
import IaPlanner from '../components/ia/IaPlanner.astro';
import VerifyTag from '../components/ui/VerifyTag.astro';
import { corpus, href } from '../lib/content';
import { inline } from '../lib/markup';

const c = await corpus();
const ia = c.assessment['internal-assessment'];
---

<BaseLayout title="IA Studio" description="The IB Business Management internal assessment as the guide sets it out, with the IB's own guidance and a ten-step planner that checks your supporting documents." section="exam-desk">
  <PageIntro
    trail={[{ label: 'Exam Desk', href: '/exam-desk/' }, { label: 'IA Studio' }]}
    kicker="IA Studio"
    title="The business research project"
    lead="The internal assessment as the Business management guide sets it out, the IB's own advice for preparing it, and a planner that takes you through ten steps and checks your supporting documents against the rules."
  />
  <div class="wrap page-body">
    {
      ia && (
        <>
          <section aria-labelledby="task-h">
            <SectionHead no={1} title="The task" dek={ia.summary} id="task-h" />
            <div style="margin-top:var(--sp-4)">
              <PaperStructure a={ia} />
            </div>
            <p class="small muted" style="margin-top:var(--sp-3)">
              Criteria and maximum marks: Business management guide, pp. 56 to 58. The level descriptors are not reproduced here; read them in the guide
              with your teacher.
            </p>
            <div style="margin-top:var(--sp-5)">
              <FactList facts={ia.facts} />
            </div>
          </section>
          <section aria-labelledby="req-h">
            <SectionHead no={2} title="The requirements" dek="What the project must do, from the guide, in the platform's words." id="req-h" />
            <ol class="req-list">
              {ia.requirements.map((r) => (
                <li set:html={inline(r)} />
              ))}
            </ol>
            <p class="small muted">
              Business management guide, pp. 53 to 56. <VerifyTag status="primary" />
            </p>
          </section>
          <section aria-labelledby="ibg-h">
            <SectionHead no={3} title="Advice from the IB" id="ibg-h" />
            <div style="margin-top:var(--sp-4)">
              <IbGuidance items={ia.ibGuidance} />
            </div>
          </section>
        </>
      )
    }
    <section aria-labelledby="plan-h">
      <SectionHead no={4} title="Plan your project" dek="Work through the ten steps in order. Your plan is saved on this device only, and you can print it for a meeting with your teacher." id="plan-h" />
      {ia && <IaPlanner criteria={ia.criteria} />}
    </section>
    {
      ia && (
        <section aria-labelledby="advice-h">
          <SectionHead no={5} title="What makes a project work" id="advice-h" />
          <div class="grid grid--3" style="margin-top:var(--sp-4)">
            <div>
              <h3 class="label label--ink">What tends to earn credit</h3>
              <ul class="prose">{ia.rewards.map((x) => <li set:html={inline(x)} />)}</ul>
            </div>
            <div>
              <h3 class="label label--ink">Preparation</h3>
              <ol class="prose">{ia.preparation.map((x) => <li set:html={inline(x)} />)}</ol>
            </div>
            <div>
              <h3 class="label label--ink">Errors to avoid</h3>
              <ul class="prose traps">{ia.errors.map((x) => <li set:html={inline(x)} />)}</ul>
            </div>
          </div>
          <div class="callout callout--caution" style="margin-top:var(--sp-5)">
            <span class="callout__kicker">Not on this page</span>
            <ul class="prose">{ia.notStated.map((x) => <li>{x}</li>)}</ul>
          </div>
          <p class="small" style="margin-top:var(--sp-4)">
            Practise the analysis on the platform's cases first: a <a href={href.case('halden-distribution')}>people problem</a>, a{' '}
            <a href={href.case('atelier-barro')}>costing problem</a> and a <a href={href.case('marigold-kitchens')}>growth decision</a>. They are
            fictional, so they cannot be the organization for your project.
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .req-list {
    display: grid;
    gap: var(--sp-3);
    max-width: var(--text-max);
    margin: var(--sp-4) 0 var(--sp-3);
    padding-left: 1.4em;
  }

  .req-list li::marker {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-muted);
  }
</style>
