---
/**
 * The topic library: all 37 subtopics of IB DP Business Management in their
 * units, each with what the platform has for it. Every status is computed from
 * the content, so the library cannot claim a page that does not exist.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import { corpus, href, topicsInOrder } from '../../lib/content';
import { allSubtopics, mindmapFor, noteFor, subtopicHref } from '../../lib/learning';
import { coverageSummary } from '../../lib/coverage';
import { connected } from '../../lib/connected-content';
import { countsFor, toolsFor } from '../../lib/connected';

const c = await corpus();
const topics = await topicsInOrder();
const cur = c.curricula['ib-dp-bm'];
const d = await connected();
const rows = allSubtopics(c).map(({ unit, s }) => {
  const note = noteFor(c, s.code);
  const map = mindmapFor(c, s.code);
  const terms = Object.values(c.glossary).filter((g) => g.subtopics.includes(s.code)).length;
  // Tools, cases, briefings and questions are counted from everything that names the subtopic: every tool page,
  // every case and case lab, every Boardroom Briefing and every question in the bank, not one collection of each.
  const n = countsFor(s.code, d.inputs);
  const brief = s.topic && c.topics[s.topic] && c.topics[s.topic]!.code === s.code;
  const state = brief ? 'brief' : note ? 'notes' : s.topic ? 'brief-part' : 'hub';
  return { unit, s, note, map, terms, ...n, state };
});
const withMaps = rows.filter((r) => r.map).length;
const toolPagesUsed = new Set(rows.flatMap((r) => toolsFor(r.s.code, d.tools, d.extraTools).map((t) => t.href))).size;
const questionsInBank = d.inputs.bank.length;
const COUNTS: Array<{ key: 'terms' | 'tools' | 'questions' | 'cases' | 'briefings'; one: string; many: string }> = [
  { key: 'terms', one: 'term', many: 'terms' },
  { key: 'tools', one: 'tool', many: 'tools' },
  { key: 'questions', one: 'question', many: 'questions' },
  { key: 'cases', one: 'case', many: 'cases' },
  { key: 'briefings', one: 'briefing', many: 'briefings' },
];
const STATE_LABEL: Record<string, string> = { brief: 'Complete brief', notes: 'Full notes', 'brief-part': 'In a brief', hub: 'Notes planned' };
// The headline figures come from the coverage tracker's own calculation, so the two pages always agree.
const sum = coverageSummary(c);
---

<BaseLayout title="Topic library" description="The IB DP Business Management course, subtopic by subtopic: notes, briefs, mindmaps, key terms, tools and practice for every part of the syllabus." section="topics">
  <PageIntro
    trail={[{ label: 'Topics' }]}
    kicker="Topic library"
    title="The course, subtopic by subtopic"
    lead={`All ${sum.total} subtopics of IB DP Business Management, in their five units. Every subtopic has a page with what the course asks, its key terms, its tools and how it connects to the rest of the course. ${sum.complete} of ${sum.total} are complete, with full notes (${sum.withNotes}) or a complete brief (${sum.withBriefs})${sum.partial + sum.planned ? `; the other ${sum.partial + sum.planned} are partly built or planned` : ''}.`}
  />

  <div class="wrap page-body">
    <dl class="tl-stats">
      <div class="tl-stats__lead"><dt>Subtopics complete</dt><dd>{sum.complete}<span class="tl-stats__of"> of {sum.total}</span></dd></div>
      <div><dt>With full notes</dt><dd>{sum.withNotes}</dd></div>
      <div><dt>In a complete brief</dt><dd>{sum.withBriefs}</dd></div>
      {
        sum.partial + sum.planned > 0 && (
          <div>
            <dt>Still to finish</dt>
            <dd>{sum.partial + sum.planned}</dd>
          </div>
        )
      }
      <div><dt>Mindmaps</dt><dd>{withMaps}</dd></div>
      <div><dt>Questions in the bank</dt><dd>{questionsInBank}</dd></div>
      <div><dt>Tools that serve them</dt><dd>{toolPagesUsed}</dd></div>
    </dl>

    <section class="tl-briefs" aria-labelledby="tl-briefs-h">
      <SectionHead no="01" title="Start with a complete brief" id="tl-briefs-h" dek="Each brief starts from a business in a situation and ends with a decision you make and defend, with a case, interactions, a Decision Room and practice." />
      <ul class="tl-feature" role="list">
        {
          topics.map(([id, t]) => (
            <li class="tl-feature__item">
              <span class="tl-feature__code">{t.code}</span>
              <h3>
                <a href={href.topic(id)}>{t.title}</a>
              </h3>
              <p class="tl-feature__q">{t.decisionQuestion}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      cur?.units.map((u) => (
        <section class="tl-unit" id={`unit-${u.number}`} aria-labelledby={`tl-u${u.number}`}>
          <SectionHead no={String(u.number + 1).padStart(2, '0')} title={`Unit ${u.number}: ${u.title}`} id={`tl-u${u.number}`} dek={u.hours ? (u.hours.sl === u.hours.hl ? `${u.hours.sl} recommended teaching hours.` : `${u.hours.sl} recommended teaching hours at SL, ${u.hours.hl} at HL.`) : undefined} />
          <ol class="tl-rows" role="list">
            {rows
              .filter((r) => r.unit.id === u.id)
              .map((r) => (
                <li class:list={['tl-row', `tl-row--${r.state}`]}>
                  <span class="tl-row__code">{r.s.code}</span>
                  <div class="tl-row__main">
                    <h3 class="tl-row__title">
                      <a href={subtopicHref(c, r.s.code)}>{r.s.title}</a>
                      {r.s.level === 'HL' && <span class="tag tag--hl">HL</span>}
                    </h3>
                    <p class="tl-row__cs">{r.s.content.map((x) => x.text).join(' · ')}</p>
                  </div>
                  <p class="tl-row__state">
                    <span class:list={['tl-chip', `tl-chip--${r.state}`]}>{STATE_LABEL[r.state]}</span>
                    {r.map && (
                      <a class="tl-row__map" href={href.mindmap(r.map[0])}>
                        Mindmap<span class="sr-only"> for {r.s.code}</span>
                      </a>
                    )}
                  </p>
                  <ul class="tl-row__has" aria-label={`For ${r.s.code} on the platform`}>
                    {COUNTS.map((k) => (
                      <li class:list={['tl-count', { 'tl-count--none': r[k.key] === 0 }]}>
                        <span class="tl-count__n">{r[k.key]}</span> <span class="tl-count__what">{r[k.key] === 1 ? k.one : k.many}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
          </ol>
        </section>
      ))
    }

    <p class="small muted tl-foot">
      Terms are the glossary entries for the subtopic; tools, every tool and desk page that serves it; questions, every question on it in the <a href="/assessment/question-bank/">question bank</a>, from the practice sets, the notes and the case files; cases, the Case Vault's cases and the Case Room's labs; briefings, the <a href="/boardroom-briefings/">Boardroom Briefings</a>. The <a href="/ib/coverage/">coverage tracker</a> gives the detail, the <a href="/ib/map/">course map</a> shows it at a glance, and the <a href="/ib/connections/">connections map</a> shows how the subtopics link.
    </p>
  </div>
</BaseLayout>

<style>
  .tl-stats {
    display: grid;
    grid-template-columns: 1.4fr repeat(5, minmax(0, 1fr));
    align-items: end;
    margin: 0 0 var(--sp-7);
    border-top: 1px solid var(--navy-900);
    border-bottom: 1px solid var(--rule-hair);
  }

  .tl-stats > div {
    padding: var(--sp-3) var(--sp-4) var(--sp-3) 0;
  }

  .tl-stats > div + div {
    padding-left: var(--sp-4);
    border-left: 1px solid var(--rule-hair);
  }

  .tl-stats dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tl-stats dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
    color: var(--navy-900);
  }

  .tl-stats__lead dd {
    color: var(--gold-600);
  }

  .tl-stats__of {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .tl-feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .tl-feature__item {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
    margin: 0;
    padding: var(--sp-5);
    background: var(--surface-sheet);
    border-top: 3px solid var(--navy-900);
    box-shadow: var(--shadow-sheet);
  }

  .tl-feature__code {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--brass-text);
  }

  .tl-feature__item h3 {
    font-size: 1.375rem;
  }

  .tl-feature__q {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-body);
  }

  .tl-unit {
    margin-top: var(--sp-8);
    scroll-margin-top: calc(var(--header-h) + var(--sp-4));
  }

  .tl-rows {
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Each row: the code, the subtopic and its statements, and five counts in fixed columns that line up from row to row. */
  .tl-row {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) 24rem;
    grid-template-areas:
      'code main counts'
      'code state counts';
    gap: var(--sp-2) var(--sp-5);
    align-items: start;
    margin: 0;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .tl-row__code {
    grid-area: code;
  }

  .tl-row__main {
    grid-area: main;
  }

  .tl-row__state {
    grid-area: state;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    margin: 0;
  }

  .tl-row__map {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tl-row__code {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    color: var(--brass-text);
    line-height: 1.2;
  }

  .tl-row__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
    font-size: 1.25rem;
  }

  .tl-row__title a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .tl-row__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
  }

  .tl-row__cs {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: 46rem;
  }

  .tl-row__has {
    grid-area: counts;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--rule-hair);
  }

  .tl-count {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0 0.25rem;
    text-align: center;
  }

  .tl-count__n {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.1;
    color: var(--navy-900);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .tl-count__what {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .tl-count--none .tl-count__n {
    color: var(--text-muted);
  }

  .tl-chip {
    margin: 0;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-1);
    font-size: 0.75rem;
    font-weight: 560;
    color: var(--text-muted);
    background: var(--surface-sheet);
  }

  .tl-chip--brief,
  .tl-chip--notes {
    border-color: var(--navy-900);
    background: var(--navy-900);
    color: var(--text-on-ink);
  }

  .tl-chip--brief-part {
    border-color: var(--gold-500);
    color: var(--brass-text);
  }

  .tl-chip--hub {
    border-style: dashed;
  }

  .tl-foot {
    margin-top: var(--sp-6);
  }

  @media (max-width: 52rem) {
    .tl-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tl-stats > div:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }

    .tl-stats > div:nth-child(n + 4) {
      border-top: 1px solid var(--rule-hair);
    }

    .tl-row {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      grid-template-areas:
        'code main'
        'code state'
        'code counts';
    }

    /* One column on a narrow screen: the counts read as a line that wraps, number beside word. */
    .tl-row__has {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-1) var(--sp-4);
      border-left: 0;
      border-top: 1px solid var(--rule-hair);
      padding-top: var(--sp-2);
    }

    .tl-count {
      display: flex;
      align-items: baseline;
      gap: 0.3rem;
      padding: 0;
    }

    .tl-count__n {
      font-size: 1.125rem;
    }

    .tl-count__what {
      font-size: 0.8125rem;
    }
  }
</style>
