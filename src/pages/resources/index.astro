---
/**
 * The Resources Library: everything the platform offers to learn, revise and
 * teach with, in the twelve categories of the brief (src/lib/library/). The
 * search and the filters come first; on a phone the filters sit behind one
 * Filter button. Cards or a list, a few items per category until one is
 * chosen, then a page at a time. Without JavaScript the page lists every
 * resource, category by category, with a contents list to jump to each.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import LibraryEntry from '../../components/resources/LibraryEntry.astro';
import { catalogue } from '../../lib/resources';
import { corpus } from '../../lib/content';
import { FORMAT_LABELS, facetsOf } from '../../lib/library/catalogue';
import { countText, FIRST_SHOWN } from '../../lib/library/filter';
import { jsonForScript } from '../../lib/markup';
import '../../styles/library.css';

const cat = await catalogue();
const c = await corpus();
const units = c.curricula['ib-dp-bm']?.units ?? [];
const titles = Object.fromEntries(units.flatMap((u) => u.subtopics.map((s) => [s.code, s.title])));
const sections = cat.categories.map((k) => ({ k, items: cat.items.filter((it) => it.category === k.id) }));
const fileCount = (f: string) => new Set(cat.items.flatMap((it) => [it.primary, ...it.more]).filter((l) => l.file?.format === f).map((l) => l.href)).size;
const files = [
  ['PDF', fileCount('PDF')],
  ['CSV', fileCount('CSV')],
  ['SVG', fileCount('SVG')],
].filter(([, n]) => Number(n) > 0) as Array<[string, number]>;
// The search text is built in the browser from each card and its hidden words, so it is not sent twice.
const config = { items: cat.items.map((it) => ({ ...facetsOf(it), text: '' })), subtopics: Object.keys(titles) };
const FORMATS = ['pdf', 'csv', 'svg', 'print', 'page', 'interactive'] as const;
const first = FIRST_SHOWN.cards;
---

<BaseLayout
  title="Resources Library"
  description="The Business Brief's resources for IB DP Business Management in twelve categories: notes, revision, mindmaps, diagrams, the formula sheet, assessment guides, practice, cases, frameworks, teacher resources and enrichment, with search, filters, previews and real downloads."
  section="resources"
>
  <div class="lib" data-ix="library" data-view="cards">
    <script type="application/json" data-config set:html={jsonForScript(config)} />
    <header class="wrap lib-head">
      <Breadcrumbs trail={[{ label: 'Resources Library' }]} />
      <div class="lib-head__grid">
        <div class="lib-head__text">
          <p class="label label--ink lib-head__kicker">IB DP Business Management</p>
          <h1>Resources Library</h1>
          <p class="lib-head__lead">
            {cat.total} resources in {cat.categories.filter((k) => k.available).length} categories: notes, revision, maps, diagrams, guides, practice, cases and teaching material, from the IB course and beyond it.
          </p>
        </div>
        <dl class="lib-glance">
          <div><dt>Resources</dt><dd>{cat.total}</dd></div>
          <div><dt>Files to download</dt><dd>{cat.downloads}<span class="lib-glance__sub">{files.map(([f, n]) => `${n} ${f}`).join(', ')}</span></dd></div>
          <div><dt>Not yet available</dt><dd class="lib-glance__words">{cat.categories.filter((k) => !k.available).map((k) => k.title).join(', ') || 'Nothing'}</dd></div>
        </dl>
      </div>

      <form class="lib-search js-only" role="search" data-form>
        <label class="lib-search__label" for="lib-q">Search the library</label>
        <div class="lib-search__row">
          <input id="lib-q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Try: break-even, Paper 3" data-q />
          <button type="button" class="lib-filter-btn" aria-expanded="false" aria-controls="lib-panel" data-filter-toggle>
            Filter<span class="lib-filter-btn__n" data-active></span>
          </button>
        </div>
      </form>
    </header>

    <div class="wrap lib-body">
      <aside class="lib-panel" id="lib-panel" aria-label="Categories and filters">
        <nav class="lib-cats" aria-labelledby="lib-cats-h">
          <h2 class="lib-panel__h" id="lib-cats-h">Categories</h2>
          <ul role="list">
            <li class="js-only">
              <a href="#lib-results" data-cat="" aria-current="true"><span>All resources</span><span class="lib-cats__n" data-cat-n="">{cat.total}</span></a>
            </li>
            {
              cat.categories.map((k) => (
                <li>
                  <a href={`?category=${k.id}#cat-${k.id}`} data-cat={k.id}>
                    <span>{k.title}</span>
                    {k.available ? (
                      <span class="lib-cats__n" data-cat-n={k.id}>
                        {k.count}
                      </span>
                    ) : (
                      <span class="lib-cats__none">Not yet available</span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <form class="lib-refine js-only" data-filters aria-labelledby="lib-refine-h">
          <h2 class="lib-panel__h" id="lib-refine-h">Narrow it down</h2>
          <div class="lib-field">
            <label for="lib-unit">Unit</label>
            <select id="lib-unit" name="unit" class="select">
              <option value="">Every unit</option>
              {
                units.map((u) => (
                  <option value={String(u.number)} data-label={`Unit ${u.number}: ${u.title}`}>
                    Unit {u.number}: {u.title}
                  </option>
                ))
              }
            </select>
          </div>
          <div class="lib-field">
            <label for="lib-subtopic">Topic</label>
            <select id="lib-subtopic" name="subtopic" class="select">
              <option value="">Every topic</option>
              {
                units.map((u) => (
                  <optgroup label={`Unit ${u.number}`}>
                    {u.subtopics.map((s) => (
                      <option value={s.code} data-label={`${s.code} ${s.title}`}>
                        {s.code} {s.title}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
          </div>
          <fieldset class="lib-field lib-level">
            <legend>Level</legend>
            <label><input type="radio" name="level" value="" checked /> SL and HL</label>
            <label><input type="radio" name="level" value="sl" /> SL: hide HL-only</label>
            <label><input type="radio" name="level" value="hl" /> HL-only material</label>
          </fieldset>
          <div class="lib-field">
            <label for="lib-format">Format</label>
            <select id="lib-format" name="format" class="select">
              <option value="">Any format</option>
              {
                FORMATS.map((f) => (
                  <option value={f} data-label={FORMAT_LABELS[f]}>
                    {FORMAT_LABELS[f]}
                  </option>
                ))
              }
            </select>
          </div>
          <div class="lib-field">
            <label for="lib-audience">For</label>
            <select id="lib-audience" name="audience" class="select">
              <option value="">Everyone</option>
              <option value="students" data-label="Students">Students</option>
              <option value="teachers" data-label="Teachers">Teachers</option>
            </select>
          </div>
          <div class="lib-field">
            <label for="lib-scope">Scope</label>
            <select id="lib-scope" name="scope" class="select">
              <option value="">The course and beyond</option>
              <option value="ib" data-label="The IB course">The IB course</option>
              <option value="enrichment" data-label="Beyond the course (enrichment)">Beyond the course (enrichment)</option>
            </select>
          </div>
          <p class="lib-refine__acts">
            <button type="button" class="btn btn--small" data-clear>Clear the filters</button>
            <button type="button" class="btn btn--small btn--primary lib-panel__done" data-done>Show the results</button>
          </p>
        </form>
      </aside>

      <div class="lib-main" id="lib-results" tabindex="-1">
        <div class="lib-bar js-only">
          <p class="lib-count" aria-live="polite" data-count>{countText(cat.total, cat.total)}</p>
          <div class="lib-view" role="group" aria-label="Show as">
            <button type="button" class="lib-view__btn" aria-pressed="true" data-view="cards">Cards</button>
            <button type="button" class="lib-view__btn" aria-pressed="false" data-view="list">List</button>
          </div>
          <div class="lib-sort">
            <label for="lib-sort">Order</label>
            <select id="lib-sort" class="select" data-sort>
              <option value="course">Course order</option>
              <option value="title">Title, A to Z</option>
            </select>
          </div>
          <button type="button" class="lib-print" data-print>Print this list</button>
        </div>

        <div class="lib-empty" data-empty hidden>
          <p class="lib-empty__h">Nothing matches.</p>
          <p>Clear a filter, or try a shorter word.</p>
          <p><button type="button" class="btn btn--small" data-clear>Clear the filters and the search</button></p>
        </div>

        {
          sections.map(({ k, items }) => (
            <section class:list={['lib-cat', `lib-cat--${k.id}`, { 'lib-cat--missing': !k.available }]} id={`cat-${k.id}`} data-cat-section={k.id} aria-labelledby={`cat-${k.id}-h`}>
              <header class="lib-cat__head">
                <h2 id={`cat-${k.id}-h`} tabindex="-1">
                  {k.title}
                  {k.available && (
                    <span class="lib-cat__n" data-cat-count>
                      {k.count}
                    </span>
                  )}
                </h2>
                <p class="lib-cat__dek">{k.dek}</p>
              </header>
              {k.missing ? (
                <div class="lib-missing">
                  <p class="lib-missing__h">Not yet available</p>
                  <p>{k.missing.note.replace(/^Not yet available\.\s*/, '')}</p>
                  {k.missing.link && (
                    <p>
                      <a href={k.missing.link.href}>{k.missing.link.label}</a>
                    </p>
                  )}
                </div>
              ) : (
                <>
                  <ul class="lib-items" role="list">
                    {items.map((it) => (
                      <LibraryEntry item={it} titles={titles} />
                    ))}
                  </ul>
                  <p class="lib-more js-only" data-more-row hidden={items.length <= first}>
                    <button type="button" class="btn btn--small" data-more={k.id}>
                      Show all {items.length}
                    </button>
                    <span class="lib-more__shown" data-shown>
                      Showing {Math.min(first, items.length)} of {items.length}
                    </span>
                  </p>
                </>
              )}
            </section>
          ))
        }
        <p class="lib-note">
          The assessment guides are the creator's own work. Every business in the case studies is fictional unless it is marked real-world. Nothing here is published, approved or endorsed by the International
          Baccalaureate.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/library';
</script>
