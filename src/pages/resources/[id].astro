---
/**
 * A curated resource's details page: what it is, what it contains, who it is
 * for, its format and size, how to get it, and related resources. A guide
 * shows the first page of the PDF itself (rendered once from the file).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { catalogue, type LibraryItem } from '../../lib/resources';
import { corpus } from '../../lib/content';
import { CATEGORY_DEFS, FORMAT_LABELS, LEVEL_LABELS, STANDING_LABELS, linkFacts } from '../../lib/library/catalogue';

export async function getStaticPaths() {
  const cat = await catalogue();
  return cat.items.filter((i) => i.details === `/resources/${i.id}/`).map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
  item: LibraryItem;
}
const { item } = Astro.props;
const c = await corpus();
const cat = await catalogue();
const related = cat.items
  .filter((x) => x.id !== item.id && ((item.component && x.component === item.component) || x.category === item.category))
  .sort((a, b) => Number(Boolean(b.component && b.component === item.component)) - Number(Boolean(a.component && a.component === item.component)))
  .slice(0, 6);
const subs = c.curricula['ib-dp-bm']?.units.flatMap((u) => u.subtopics) ?? [];
const AUD: Record<string, string> = { students: 'Students', teachers: 'Teachers', independent: 'Independent learners' };
const COMP: Record<string, string> = { 'internal-assessment': 'Internal assessment', 'paper-1': 'Paper 1', 'paper-2': 'Paper 2', 'paper-3': 'Paper 3 (HL)' };
const image = item.preview.kind === 'image' ? item.preview : null;
const category = CATEGORY_DEFS[item.category];
---

<BaseLayout title={item.title} description={item.summary} section="resources">
  <div class="wrap rd">
    <Breadcrumbs trail={[{ label: 'Resources Library', href: '/resources/' }, { label: category.title, href: `/resources/?category=${item.category}#cat-${item.category}` }, { label: item.title }]} />
    <div class:list={['rd__grid', { 'rd__grid--text': !image }]}>
      {
        image && (
          <div class="rd__preview">
            {image.webp ? (
              <picture>
                {image.avif && <source type="image/avif" srcset={image.avif} sizes="(max-width: 52rem) 80vw, 22rem" />}
                <source type="image/webp" srcset={image.webp} sizes="(max-width: 52rem) 80vw, 22rem" />
                <img src={image.src} alt={`The first page of ${item.title}`} width={image.width} height={image.height} />
              </picture>
            ) : (
              <img src={image.src} alt="" width={image.width} height={image.height} />
            )}
            {image.webp && <p class="rd__caption">The first page, as printed.</p>}
          </div>
        )
      }
      <div class="rd__body">
        <p class="label label--ink">{item.kind}{item.level === 'HL' ? ' · HL only' : ''}</p>
        <h1 class="rd__title">{item.title}</h1>
        <p class="rd__sum">{item.summary}</p>
        <p class="rd__act">
          {
            item.primary.file ? (
              <a class="btn btn--primary" href={item.primary.href} download>
                Download {linkFacts(item.primary)}
              </a>
            ) : (
              <a class="btn btn--primary" href={item.primary.href}>
                {item.primary.label} <span class="btn__arrow" aria-hidden="true">&rarr;</span>
              </a>
            )
          }
        </p>
        <dl class="rd__meta">
          <div><dt>Category</dt><dd><a href={`/resources/?category=${item.category}#cat-${item.category}`}>{category.title}</a></dd></div>
          <div><dt>For</dt><dd>{item.audiences.map((a) => AUD[a]).join(', ')}</dd></div>
          <div><dt>Level</dt><dd>{LEVEL_LABELS[item.level]}</dd></div>
          {item.standing && <div><dt>Standing</dt><dd>{STANDING_LABELS[item.standing]}</dd></div>}
          {item.component && <div><dt>Assessment</dt><dd>{COMP[item.component]}</dd></div>}
          {item.units.length > 0 && <div><dt>Units</dt><dd>{item.units.map((u) => `Unit ${u}`).join(', ')}</dd></div>}
          {item.subtopics.length > 0 && <div><dt>Subtopics</dt><dd>{item.subtopics.map((s) => `${s} ${subs.find((x) => x.code === s)?.title ?? ''}`).join('; ')}</dd></div>}
          <div><dt>Format</dt><dd>{item.primary.file ? linkFacts(item.primary) : FORMAT_LABELS[item.primary.format]}</dd></div>
          {item.updated && <div><dt>Updated</dt><dd>{item.updated}</dd></div>}
        </dl>
        {
          item.preview.kind === 'contents' && item.preview.items.length > 0 && (
            <div class="rd__contents">
              <h2 class="rd__h">What it contains</h2>
              <ol>
                {item.preview.items.map((x) => (
                  <li>{x}</li>
                ))}
              </ol>
            </div>
          )
        }
        {
          item.keywords.length > 0 && item.preview.kind !== 'contents' && (
            <div class="rd__contents">
              <h2 class="rd__h">What it contains</h2>
              <ol>
                {item.keywords.map((x) => (
                  <li>{x}</li>
                ))}
              </ol>
            </div>
          )
        }
      </div>
    </div>
    {
      related.length > 0 && (
        <section class="rd__related" aria-labelledby="rd-rel-h">
          <h2 id="rd-rel-h" class="rd__h">Related resources</h2>
          <ul role="list">
            {related.map((r) => (
              <li>
                <a href={r.details ?? r.primary.href}>{r.title}</a>
                <span class="small muted">{r.kind}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .rd {
    padding-block: var(--sp-6) var(--sp-8);
  }

  .rd__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: var(--sp-6);
    align-items: start;
  }

  .rd__grid--text {
    grid-template-columns: minmax(0, 1fr);
    max-width: 48rem;
  }

  .rd__preview {
    max-width: 22rem;
  }

  .rd__preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: var(--surface-sheet);
  }

  .rd__caption {
    margin-top: var(--sp-2);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .rd__body {
    display: grid;
    gap: var(--sp-4);
  }

  .rd__title {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .rd__sum {
    max-width: 40rem;
    color: var(--text-strong);
    font-family: var(--font-serif);
    font-size: var(--fs-lead);
  }

  .rd__meta {
    display: grid;
    max-width: 40rem;
    margin: var(--sp-2) 0 0;
    border-top: 1px solid var(--rule-ink);
  }

  .rd__meta > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .rd__meta dt {
    padding-top: 0.1rem;
    color: var(--text-muted);
    font: 600 0.8125rem/1.4 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rd__meta dd {
    margin: 0;
  }

  .rd__h {
    font-size: 1.375rem;
  }

  .rd__contents ol {
    margin: var(--sp-2) 0 0;
    padding-left: 1.2rem;
  }

  .rd__related {
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule-ink);
  }

  .rd__related ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--sp-3) var(--sp-5);
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .rd__related li {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }

  @media (max-width: 52rem) {
    .rd__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .rd__preview {
      max-width: 16rem;
    }

    .rd__meta > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>
