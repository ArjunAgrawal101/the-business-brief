---
/**
 * The formula sheet, a printable page in two parts that are never mixed.
 * First, the IB formulae sheet exactly as the guide prints it (pp. 64 to 65,
 * with the discount table of p. 66): the copy students are given in the
 * examination. Second, "Also used on this site": every other formula the
 * platform's tools, notes and diagrams use, each marked as beyond the IB
 * formulae sheet and placed precisely in the course, or beyond it. The data
 * and its checks are in src/lib/library/formula-sheet.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Monogram from '../../components/brand/Monogram.astro';
import { corpus } from '../../lib/content';
import { DISCOUNT_TABLE, MAX_YEARS, RATES } from '../../lib/investment';
import { DISCOUNT_TABLE_PAGE, IB_SHEET, SITE_FORMULAS, formulaHtml, ibFormulas, placementLabel, placementText, siteFormulas } from '../../lib/library/formula-sheet';
import '../../styles/formula-sheet.css';

const c = await corpus();
const titles = new Map((c.curricula['ib-dp-bm']?.units ?? []).flatMap((u) => u.subtopics.map((s) => [s.code, s.title] as const)));
const title = (code: string) => titles.get(code) ?? '';
const rates = RATES;
const years = MAX_YEARS;
const ib = ibFormulas();
const site = siteFormulas();
const inSyllabus = site.filter((f) => f.placement.kind === 'syllabus').length;
const toolkit = site.filter((f) => f.placement.kind === 'toolkit').length;
const beyond = site.filter((f) => f.placement.kind === 'beyond').length;
const supports = site.filter((f) => f.placement.kind === 'supports').length;
---

<BaseLayout
  title="Formula sheet"
  description="The IB DP Business Management formulae sheet exactly as the guide prints it, with the HL-only formulae marked, and every other formula the platform's tools use, each placed in the syllabus or marked as beyond it. Printable."
  section="resources"
>
  <article class="wrap fs">
    <div class="fs__screen">
      <Breadcrumbs trail={[{ label: 'Resources Library', href: '/resources/' }, { label: 'Formula sheet' }]} />
      <p class="fs__actions"><button type="button" class="btn btn--primary needs-js" data-print>Print or save as PDF</button></p>
    </div>
    <header class="fs__head">
      <Monogram height={40} />
      <div>
        <p class="fs__brand">Arjun Agrawal · The Business Brief</p>
        <h1 class="fs__title">Formula sheet</h1>
        <p class="fs__sub">IB Diploma Programme Business Management, first assessment 2024. <span class="fs__hl">HL</span> marks a formula for HL only.</p>
      </div>
    </header>
    <nav class="fs__toc fs__screen-only" aria-label="The two parts">
      <a href="#fs-ib">The IB formulae sheet <span>{ib.length} formulae</span></a>
      <a href="#fs-site">Also used on this site <span>{site.length} more, beyond the IB sheet</span></a>
    </nav>

    <section class="fs__part fs__part--ib" aria-labelledby="fs-ib">
      <h2 id="fs-ib">The IB formulae sheet</h2>
      <p class="fs__note">
        The formulae the guide lists for external assessment, exactly as it prints them (Business management guide, pp. 64 to 65). A copy is given to students in the examination.
      </p>
      {
        IB_SHEET.map((part) => (
          <div class="fs__ibpart">
            <h3 class="fs__parth">
              {part.title} <span class="fs__page">p. {part.page}</span>
            </h3>
            <div class="fs__groups">
              {part.groups.map((g) => (
                <div class="fs__group">
                  <h4>
                    {g.title} {g.level === 'HL' && <span class="fs__hl">HL</span>}
                  </h4>
                  <dl>
                    {g.items.map((it) => (
                      <div class:list={['fs__f', { 'fs__f--or': it.or }]}>
                        <dt>
                          {it.or && <span class="fs__or">or</span>}
                          {it.name} {it.level === 'HL' && g.level !== 'HL' && <span class="fs__hl">HL</span>}
                        </dt>
                        <dd class="fs__eq">
                          = <Fragment set:html={formulaHtml(it.rhs)} />
                        </dd>
                        {it.where?.map((w) => (
                          <dd class="fs__where">
                            where {w.name} = <Fragment set:html={formulaHtml(w.rhs)} />
                          </dd>
                        ))}
                      </div>
                    ))}
                  </dl>
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <div class="fs__ibpart fs__discount">
        <h3 class="fs__parth">
          Discount tables <span class="fs__hl">HL</span> <span class="fs__page">p. {DISCOUNT_TABLE_PAGE}</span>
        </h3>
        <p class="fs__note">The guide's discount factors. The examination paper gives a table when a question needs it.</p>
        <div class="table-scroll" role="region" aria-label="Discount factors" tabindex="0">
          <table class="table fs__table">
            <caption class="sr-only">Discount factors by year and discount rate</caption>
            <thead>
              <tr>
                <th scope="col">Years</th>
                {rates.map((r) => <th scope="col" class="n">{r}%</th>)}
              </tr>
            </thead>
            <tbody>
              {
                Array.from({ length: years }, (_, y) => (
                  <tr>
                    <th scope="row">{y + 1}</th>
                    {rates.map((r) => (
                      <td class="n">{DISCOUNT_TABLE[r][y]!.toFixed(4)}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="fs__part fs__part--site" aria-labelledby="fs-site">
      <h2 id="fs-site">Also used on this site</h2>
      <p class="fs__note">
        Every other formula the platform's tools, notes and diagrams use. <strong>None of them is on the IB formulae sheet</strong>, so each is marked as beyond it, with where it stands: {inSyllabus} are in the syllabus without a
        printed formula, so learn them; {toolkit} belong to toolkit tools;{supports ? ` ${supports} supports a statement that names no formula;` : ''} and {beyond} go beyond the IB course.
      </p>
      {
        SITE_FORMULAS.map((g) => (
          <div class="fs__sgroup">
            <h3>{g.title}</h3>
            <dl>
              {g.items.map((f) => (
                <div class:list={['fs__s', `fs__s--${f.placement.kind}`]}>
                  <dt>
                    {f.name}
                    {'level' in f.placement && f.placement.level === 'HL' && <span class="fs__hl">HL</span>}
                  </dt>
                  <dd class="fs__eq">
                    = <Fragment set:html={formulaHtml(f.rhs)} />
                  </dd>
                  {f.lines?.map((l) => (
                    <dd class="fs__eq fs__eq--line">
                      {l.name === 'or' ? 'or ' : `${l.name} = `}
                      <Fragment set:html={formulaHtml(l.rhs)} />
                    </dd>
                  ))}
                  <dd class="fs__place">
                    <span class="fs__mark">Beyond the IB formulae sheet</span>
                    <span class="fs__where-label">{placementLabel(f.placement)}</span>
                  </dd>
                  <dd class="fs__placetext">{placementText(f.placement, title)}</dd>
                  <dd class="fs__used">
                    Used in: {f.used.map((u, i) => <>{i > 0 && '; '}<a href={u.href}>{u.label}</a></>)}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </section>
    <p class="fs__foot">
      The Business Brief, by Arjun Agrawal. Original teaching material, not an IB publication. Practise every formula with the <a href="/assessment/paper-2/practice/">Paper 2 calculation practice</a> and the <a
        href="/finance-desk/lab/">Financial Laboratory</a
      >.
    </p>
  </article>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
