---
/**
 * Search. The page lists everything that can be found, grouped by kind, so
 * without JavaScript it is a complete index of the site, with a contents list
 * to jump to each kind. With JavaScript the box searches as you type, ranks
 * the best matches first, filters by kind, unit and level, keeps the query
 * and filters in the address, and the arrow keys move through the results.
 *
 * The index is built from the content (src/lib/search-index.ts) and every
 * link in the navigation, so new material is found without being listed.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import { corpus, href, modulesInOrder, pathwaysInOrder } from '../lib/content';
import { subtopicHref } from '../lib/learning';
import { DIAGRAMS } from '../lib/diagrams';
import { library } from '../lib/resources';
import { library as frameworkLibrary } from '../lib/frameworks-content';
import { NAV } from '../lib/navigation';
import { buildSearchIndex, type SearchLinks } from '../lib/search-index';
import { SEARCH_KINDS, extraWords } from '../lib/search';
import { iconSvg } from '../lib/icons';
import '../styles/search.css';

const c = await corpus();
const links: SearchLinks = {
  subtopic: (code) => subtopicHref(c, code),
  topic: href.topic,
  case: href.case,
  decision: href.decision,
  toolEntry: (id) => href.toolEntry(id, c.tools[id]),
  question: href.question,
  glossary: href.glossary,
  mindmap: href.mindmap,
  commandTerm: href.commandTerm,
  concept: href.concept,
  revision: href.revision,
  calculation: href.calculation,
  pathway: href.pathway,
};
const entries = buildSearchIndex({
  c,
  nav: NAV,
  links,
  modules: (await modulesInOrder()).map((m) => m.data),
  library: (await library())
    .filter((r) => r.curated)
    .map((r) => ({ title: r.title, summary: r.summary, typeLabel: r.typeLabel, level: r.level, units: r.units, subtopics: r.subtopics, href: r.details ?? r.primary.href })),
  diagrams: DIAGRAMS,
  pathways: (await pathwaysInOrder()).map((p) => ({ id: p.id, name: p.data.name, promise: p.data.promise })),
  frameworks: (await frameworkLibrary()).frameworks,
});
const groups = SEARCH_KINDS.map((k) => ({ ...k, items: entries.filter((e) => e.kind === k.id) })).filter((g) => g.items.length);
const units = c.curricula['ib-dp-bm']?.units ?? [];
const total = entries.length.toLocaleString('en-GB');
/** Where an entry sits in the course, unless its title already says. */
const codesLabel = (title: string, codes: string[], unitList: string[]) =>
  codes.length && codes.every((code) => title.includes(code))
    ? ''
    : codes.length
      ? codes.length > 3
        ? `${codes.slice(0, 3).join(', ')} and more`
        : codes.join(', ')
      : unitList.length === 1 && unitList[0] !== 'toolkit'
        ? `Unit ${unitList[0]}`
        : unitList.includes('toolkit')
          ? 'Toolkit'
          : '';
---

<BaseLayout title="Search" description="Search the whole platform: subtopics, notes, definitions, formulas, cases, frameworks, practice questions, calculators and tools, resources and pages." section="search">
  <PageIntro
    trail={[{ label: 'Search' }]}
    kicker="Search"
    title="Find anything"
    lead={`${total} entries across the course: subtopics, notes, definitions, formulas, cases, frameworks, questions, calculators and tools, resources and pages. Search by name, filter by kind, unit or level, and keep the address to come back to the same results.`}
  />

  <div class="wrap page-body sx" data-ix="search">
    <form class="sx-form js-only" role="search" action="/search/" method="get" data-search-form>
      <label for="q" class="label label--ink">Search the platform</label>
      <div class="sx-box">
        <Fragment set:html={iconSvg('search', 22)} />
        <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="go" placeholder="Try: gearing ratio, franchising, autocratic" aria-describedby="sx-hint search-count" />
      </div>
      <p class="sx-hint" id="sx-hint">The best matches come first in each kind. The arrow keys move through the results, and Enter opens one.</p>
      <p class="sx-count" id="search-count" data-count>{total} entries</p>
      <p class="sr-only" aria-live="polite" data-announce></p>
    </form>

    <div class="sx-layout">
      <details class="sx-facets js-only" data-facets open>
        <summary class="sx-facets__toggle"><span class="label">Filters</span> <span class="sx-facets__sum" data-facets-sum>Everything, all units, SL and HL</span></summary>
        <div class="sx-facets__body" role="group" aria-label="Filter the results">
        <fieldset class="sx-kinds">
          <legend class="label">Kind</legend>
          <label class="sx-kind">
            <input type="radio" name="kind" value="" checked />
            <span class="sx-kind__label">Everything</span>
            <span class="sx-kind__n" data-kind-n="">{total}</span>
          </label>
          {
            groups.map((g) => (
              <label class="sx-kind">
                <input type="radio" name="kind" value={g.id} />
                <span class="sx-kind__label">{g.label}</span>
                <span class="sx-kind__n" data-kind-n={g.id}>
                  {g.items.length.toLocaleString('en-GB')}
                </span>
              </label>
            ))
          }
        </fieldset>
        <div class="sx-filters">
          <label class="sx-filter">
            <span class="label">Unit</span>
            <select name="unit" data-f="unit">
              <option value="">All units</option>
              {units.map((u) => <option value={String(u.number)}>Unit {u.number}: {u.title}</option>)}
              <option value="toolkit">The toolkit</option>
            </select>
          </label>
          <label class="sx-filter">
            <span class="label">Level</span>
            <select name="level" data-f="level">
              <option value="">SL and HL</option>
              <option value="sl">Hide HL-only entries</option>
              <option value="hl">HL-only entries</option>
            </select>
          </label>
          <button type="button" class="btn btn--small sx-clear" data-clear>Clear the search</button>
        </div>
        </div>
      </details>

      <div class="sx-main">
        <nav class="sx-toc nojs-only" aria-label="Kinds of entry">
          <p class="label label--ink">Jump to</p>
          <ul>
            {
              groups.map((g) => (
                <li>
                  <a href={`#k-${g.id}`}>
                    {g.label} <span class="sx-toc__n">{g.items.length.toLocaleString('en-GB')}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="sx-results" data-results>
          {
            groups.map((g) => (
              <section class="sx-group" id={`k-${g.id}`} data-group={g.id} aria-labelledby={`k-${g.id}-h`}>
                <h2 class="sx-group__h" id={`k-${g.id}-h`} tabindex="-1">
                  {g.label} <span class="sx-group__n" data-group-n>{g.items.length.toLocaleString('en-GB')}</span>
                </h2>
                <ol class="sx-list" role="list">
                  {g.items.map((e) => {
                    const where = codesLabel(e.title, e.codes, e.units);
                    const k = extraWords(e.keys, `${e.title} ${e.type} ${where} ${e.text}`);
                    return (
                      <li data-entry data-units={e.units.join(' ') || undefined} data-hl={e.hl ? '1' : undefined} data-k={k || undefined}><a href={e.url}>{e.title}</a><p><span>{e.type}</span>{where && <> <span>{where}</span></>}{e.hl && <> <span class="tag tag--hl">HL</span></>}</p>{e.text && <p>{e.text}</p>}</li>
                    );
                  })}
                </ol>
                <button type="button" class="sx-more js-only" data-more={g.id} hidden>
                  Show all {g.items.length.toLocaleString('en-GB')} {g.many}
                </button>
              </section>
            ))
          }
          <p class="state sx-none" data-none hidden>
            Nothing matches. Try a shorter word or another spelling, clear a filter, or browse the <a href="/topics/">topic library</a> and the <a href="/glossary/">glossary</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/search';
</script>
