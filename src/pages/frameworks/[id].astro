---
/**
 * One framework: its diagram, what it is and what it is for, how it is built,
 * the situations it suits, how to use it step by step, a fictional example,
 * how to read the result and what it does and does not justify deciding, its
 * strengths and limits, the common mistakes, the Apply it mode (the tools
 * that apply it and a worksheet kept on this device), an exercise with
 * guidance, and its links to the glossary, the toolkit, the course, other
 * frameworks and the works it comes from. Its standing, IB syllabus with the
 * guide's page, IB toolkit or enrichment, is stated at the top. A toolkit
 * tool's full guide lives in the toolkit, linked here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import LevelTag from '../../components/ui/LevelTag.astro';
import SaveButton from '../../components/ui/SaveButton.astro';
import ApplyWorksheet from '../../components/frameworks/ApplyWorksheet.astro';
import { corpus, href } from '../../lib/content';
import { library } from '../../lib/frameworks-content';
import { FRAMEWORK_GROUP_INFO, type Framework } from '../../lib/framework-schema';
import { APPLY_ANCHOR, JUDGEMENT, applicationOf } from '../../lib/framework-lab';
import { STATUS_LABELS, frameworkHref, inLibraryOrder, standing } from '../../lib/frameworks';
import { allSubtopics, subtopicHref } from '../../lib/learning';
import { inline, jsonForScript, plain, rich } from '../../lib/markup';
import { QUALIFICATION_TAG_LABELS } from '../../lib/schemas';
import { studioHref } from '../../lib/strategy/content';

export async function getStaticPaths() {
  const lib = await library();
  return Object.entries(lib.frameworks).map(([id, framework]) => ({ params: { id }, props: { id, framework } }));
}

interface Props {
  id: string;
  framework: Framework;
}
const { id, framework: f } = Astro.props;
const c = await corpus();
const lib = await library();
const group = FRAMEWORK_GROUP_INFO[f.group];
const subs = allSubtopics(c);
const titleOf = (code: string) => subs.find((x) => x.s.code === code)?.s.title ?? code;
const tool = f.tool ? c.tools[f.tool] : undefined;
const toolLink = f.tool && tool ? (tool.status === 'complete' ? `/toolkit/${f.tool}/` : `/toolkit/#tool-${f.tool}`) : undefined;
const studioTool = f.studio ? lib.studio.find((x) => x.slug === f.studio) : undefined;
const terms = f.terms.map((t) => ({ id: t, e: c.glossary[t]! }));
const related = f.related.map((r) => ({ id: r, f: lib.frameworks[r]! }));
const order = inLibraryOrder(lib.frameworks);
const i = order.findIndex(([x]) => x === id);
const prev = i > 0 ? order[i - 1] : undefined;
const next = i < order.length - 1 ? order[i + 1] : undefined;
const statusClass = f.status === 'enrichment' ? 'tag--enrichment' : 'tag--ib';
const app = applicationOf(f, lib.tools);
const studioOf = (href: string) => lib.studio.find((x) => `/strategy-studio/${x.slug}/` === href);
const works = f.references.map((r) => ({ id: r, s: c.sources[r]! }));
const pageRef = f.guidePages ? `${f.guidePages.includes(' ') ? 'pp.' : 'p.'} ${f.guidePages}` : '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: f.name,
  description: f.summary,
  learningResourceType: 'Framework explainer',
  isAccessibleForFree: true,
};
---

<BaseLayout title={`${f.name}: Framework`} description={`${f.name}: ${f.summary}`} section="toolkit" jsonLd={jsonLd}>
  <PageIntro trail={[{ label: 'Frameworks', href: '/frameworks/' }, { label: f.name }]} kicker={`Frameworks · ${group.title}`} title={f.name} lead={f.summary}>
    <div class="tags">
      <span class={`tag ${statusClass}`}>{standing(f)}</span>
      {f.status !== 'enrichment' && <LevelTag level={f.level} always />}
      {f.qualifications.map((q) => <span class="tag tag--plain">{QUALIFICATION_TAG_LABELS[q]}</span>)}
      <SaveButton title={f.name} kind="framework" />
    </div>
  </PageIntro>

  <div class="wrap page-body fw">
    <section aria-labelledby="fw-glance">
      <SectionHead no={1} title="The framework at a glance" id="fw-glance" />
      <div class="fw-glance">
        <div class="fw-glance__art">
          <Diagram id={f.diagram} />
        </div>
        <aside class="fw-facts" aria-label="About this framework">
          <p class="fw-facts__q"><span class="label">The question it answers</span>{f.question}</p>
          <dl>
            <div>
              <dt>Standing</dt>
              <dd>
                {f.status === 'syllabus' && `Named in the IB syllabus (${f.subtopics.join(', ')}); Business management guide, ${pageRef}.`}
                {f.status === 'toolkit' && `One of the tools in the IB business management toolkit; Business management guide, ${pageRef}.`}
                {f.status === 'enrichment' && <>Enrichment: not part of the IB Business Management course. It is here for going further, at university, in an MBA or at work.</>}
              </dd>
            </div>
            {f.origin && (
              <div>
                <dt>Credited to</dt>
                <dd>{f.origin}</dd>
              </div>
            )}
            <div>
              <dt>Purpose</dt>
              <dd>{group.title}</dd>
            </div>
            {f.subtopics.length > 0 && (
              <div>
                <dt>{f.status === 'syllabus' ? 'In the course' : 'Use it with'}</dt>
                <dd>
                  <ul class="fw-facts__links">
                    {f.subtopics.map((code) => (
                      <li>
                        <a href={subtopicHref(c, code)}>
                          <span class="fw-code">{code}</span> {titleOf(code)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
          {
            toolLink && tool && (
              <a class="fw-guide" href={toolLink}>
                <span class="label">{tool.status === 'complete' ? 'The full toolkit guide' : 'In the toolkit'}</span>
                <span class="fw-guide__name">{tool.name}</span>
                <span class="fw-guide__text">{tool.status === 'complete' ? 'How to build it, the evidence it needs, what it reveals and hides, and a worked case.' : 'Its entry in the toolkit; the full guide is in preparation.'}</span>
              </a>
            )
          }
          {
            studioTool && (
              <a class="fw-guide" href={studioHref(studioTool.slug)}>
                <span class="label">Apply it to your own case</span>
                <span class="fw-guide__name">{studioTool.title}</span>
                <span class="fw-guide__text">In the Strategy Studio: build it step by step, with your entries checked as you go and kept on this device.</span>
              </a>
            )
          }
          <a class="fw-guide fw-guide--apply" href={`#${APPLY_ANCHOR}`}>
            <span class="label">Apply it</span>
            <span class="fw-guide__name">Open the application mode</span>
            <span class="fw-guide__text">
              {app.full.length
                ? `The ${app.full.length === 1 ? 'tool that applies' : 'tools that apply'} it in full, and a worksheet for your own case.`
                : 'A worksheet for your own case, and the tools that help with parts of it.'}
            </span>
          </a>
        </aside>
      </div>
    </section>

    <section aria-labelledby="fw-what">
      <SectionHead no={2} title="What it is, and what it is for" id="fw-what" />
      <div class="fw-what">
        <div class="prose fw-what__body" set:html={rich(f.explanation)} />
        <div class="fw-purpose">
          <p class="label">What it is for</p>
          <div class="prose" set:html={rich(f.purpose)} />
        </div>
      </div>
    </section>

    <section aria-labelledby="fw-parts">
      <SectionHead no={3} title="How it is built" id="fw-parts" dek="The parts of the framework, and what each one holds." />
      <dl class="fw-parts">
        {
          f.structure.map((p) => (
            <div class="fw-parts__item">
              <dt>{p.name}</dt>
              <dd set:html={inline(p.text)} />
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="fw-when">
      <SectionHead no={4} title="When to use it" id="fw-when" dek="The business situations it suits, and where another tool will serve better." />
      <div class="fw-weigh fw-when">
        <div>
          <h3 class="fw-weigh__h fw-when__h">It suits</h3>
          <ul class="prose">{f.situations.suits.map((x) => <li set:html={inline(x)} />)}</ul>
        </div>
        <div>
          <h3 class="fw-weigh__h fw-when__h fw-when__h--not">Look elsewhere when</h3>
          <ul class="prose">{f.situations.poorFit.map((x) => <li set:html={inline(x)} />)}</ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="fw-how">
      <SectionHead no={5} title="How to use it, step by step" id="fw-how" dek={f.status === 'toolkit' && tool?.status === 'complete' ? 'A short method. The toolkit guide gives the full one, with the evidence each step needs.' : undefined} />
      <ol class="fw-steps">
        {f.steps.map((s, n) => (
          <li>
            <span class="fw-steps__no" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
            <div set:html={inline(s)} />
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="fw-example">
      <SectionHead no={6} title={`Applied: ${f.example.title}`} id="fw-example" />
      <div class="fw-example">
        <div class="tags"><span class="tag tag--simulated">Fictional business</span></div>
        <div class="prose narrative" set:html={rich(f.example.body)} />
        <div class="fw-result">
          <p class="label">What it showed</p>
          <div class="prose" set:html={rich(f.example.result)} />
        </div>
      </div>
    </section>

    <section aria-labelledby="fw-read">
      <SectionHead no={7} title="Reading the result" id="fw-read" dek="How to interpret what it shows, and what that does and does not justify deciding." />
      <div class="fw-read">
        <div class="prose fw-read__body" set:html={rich(f.interpretation)} />
        <div class="fw-weigh fw-read__implications">
          <div>
            <h3 class="fw-weigh__h fw-weigh__h--plus">What it can justify deciding</h3>
            <ul class="prose">{f.implications.justifies.map((x) => <li set:html={inline(x)} />)}</ul>
          </div>
          <div>
            <h3 class="fw-weigh__h fw-weigh__h--minus">What it does not justify on its own</h3>
            <ul class="prose">{f.implications.doesNotJustify.map((x) => <li set:html={inline(x)} />)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="fw-weigh">
      <SectionHead no={8} title="Strengths and limits" id="fw-weigh" />
      <div class="fw-weigh">
        <div>
          <h3 class="fw-weigh__h fw-weigh__h--plus">Why it helps</h3>
          <ul class="prose">{f.advantages.map((x) => <li set:html={inline(x)} />)}</ul>
        </div>
        <div>
          <h3 class="fw-weigh__h fw-weigh__h--minus">Where it falls short</h3>
          <ul class="prose">{f.limitations.map((x) => <li set:html={inline(x)} />)}</ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="fw-mistakes">
      <SectionHead no={9} title="Common mistakes" id="fw-mistakes" dek="Errors often made with it, by students and by managers, and how to avoid each." />
      <ol class="fw-mistakes">
        {
          f.mistakes.map((m) => (
            <li>
              <p class="fw-mistakes__m">
                <span class="label">Mistake</span>
                <span set:html={inline(m.mistake)} />
              </p>
              <p class="fw-mistakes__f">
                <span class="label">Instead</span>
                <span set:html={inline(m.fix)} />
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="fw-apply" id={APPLY_ANCHOR} class="fw-apply">
      <SectionHead no={10} title="Apply it" id="fw-apply" dek="The application mode: the platform's tools that apply this framework, and a worksheet for your own case." />
      <p class="fw-apply__judgement">{JUDGEMENT}</p>
      {
        app.full.length > 0 ? (
          <div class="fw-apply__block">
            <h3 class="label label--ink">{app.full.length === 1 ? 'The tool that applies it in full' : 'Tools that apply it in full'}</h3>
            <ul class="fw-tools" role="list">
              {app.full.map((t) => {
                const st = studioOf(t.href);
                return (
                  <li class="fw-tool">
                    <span class="fw-tool__room">
                      {t.room}
                      {st && (
                        <span class={`tag ${st.enrichment ? 'tag--enrichment' : 'tag--ib'}`}>{st.enrichment ? 'Enrichment' : 'IB toolkit'}</span>
                      )}
                    </span>
                    <a class="fw-tool__name" href={t.href}>
                      {t.title}
                    </a>
                    <span class="fw-tool__use" set:html={inline(t.use)} />
                  </li>
                );
              })}
            </ul>
          </div>
        ) : (
          <p class="fw-apply__none">No interactive tool on the platform applies {f.name.replace(/^The /, 'the ')} in full yet, so the worksheet below is its application mode{app.part.length > 0 ? ', with the tools that help with parts of it' : ''}.</p>
        )
      }
      {
        app.part.length > 0 && (
          <div class="fw-apply__block">
            <h3 class="label label--ink">For part of it</h3>
            <ul class="fw-tools fw-tools--part" role="list">
              {app.part.map((t) => (
                <li class="fw-tool">
                  <span class="fw-tool__room">{t.room}</span>
                  <a class="fw-tool__name" href={t.href}>
                    {t.title}
                  </a>
                  <span class="fw-tool__use" set:html={inline(t.use)} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="fw-apply__block">
        <h3 class="label label--ink">Your worksheet</h3>
        <p class="small muted fw-apply__lead">
          {app.full.length > 0
            ? 'The tool is the fuller application. Use the worksheet for a quick pass, or to apply the framework to a second case, part by part.'
            : 'Work through the framework part by part for a business you know, then say what the result does and does not justify.'}
        </p>
        <ApplyWorksheet id={id} name={f.name} parts={f.structure} question={f.question} />
      </div>
      <p class="small muted fw-apply__more"><a href="/frameworks/lab/">The Framework Application Lab</a>: choose a framework by the decision you face.</p>
    </section>

    <section aria-labelledby="fw-try">
      <SectionHead no={11} title="Try it" id="fw-try" dek="The platform's own exercise. Write your answer, then open the guidance." />
      <div class="fw-try" data-ix="fw-exercise" data-key={`framework:${id}`}>
        <div class="prose fw-try__prompt" set:html={rich(f.exercise.prompt)} />
        <div class="field">
          <label for="fw-answer">Your answer</label>
          <p class="field__hint" id="fw-answer-hint">
            <span class="js-only">Kept on this device as you type, and nowhere else.</span>
            <span class="nojs-only">Your answer is not saved without JavaScript; copy it before you leave.</span>
          </p>
          <textarea id="fw-answer" class="textarea fw-try__box" rows="8" aria-describedby="fw-answer-hint" data-answer></textarea>
        </div>
        <div class="fw-try__actions js-only">
          <button class="btn btn--small" type="button" data-download>Download as text</button>
          <button class="btn btn--small" type="button" data-clear>Clear</button>
          <p class="fw-try__status small muted" aria-live="polite" data-status></p>
        </div>
        <p class="small" data-error hidden>The draft could not be restored on this page; you can still write and copy your answer.</p>
        <details class="disclosure fw-try__guide">
          <summary>Guidance: what a strong answer does</summary>
          <ul class="prose">{f.exercise.guidance.map((x) => <li set:html={inline(x)} />)}</ul>
        </details>
        <script type="application/json" data-config set:html={jsonForScript({ title: f.name, prompt: plain(f.exercise.prompt) })} />
      </div>
    </section>

    <section aria-labelledby="fw-related">
      <SectionHead no={12} title="Related concepts" id="fw-related" />
      <div class="fw-rel">
        {
          terms.length > 0 && (
            <div>
              <h3 class="label label--ink">In the glossary</h3>
              <ul class="fw-rel__terms">
                {terms.map((t) => (
                  <li>
                    <a href={href.glossary(t.id)}>{t.e.term}</a>
                    {t.e.provenance === 'enrichment' && <span class="tag tag--enrichment">Beyond IB</span>}
                    <span set:html={inline(t.e.definition)} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          related.length > 0 && (
            <div>
              <h3 class="label label--ink">Read with</h3>
              <ul class="fw-rel__fws">
                {related.map((r) => (
                  <li>
                    <a href={frameworkHref(r.id)}>{r.f.name}</a>
                    <span class="fw-rel__kind">{STATUS_LABELS[r.f.status]}</span>
                    <span class="fw-rel__sum">{r.f.summary}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      {
        works.length > 0 && (
          <div class="fw-works">
            <h3 class="label label--ink">Published works behind it</h3>
            <ul class="fw-works__list">
              {works.map((w) => (
                <li>
                  {w.s.author && <span>{w.s.author} ({w.s.year}). </span>}
                  <a href={`/sources/#src-${w.id}`}>
                    <cite>{w.s.title}</cite>
                  </a>
                  {w.s.publisher && <span>. {w.s.publisher}.</span>}
                </li>
              ))}
            </ul>
            <p class="small muted">Cited as bibliographic references in the platform's source register; the explanations on this page are the platform's own.</p>
          </div>
        )
      }
      <p class="small muted fw-note">
        {f.status === 'enrichment'
          ? "The explanation, method, example and exercise are the platform's own, written as enrichment beyond the IB course. The business in the example is fictional."
          : "The explanation, method, example and exercise are the platform's own. Statements about the IB course cite the Business management guide; the business in the example is fictional."}
      </p>
    </section>

    <nav class="fw-pager" aria-label="Neighbouring frameworks">
      {prev ? <a href={frameworkHref(prev[0])}>&larr; {prev[1].name}</a> : <span />}
      <a href="/frameworks/">All frameworks</a>
      {next ? <a href={frameworkHref(next[0])}>{next[1].name} &rarr;</a> : <span />}
    </nav>
  </div>
</BaseLayout>

<style>
  .fw section + section {
    margin-top: var(--sp-8);
  }

  .fw-glance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem);
    gap: var(--sp-6);
    align-items: start;
    margin-top: var(--sp-5);
  }

  .fw-glance__art {
    min-width: 0;
  }

  .fw-facts {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-5);
    background: var(--surface-sheet);
    border-top: 3px solid var(--navy-900);
    box-shadow: var(--shadow-sheet);
  }

  .fw-facts__q {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.35;
    color: var(--navy-900);
  }

  .fw-facts__q .label {
    font-style: normal;
  }

  .fw-facts dl {
    margin: 0;
    border-top: 1px solid var(--rule-hair);
  }

  .fw-facts dl > div {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .fw-facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .fw-facts dd {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-small);
  }

  .fw-facts__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fw-facts__links li + li {
    margin-top: var(--sp-1);
  }

  .fw-code {
    font-weight: 700;
    color: var(--brass-text);
    font-variant-numeric: tabular-nums;
  }

  .fw-guide {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4);
    border: 1px solid var(--navy-900);
    background: var(--ivory-50);
    color: var(--text-body);
    text-decoration: none;
  }

  .fw-guide:hover {
    background: var(--surface-gold-wash);
  }

  .fw-guide__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--cobalt-text);
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
  }

  .fw-guide__text {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .fw-what {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--sp-6);
    margin-top: var(--sp-5);
    align-items: start;
  }

  .fw-what__body {
    max-width: var(--text-max);
  }

  .fw-purpose {
    padding: var(--sp-4) var(--sp-5);
    border-left: 3px solid var(--gold-500);
    background: var(--surface-gold-wash);
  }

  .fw-purpose .label {
    display: block;
    margin-bottom: var(--sp-2);
    color: var(--brass-text);
  }

  .fw-steps {
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
    border-top: 2px solid var(--rule-ink);
  }

  .fw-steps li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: baseline;
    margin: 0;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .fw-steps__no {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-style: italic;
    line-height: 1;
    color: var(--gold-600);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .fw-example {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
    max-width: 52rem;
  }

  .fw-result {
    padding: var(--sp-4) var(--sp-5);
    border-left: 3px solid var(--bb-cobalt);
    background: var(--surface-sheet);
  }

  .fw-result .label {
    display: block;
    margin-bottom: var(--sp-1);
    color: var(--cobalt-text);
  }

  .fw-weigh {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6);
    margin-top: var(--sp-5);
  }

  .fw-weigh > div {
    padding-top: var(--sp-3);
    border-top: 2px solid var(--rule);
  }

  .fw-weigh__h {
    margin-bottom: var(--sp-2);
    font-size: 1.1875rem;
  }

  .fw-weigh__h--plus {
