---
/**
 * The coverage tracker: for every subtopic, what the platform has. Computed
 * from the content's relationships (src/lib/coverage.ts), so it cannot claim
 * coverage that does not exist. Four signals: complete (full notes or a
 * brief), partly built, planned, and verified against the guide.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import LevelTag from '../../components/ui/LevelTag.astro';
import VerifyTag from '../../components/ui/VerifyTag.astro';
import { corpus, href } from '../../lib/content';
import { STATE_LABEL, coverageSummary, subtopicCoverage } from '../../lib/coverage';
import { mindmapFor, subtopicHref } from '../../lib/learning';

const c = await corpus();
const rows = subtopicCoverage(c).map((r) => {
  const s = r.subtopic;
  const ixs = Object.entries(c.interactives).filter(([, it]) => it.syllabus.includes(s.code) && it.page);
  const calcs = Object.entries(c.calculations).filter(([, k]) => k.syllabus.some((x) => x.code === s.code));
  const map = mindmapFor(c, s.code);
  return { ...r, ixs, calcs, map, page: r.brief && s.topic ? href.topic(s.topic) : subtopicHref(c, s.code) };
});
// The same headline figures the home page and the topic library quote.
const sum = coverageSummary(c);
---

<BaseLayout title="Coverage tracker" description="What the platform has for each subtopic of IB DP Business Management: complete, partly built or planned, and verified against the guide." section="topics">
  <PageIntro
    trail={[{ label: 'IB course', href: '/ib/' }, { label: 'Coverage' }]}
    kicker="IB Diploma Programme"
    title="Coverage tracker"
    lead={`${sum.complete} of ${sum.total} subtopics are complete, with full notes (${sum.withNotes}) or a complete brief (${sum.withBriefs}); ${sum.partial} are partly built; ${sum.planned} are planned. ${sum.verified} of ${sum.total} have their content statements verified against the guide. The table is generated from the content itself, so a subtopic shows material only when it exists.`}
  />
  <div class="wrap page-body">
    <ul class="cov-key" aria-label="What the states mean">
      <li><span class="cov-state cov-state--complete">Complete</span> Full notes or a complete brief, with its mindmap, terms and practice</li>
      <li><span class="cov-state cov-state--partial">Partly built</span> A page with the mindmap, key terms, diagrams and any tools; notes still to come</li>
      <li><span class="cov-state cov-state--planned">Planned</span> Nothing yet beyond the guide's statements</li>
      <li><VerifyTag status="primary" /> Content statements checked against the guide</li>
    </ul>
    <div class="table-scroll" role="region" aria-label="Coverage by subtopic" tabindex="0">
      <table class="table coverage">
        <thead>
          <tr>
            <th scope="col">Subtopic</th>
            <th scope="col">Level and verification</th>
            <th scope="col">State</th>
            <th scope="col">Notes or brief</th>
            <th scope="col">Mindmap</th>
            <th scope="col" class="n">Terms</th>
            <th scope="col" class="n">Diagrams</th>
            <th scope="col">Tools and calculations</th>
            <th scope="col" class="n">Practice</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">
                  <a href={r.page}>
                    <span class="num">{r.subtopic.code}</span> {r.subtopic.title}
                  </a>
                </th>
                <td>
                  <span class="tags">
                    <LevelTag level={r.subtopic.level} always />
                    <VerifyTag status={r.subtopic.verification} />
                  </span>
                </td>
                <td>
                  <span class:list={['cov-state', `cov-state--${r.state}`]}>{STATE_LABEL[r.state]}</span>
                </td>
                <td>
                  {r.notes ? (
                    <a href={r.page}>Full notes</a>
                  ) : r.brief && r.subtopic.topic ? (
                    <a href={href.topic(r.subtopic.topic)}>Complete brief</a>
                  ) : r.inBrief ? (
                    <a href={href.topic(r.inBrief)}>In part, in the {c.topics[r.inBrief]?.code} brief</a>
                  ) : (
                    <span class="muted">To come</span>
                  )}
                </td>
                <td>{r.map ? <a href={href.mindmap(r.map[0])}>Mindmap</a> : <span class="muted">None yet</span>}</td>
                <td class="n">{r.terms || <span class="muted">0</span>}</td>
                <td class="n">{r.diagrams || <span class="muted">0</span>}</td>
                <td>
                  {r.ixs.length || r.calcs.length ? (
                    <ul class="plain-list">
                      {r.ixs.map(([id, it]) => (
                        <li>
                          <a href={`${it.page}#ix-${id}`}>{it.title}</a>
                        </li>
                      ))}
                      {r.calcs.map(([id, k]) => (
                        <li>
                          <a href={href.calculation(id, k.page)}>{k.name}</a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <span class="muted">None yet</span>
                  )}
                </td>
                <td class="n">{r.questions || <span class="muted">0</span>}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <aside class="callout callout--note">
      <span class="callout__kicker">Why the notes come one at a time</span>
      <div class="prose">
        <p>
          Every subtopic already has a page with what the course asks, its mindmap, its key terms and the diagrams and tools that serve it. Full notes are written one subtopic at a time, each complete, with sections, worked examples, evaluation and retrieval questions, rather than all at once and thin. This table updates itself as each set of notes is added.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .cov-key {
    list-style: none;
    margin: 0 0 var(--sp-5);
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    font-size: 0.9375rem;
  }

  .cov-key li {
    display: flex;
    gap: var(--sp-3);
    align-items: baseline;
  }

  .cov-state {
    display: inline-block;
    min-width: 7.5rem;
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 2px;
    text-align: center;
    white-space: nowrap;
  }

  .cov-state--complete {
    color: var(--text-on-ink);
    background: var(--navy-900);
    border-color: var(--navy-900);
  }

  .cov-state--partial {
    color: var(--brass-text);
    background: var(--surface-gold-wash);
  }

  .cov-state--planned {
    color: var(--text-muted);
    border-style: dashed;
  }

  .plain-list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .plain-list li + li {
    margin-top: 0.25rem;
  }

  /* WCAG 2.2 target size: at least 24 by 24 pixels for each link. */
  .plain-list a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
  }

  @media (max-width: 40rem) {
    .cov-key li {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
