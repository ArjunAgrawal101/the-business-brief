---
/**
 * One item of the Business Intelligence Briefing, answering six questions in
 * order: what happened, the business context, the management concepts that
 * apply, the choices the organization faced, the implications, and what a
 * student or manager can learn. "What happened" holds only sourced facts,
 * each dated and tied to its source; everything after it is the platform's
 * analysis, labelled as such, with the course and what lies beyond it kept
 * apart. A discussion question of the platform's own, the limits of the
 * evidence and the sources close the page, each source with what it supports
 * and when it was read.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import ProvenanceTag from '../../components/ui/ProvenanceTag.astro';
import FactList from '../../components/intelligence/FactList.astro';
import { briefingData, briefingHref } from '../../lib/briefing-content';
import { CATEGORY_LABELS, SOURCE_KIND_LABELS, facetsOf, formatDate, regionsLine, themeHref } from '../../lib/briefing';
import { corpus, href } from '../../lib/content';
import { frameworkHref, standing } from '../../lib/frameworks';
import { CONCEPT_NAMES } from '../../lib/labels';
import { subtopicHref, allSubtopics } from '../../lib/learning';
import { inline, rich } from '../../lib/markup';
import type { IntelSource, Intelligence } from '../../lib/schemas';
import '../../styles/intelligence.css';

export async function getStaticPaths() {
  const { items } = await briefingData();
  return items.map(([id, it], i) => ({
    params: { id },
    props: { id, it, newer: items[i - 1]?.[0], older: items[i + 1]?.[0] },
  }));
}

interface Props {
  id: string;
  it: Intelligence;
  newer?: string;
  older?: string;
}
const { id, it, newer, older } = Astro.props;
const c = await corpus();
const data = await briefingData();
const items = Object.fromEntries(data.items);
const subs = allSubtopics(c);
const subOf = (code: string) => subs.find((x) => x.s.code === code)?.s;
const facets = facetsOf(it);
const sourceNo = new Map(it.sources.map((s, i) => [s.id, i + 1]));
const sourceOf = (sid: string) => it.sources.find((s) => s.id === sid);
const term = c.commandTerms[it.question.command];
const kinds = it.categories.map((k) => CATEGORY_LABELS[k]).join(' · ');
const docDate = (s: IntelSource) => (s.published ? formatDate(s.published) : 'Undated page');
const unitsLine = facets.units.map((u) => (u === 'toolkit' ? 'Toolkit' : `Unit ${u}`)).join(', ');

// The course and what lies beyond it, kept apart: glossary terms and frameworks carry their own standing.
const courseTerms = it.concepts.terms.filter((t) => c.glossary[t] && c.glossary[t]?.provenance !== 'enrichment');
const beyondTerms = it.concepts.terms.filter((t) => c.glossary[t]?.provenance === 'enrichment');
const frameworkOf = (fid: string) => data.frameworks[fid];
const courseFrameworks = it.concepts.frameworks.filter((f) => frameworkOf(f.id) && frameworkOf(f.id)?.status !== 'enrichment');
const beyondFrameworks = it.concepts.frameworks.filter((f) => frameworkOf(f.id)?.status === 'enrichment');
// A toolkit tool's entry in the frameworks library, and the Strategy Studio tool that applies it, where they exist.
const toolFramework = (toolId: string) => Object.entries(data.frameworks).find(([, f]) => f.status === 'toolkit' && f.tool === toolId);
const studioTool = (slug?: string) => (slug ? data.studio.find((s) => s.slug === slug) : undefined);
const hasBeyond = beyondTerms.length > 0 || beyondFrameworks.length > 0;

// Other items that share a theme with this one, newest first.
const related = data.items.filter(([oid, o]) => oid !== id && o.categories.some((k) => it.categories.includes(k))).slice(0, 4);

const sections = [
  ['happened', 'What happened?'],
  ['context', 'What is the business context?'],
  ['concepts', 'Which management concepts are relevant?'],
  ['choices', 'What choices did the organization face?'],
  ['implications', 'What were the implications?'],
  ['lessons', 'What can a student or manager learn?'],
  ['question', 'Discussion question'],
  ['limits', 'The limits of the evidence'],
  ['sources', 'Sources'],
] as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: it.title,
  description: it.dek,
  datePublished: it.written,
  dateCreated: it.written,
  dateModified: it.checked,
  author: { '@type': 'Person', name: 'Arjun Agrawal' },
  publisher: { '@type': 'Organization', name: 'The Business Brief' },
  about: it.organizations.map((name) => ({ '@type': 'Organization', name })),
  citation: it.sources.map((s) => s.url),
};
---

<BaseLayout title={it.title} description={it.dek} section="intelligence" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="ib-head">
      <Breadcrumbs trail={[{ label: 'Business Intelligence Briefing', href: '/intelligence/' }, { label: CATEGORY_LABELS[it.categories[0] ?? 'corporate-strategy'], href: themeHref(it.categories[0] ?? 'corporate-strategy') }, { label: it.title }]} />
      <p class="label label--ink ib-head__kicker">
        {kinds} · <time datetime={it.date}>{formatDate(it.date)}</time>
      </p>
      <h1 class="ib-head__title">{it.title}</h1>
      <p class="lead ib-head__dek">{it.dek}</p>
      <ul class="ib-head__stamp" role="list">
        <li><span class="label">Published</span> <time datetime={it.written}>{formatDate(it.written)}</time></li>
        <li><span class="label">Sources checked</span> <time datetime={it.checked}>{formatDate(it.checked)}</time></li>
        <li><span class="label">Sources</span> {it.sources.length}, {it.sources.every((s) => s.primary) ? 'all primary' : `${it.sources.filter((s) => s.primary).length} primary`}</li>
        <li><span class="label">Where</span> {regionsLine(it.regions)} · {it.industry}</li>
      </ul>
      <p class="ib-head__notice small">
        A curated item, not a live report: it was checked on {formatDate(it.checked)} and does not update by itself. Later events may have changed the picture.
      </p>
      {
        it.figures.length > 0 && (
          <dl class="ib-head__figures" aria-label="Headline figures, from the sources">
            {it.figures.map((g) => {
              const s = sourceOf(g.source);
              return (
                <div>
                  <dt>
                    {g.label}
                    {s && (
                      <>
                        {' '}
                        <a class="ib-cite" href={`#src-${s.id}`}>
                          <span class="sr-only">Source </span>[{sourceNo.get(s.id)}]
                        </a>
                      </>
                    )}
                  </dt>
                  <dd>{g.value}</dd>
                </div>
              );
            })}
          </dl>
        )
      }
    </header>
  </div>

  <div class="wrap page-body">
    <div class="ib-doc">
      <div class="ib-doc__main">
        <section aria-labelledby="happened-h">
          <SectionHead no={1} title="What happened?" id="happened-h" dek="Sourced facts only, each with the date it refers to and the document that states it." />
          <div class="tags ib-provenance"><ProvenanceTag kind="external-evidence" /></div>
          {
            it.background.length > 0 && (
              <>
                <h3 class="ib-facts-h">Background</h3>
                <FactList facts={it.background} sources={it.sources} />
              </>
            )
          }
          <h3 class="ib-facts-h">The development</h3>
          <FactList facts={it.happened} sources={it.sources} />
          {
            it.since.length > 0 && (
              <>
                <h3 class="ib-facts-h ib-since__h">Since then</h3>
                <FactList facts={it.since} sources={it.sources} />
              </>
            )
          }
        </section>

        <div class="ib-analysis-mark">
          <span class="tag tag--framework">The Business Brief's analysis</span>
          <p class="small">From here to the discussion question, the page gives the platform's reading of the facts above: the context, the concepts, the choices, the implications and the lessons. It is interpretation, not reporting, and it adds no new facts about the organizations.</p>
        </div>

        <section aria-labelledby="context-h">
          <SectionHead no={2} title="What is the business context?" id="context-h" dek="The organization, its industry and the situation it was in, read from the facts above." />
          <div class="prose ib-prose" set:html={rich(it.context)} />
        </section>

        <section aria-labelledby="concepts-h">
          <SectionHead no={3} title="Which management concepts are relevant?" id="concepts-h" dek="Where this development meets the IB course, and where it reaches beyond it, with links to the subtopics, terms, frameworks and tools that explain it." />

          <div class="ib-group">
            <div class="ib-group__head">
              <h3>In the IB course</h3>
            </div>
            <ul class="ib-concepts" role="list">
              {
                it.concepts.subtopics.map((x) => {
                  const s = subOf(x.code);
                  return (
                    s && (
                      <li>
                        <p class="ib-concepts__name">
                          <a href={subtopicHref(c, x.code)}>
                            <span class="ib-concepts__code">{x.code}</span> {s.title}
                          </a>
                          {x.level === 'HL' && <span class="tag tag--hl">{s.level === 'HL' ? 'HL' : 'HL content'}</span>}
                        </p>
                        <p class="small" set:html={inline(x.note)} />
                      </li>
                    )
                  );
                })
              }
            </ul>
            {
              courseTerms.length > 0 && (
                <div class="ib-terms">
                  <h4 class="label label--ink">Key terms</h4>
                  <ul class="ib-chips" role="list">
                    {courseTerms.map((t) => {
                      const g = c.glossary[t];
                      return (
                        g && (
                          <li>
                            <a href={href.glossary(t)}>
                              {g.term}
                              {g.level === 'HL' && <span class="ib-chips__hl">HL<span class="sr-only"> only</span></span>}
                            </a>
                          </li>
                        )
                      );
                    })}
                  </ul>
                </div>
              )
            }
            {
              (it.concepts.tools.length > 0 || courseFrameworks.length > 0) && (
                <div class="ib-terms">
                  <h4 class="label label--ink">Toolkit and frameworks</h4>
                  <ul class="ib-links" role="list">
                    {it.concepts.tools.map((x) => {
                      const t = c.tools[x.id];
                      const fw = toolFramework(x.id);
                      const st = studioTool(fw?.[1].studio);
                      return (
                        t && (
                          <li>
                            <p class="ib-links__name">
                              <a href={href.toolEntry(x.id, t)}>{t.name}</a>
                              <span class="tag tag--plain">IB toolkit</span>
                              {t.level === 'HL' && <span class="tag tag--hl">HL</span>}
                              {t.status !== 'complete' && <span class="tag tag--planned">Guide planned</span>}
                            </p>
                            <p class="small" set:html={inline(x.note)} />
                            {(fw || st) && (
                              <ul class="ib-links__also" role="list">
                                {fw && (
                                  <li>
                                    <a href={frameworkHref(fw[0])}>
                                      In the frameworks library<span class="sr-only">: {fw[1].name}</span>
                                    </a>
                                  </li>
                                )}
                                {st && (
                                  <li>
                                    <a href={`/strategy-studio/${st.slug}/`}>Apply it in the Strategy Studio: {st.title}</a>
                                  </li>
                                )}
                              </ul>
                            )}
                          </li>
                        )
                      );
                    })}
                    {courseFrameworks.map((x) => {
                      const f = frameworkOf(x.id);
                      const st = studioTool(f?.studio);
                      return (
                        f && (
                          <li>
                            <p class="ib-links__name">
                              <a href={frameworkHref(x.id)}>{f.name}</a>
                              <span class="tag tag--plain">IB syllabus</span>
                              {f.level === 'HL' && <span class="tag tag--hl">HL</span>}
                            </p>
                            <p class="small" set:html={inline(x.note)} />
                            <ul class="ib-links__also" role="list">
                              <li class="muted">{standing(f)}</li>
                              {st && (
                                <li>
                                  <a href={`/strategy-studio/${st.slug}/`}>Apply it in the Strategy Studio: {st.title}</a>
                                </li>
                              )}
                            </ul>
                          </li>
                        )
                      );
                    })}
                  </ul>
                </div>
              )
            }
            <p class="small ib-keyconcepts">
              Key concepts: {it.keyConcepts.map((k, i) => <>{i > 0 ? ', ' : ''}<a href={href.concept(k)}>{CONCEPT_NAMES[k]}</a></>)}
            </p>
          </div>

          {
            hasBeyond && (
              <div class="ib-group ib-group--beyond">
                <div class="ib-group__head">
                  <h3>Beyond the course</h3>
                  <ProvenanceTag kind="enrichment" />
                </div>
                <p class="ib-group__intro">For undergraduate, MBA and professional readers. These ideas are not part of the IB course and are not assessed by it.</p>
                {beyondFrameworks.length > 0 && (
                  <ul class="ib-links" role="list">
                    {beyondFrameworks.map((x) => {
                      const f = frameworkOf(x.id);
                      const st = studioTool(f?.studio);
                      return (
                        f && (
                          <li>
                            <p class="ib-links__name">
                              <a href={frameworkHref(x.id)}>{f.name}</a>
                            </p>
                            <p class="small" set:html={inline(x.note)} />
                            {st && (
                              <ul class="ib-links__also" role="list">
                                <li>
                                  <a href={`/strategy-studio/${st.slug}/`}>Apply it in the Strategy Studio: {st.title}</a>
                                </li>
                              </ul>
                            )}
                          </li>
                        )
                      );
                    })}
                  </ul>
                )}
                {beyondTerms.length > 0 && (
                  <div class="ib-terms">
                    <h4 class="label label--ink">Terms beyond the course</h4>
                    <ul class="ib-chips" role="list">
                      {beyondTerms.map((t) => {
                        const g = c.glossary[t];
                        return (
                          g && (
                            <li>
                              <a href={href.glossary(t)}>{g.term}</a>
                            </li>
                          )
                        );
                      })}
                    </ul>
                  </div>
                )}
              </div>
            )
          }

          {
            it.concepts.apply.length > 0 && (
              <div class="ib-group">
                <div class="ib-group__head">
                  <h3>Work it through on the platform</h3>
                </div>
                <ul class="ib-links" role="list">
                  {it.concepts.apply.map((a) => (
                    <li>
                      <p class="ib-links__name">
                        <a href={a.href}>{a.label}</a>
                      </p>
                      <p class="small" set:html={inline(a.note)} />
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        <section aria-labelledby="choices-h">
          <SectionHead no={4} title="What choices did the organization face?" id="choices-h" dek="The realistic options, with the case for and against each. Where the organization's choice is known from the facts above, it is marked." />
          <ol class="ib-choices" role="list">
            {
              it.choices.map((ch, i) => (
                <li class:list={['ib-choice', { 'is-taken': ch.taken }]}>
                  <p class="ib-choice__no" aria-hidden="true">
                    {String.fromCharCode(65 + i)}
                  </p>
                  <div>
                    <h3 class="ib-choice__title">
                      {ch.option}
                      {ch.taken && <span class="tag tag--plain ib-choice__taken">The option taken</span>}
                    </h3>
                    <p class="ib-choice__text" set:html={inline(ch.analysis)} />
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="implications-h">
          <SectionHead no={5} title="What were the implications?" id="implications-h" dek="What followed, or may follow, for the organization, its stakeholders and its industry." />
          <div class="prose ib-prose" set:html={rich(it.implications)} />
        </section>

        <section aria-labelledby="lessons-h">
          <SectionHead no={6} title="What can a student or manager learn?" id="lessons-h" />
          <ul class="prose ib-lessons">
            {it.lessons.map((l) => <li set:html={inline(l)} />)}
          </ul>
        </section>

        <section aria-labelledby="question-h">
          <SectionHead no={7} title="Discussion question" id="question-h" />
          <div class="ib-question">
            <div class="tags">
              <ProvenanceTag kind="original-practice" />
              {it.question.level === 'HL' && <span class="tag tag--hl">HL</span>}
            </div>
            <p class="ib-question__prompt">{it.question.prompt}</p>
            <p class="small muted">
              Command term:{' '}
              {term ? <a href={href.commandTerm(term.term)}>{term.term}</a> : it.question.command}
              {term && <span> ({term.ao})</span>}. The platform's own question for discussion; it is not an IB examination question and has no official markscheme.
            </p>
          </div>
        </section>

        <section aria-labelledby="limits-h">
          <SectionHead no={8} title="The limits of the evidence" id="limits-h" dek="What the sources do not show, so that no one takes the analysis for more than it is." />
          <ul class="prose ib-limits">
            {it.limits.map((l) => <li set:html={inline(l)} />)}
          </ul>
        </section>

        <section aria-labelledby="sources-h">
          <SectionHead no={9} title="Sources" id="sources-h" dek="Every source was opened and read on the date shown. Each entry says which facts on this page it supports." />
          <ol class="ib-sources" role="list">
            {
              it.sources.map((s, i) => (
                <li id={`src-${s.id}`}>
                  <p class="label">
                    [{i + 1}] {SOURCE_KIND_LABELS[s.kind]} · {s.primary ? 'Primary source' : 'Secondary source'}
                  </p>
                  <h3 class="ib-sources__title">
                    <a href={s.url} rel="noopener">
                      {s.title}
                      <span class="sr-only"> (external site)</span>
                    </a>
                  </h3>
                  <dl class="ib-sources__meta">
                    <div>
                      <dt>Publisher</dt>
                      <dd>{s.publisher}</dd>
                    </div>
                    {s.author && (
                      <div>
                        <dt>Author</dt>
                        <dd>{s.author}</dd>
                      </div>
                    )}
                    <div>
                      <dt>Published</dt>
                      <dd>{s.published ? <time datetime={s.published}>{docDate(s)}</time> : docDate(s)}</dd>
                    </div>
                    <div>
                      <dt>Accessed</dt>
                      <dd>
                        <time datetime={s.accessed}>{formatDate(s.accessed)}</time>
                      </dd>
                    </div>
                  </dl>
                  <p class="ib-sources__url small">{s.url}</p>
                  <p class="label ib-sources__supports-h">Supports</p>
                  <ul class="small ib-sources__supports">
                    {s.supports.map((x) => <li set:html={inline(x)} />)}
                  </ul>
                  {s.undated && <p class="small muted">{s.undated}</p>}
                  {s.note && <p class="small muted">{s.note}</p>}
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="ib-doc__side" aria-label="About this item">
        <div class="ib-side">
          <dl class="ib-side__facts">
            <div>
              <dt>Development</dt>
              <dd><time datetime={it.date}>{formatDate(it.date)}</time></dd>
            </div>
            <div>
              <dt>Published</dt>
              <dd><time datetime={it.written}>{formatDate(it.written)}</time></dd>
            </div>
            <div>
              <dt>Checked</dt>
              <dd><time datetime={it.checked}>{formatDate(it.checked)}</time></dd>
            </div>
            <div>
              <dt>Organizations</dt>
              <dd>{it.organizations.join(', ')}</dd>
            </div>
            <div>
              <dt>Region</dt>
              <dd>{regionsLine(it.regions)}</dd>
            </div>
            <div>
              <dt>Industry</dt>
              <dd>{it.industry}</dd>
            </div>
            <div>
              <dt>Themes</dt>
              <dd>{it.categories.map((k, i) => <>{i > 0 ? ', ' : ''}<a href={themeHref(k)}>{CATEGORY_LABELS[k]}</a></>)}</dd>
            </div>
            <div>
              <dt>Course</dt>
              <dd>{unitsLine}</dd>
            </div>
            <div>
              <dt>Key concepts</dt>
              <dd>{it.keyConcepts.map((k) => CONCEPT_NAMES[k]).join(', ')}</dd>
            </div>
          </dl>
          <nav class="ib-side__toc" aria-label="On this page">
            <p class="label">On this page</p>
            <ol role="list">
              {sections.map(([anchor, label]) => (
                <li>
                  <a href={`#${anchor}-h`}>{label}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="ib-related-items" aria-labelledby="related-h">
          <SectionHead title="Related in the briefing" id="related-h" dek="Other items that share a theme with this one, newest first." />
          <ul class="ib-stories" role="list">
            {related.map(([rid, r]) => (
              <li class="ib-story">
                <p class="label">{r.categories.filter((k) => it.categories.includes(k)).map((k) => CATEGORY_LABELS[k]).join(' · ')}</p>
                <h3 class="ib-story__title">
                  <a href={briefingHref(rid)}>{r.title}</a>
                </h3>
                <ul class="ib-dates" role="list">
                  <li><span class="label">Published</span><time datetime={r.written}>{formatDate(r.written)}</time></li>
                  <li><span class="label">Checked</span><time datetime={r.checked}>{formatDate(r.checked)}</time></li>
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="ib-pager" aria-label="More from the briefing">
      {
        newer && items[newer] ? (
          <a class="ib-pager__link" href={briefingHref(newer)}>
            <span class="label">Newer item</span>
            <span class="ib-pager__title">{items[newer]?.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      <a class="ib-pager__link ib-pager__link--all" href="/intelligence/">
        <span class="label">The briefing</span>
        <span class="ib-pager__title">Every item, newest first</span>
      </a>
      {
        older && items[older] ? (
          <a class="ib-pager__link ib-pager__link--older" href={briefingHref(older)}>
            <span class="label">Older item</span>
            <span class="ib-pager__title">{items[older]?.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</BaseLayout>
