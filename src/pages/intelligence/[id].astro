---
/**
 * One item of the Business Intelligence Briefing. "What happened" holds only
 * sourced facts, each dated and tied to its source; everything after it is
 * the platform's analysis, labelled as such: why it matters, the course
 * concepts at work, the choices that were open, the lessons, a discussion
 * question of the platform's own and the limits of the evidence. The sources
 * close the page, each with what it supports and when it was read.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import ProvenanceTag from '../../components/ui/ProvenanceTag.astro';
import { briefing, briefingHref } from '../../lib/briefing-content';
import { CATEGORY_LABELS, SOURCE_KIND_LABELS, facetsOf, formatDate } from '../../lib/briefing';
import { corpus, href } from '../../lib/content';
import { CONCEPT_NAMES } from '../../lib/labels';
import { subtopicHref, allSubtopics } from '../../lib/learning';
import { inline, rich } from '../../lib/markup';
import type { IntelFact, IntelSource, Intelligence } from '../../lib/schemas';

export async function getStaticPaths() {
  const items = await briefing();
  return items.map(([id, it], i) => ({
    params: { id },
    props: { id, it, newer: items[i - 1]?.[0], older: items[i + 1]?.[0] },
  }));
}

interface Props {
  id: string;
  it: Intelligence;
  newer?: string;
  older?: string;
}
const { it, newer, older } = Astro.props;
const c = await corpus();
const items = Object.fromEntries(await briefing());
const subs = allSubtopics(c);
const subOf = (code: string) => subs.find((x) => x.s.code === code)?.s;
const facets = facetsOf(it);
const sourceNo = new Map(it.sources.map((s, i) => [s.id, i + 1]));
const sourceOf = (sid: string) => it.sources.find((s) => s.id === sid);
const term = c.commandTerms[it.question.command];
const kinds = it.categories.map((k) => CATEGORY_LABELS[k]).join(' · ');
const docDate = (s: IntelSource) => (s.published ? formatDate(s.published) : 'Undated page');
const citeLabel = (s: IntelSource) => `${s.publisher}, ${SOURCE_KIND_LABELS[s.kind]?.toLowerCase()}${s.published ? ` of ${formatDate(s.published)}` : `, read ${formatDate(s.accessed)}`}`;
const factDate = (f: IntelFact) => (f.asAt ? `As at ${formatDate(f.date)}` : formatDate(f.date));
const unitsLine = facets.units.map((u) => (u === 'toolkit' ? 'Toolkit' : `Unit ${u}`)).join(', ');
const sections = [
  ['happened', 'What happened'],
  ['matters', 'Why it matters'],
  ['concepts', 'The concepts at work'],
  ['choices', 'The choices that were open'],
  ['lessons', 'What students and managers can learn'],
  ['question', 'Discussion question'],
  ['limits', 'The limits of the evidence'],
  ['sources', 'Sources'],
] as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: it.title,
  description: it.dek,
  dateCreated: it.written,
  dateModified: it.checked,
  author: { '@type': 'Person', name: 'Arjun Agrawal' },
  publisher: { '@type': 'Organization', name: 'The Business Brief' },
  about: it.organizations.map((name) => ({ '@type': 'Organization', name })),
  citation: it.sources.map((s) => s.url),
};
---

<BaseLayout title={it.title} description={it.dek} section="intelligence" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="ib-head">
      <Breadcrumbs trail={[{ label: 'Business Intelligence Briefing', href: '/intelligence/' }, { label: it.title }]} />
      <p class="label label--ink ib-head__kicker">
        {kinds} · <time datetime={it.date}>{formatDate(it.date)}</time>
      </p>
      <h1 class="ib-head__title">{it.title}</h1>
      <p class="lead ib-head__dek">{it.dek}</p>
      <ul class="ib-head__stamp" role="list">
        <li><span class="label">Written</span> <time datetime={it.written}>{formatDate(it.written)}</time></li>
        <li><span class="label">Sources checked</span> <time datetime={it.checked}>{formatDate(it.checked)}</time></li>
        <li><span class="label">Sources</span> {it.sources.length}, {it.sources.every((s) => s.primary) ? 'all primary' : `${it.sources.filter((s) => s.primary).length} primary`}</li>
      </ul>
      <p class="ib-head__notice small">
        A curated item, not a live report: it was checked on {formatDate(it.checked)} and does not update by itself. Later events may have changed the picture.
      </p>
      {
        it.figures.length > 0 && (
          <dl class="ib-head__figures" aria-label="Headline figures, from the sources">
            {it.figures.map((g) => {
              const s = sourceOf(g.source);
              return (
                <div>
                  <dt>
                    {g.label}
                    {s && (
                      <>
                        {' '}
                        <a class="ib-cite" href={`#src-${s.id}`}>
                          <span class="sr-only">Source </span>[{sourceNo.get(s.id)}]
                        </a>
                      </>
                    )}
                  </dt>
                  <dd>{g.value}</dd>
                </div>
              );
            })}
          </dl>
        )
      }
    </header>
  </div>

  <div class="wrap page-body">
    <div class="ib-doc">
      <div class="ib-doc__main">
        <section aria-labelledby="happened-h">
          <SectionHead no={1} title="What happened" id="happened-h" dek="Sourced facts only, each with the date it refers to and the document that states it." />
          <div class="tags ib-provenance"><ProvenanceTag kind="external-evidence" /></div>
          <ol class="ib-facts" role="list">
            {
              it.happened.map((f) => (
                <li class="ib-fact">
                  <p class="ib-fact__date">
                    <time datetime={f.date}>{factDate(f)}</time>
                  </p>
                  <div class="ib-fact__body">
                    <div class="ib-fact__text" set:html={rich(f.text)} />
                    <p class="ib-fact__src">
                      {f.sources.length === 1 ? 'Source' : 'Sources'}:{' '}
                      {f.sources.map((sid, i) => {
                        const s = sourceOf(sid);
                        return s && <>{i > 0 ? '; ' : ''}<a href={`#src-${s.id}`}>[{sourceNo.get(s.id)}] {citeLabel(s)}</a></>;
                      })}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
          {
            it.since.length > 0 && (
              <>
                <h3 class="ib-since__h">Since then</h3>
                <ol class="ib-facts" role="list">
                  {it.since.map((f) => (
                    <li class="ib-fact">
                      <p class="ib-fact__date">
                        <time datetime={f.date}>{factDate(f)}</time>
                      </p>
                      <div class="ib-fact__body">
                        <div class="ib-fact__text" set:html={rich(f.text)} />
                        <p class="ib-fact__src">
                          {f.sources.length === 1 ? 'Source' : 'Sources'}:{' '}
                          {f.sources.map((sid, i) => {
                            const s = sourceOf(sid);
                            return s && <>{i > 0 ? '; ' : ''}<a href={`#src-${s.id}`}>[{sourceNo.get(s.id)}] {citeLabel(s)}</a></>;
                          })}
                        </p>
                      </div>
                    </li>
                  ))}
                </ol>
              </>
            )
          }
        </section>

        <div class="ib-analysis-mark">
          <span class="tag tag--framework">The Business Brief's analysis</span>
          <p class="small">From here to the discussion question, the page gives the platform's reading of the facts above. It is interpretation, not reporting, and it adds no new facts about the organizations.</p>
        </div>

        <section aria-labelledby="matters-h">
          <SectionHead no={2} title="Why it matters" id="matters-h" />
          <div class="prose ib-prose" set:html={rich(it.matters)} />
        </section>

        <section aria-labelledby="concepts-h">
          <SectionHead no={3} title="The concepts at work" id="concepts-h" dek="Where this development meets the IB course, with links to the subtopics, terms and tools that explain it." />
          <ul class="ib-concepts" role="list">
            {
              it.concepts.subtopics.map((x) => {
                const s = subOf(x.code);
                return (
                  s && (
                    <li>
                      <p class="ib-concepts__name">
                        <a href={subtopicHref(c, x.code)}>
                          <span class="ib-concepts__code">{x.code}</span> {s.title}
                        </a>
                        {x.level === 'HL' && <span class="tag tag--hl">{s.level === 'HL' ? 'HL' : 'HL content'}</span>}
                      </p>
                      <p class="small" set:html={inline(x.note)} />
                    </li>
                  )
                );
              })
            }
          </ul>
          {
            it.concepts.terms.length > 0 && (
              <div class="ib-terms">
                <h3 class="label label--ink">Key terms</h3>
                <ul class="ib-chips" role="list">
                  {it.concepts.terms.map((t) => {
                    const g = c.glossary[t];
                    return (
                      g && (
                        <li>
                          <a href={href.glossary(t)}>
                            {g.term}
                            {g.level === 'HL' && <span class="ib-chips__hl">HL<span class="sr-only"> only</span></span>}
                          </a>
                        </li>
                      )
                    );
                  })}
                </ul>
              </div>
            )
          }
          {
            it.concepts.tools.length > 0 && (
              <div class="ib-terms">
                <h3 class="label label--ink">Toolkit</h3>
                <ul class="ib-tools" role="list">
                  {it.concepts.tools.map((x) => {
                    const t = c.tools[x.id];
                    return (
                      t && (
                        <li>
                          <a href={href.toolEntry(x.id, t)}>{t.name}</a>
                          {t.level === 'HL' && <span class="tag tag--hl">HL</span>}
                          {t.status !== 'complete' && <span class="tag tag--planned">Guide planned</span>}
                          <span class="small"> {x.note}</span>
                        </li>
                      )
                    );
                  })}
                </ul>
              </div>
            )
          }
          <p class="small ib-keyconcepts">
            Key concepts: {it.keyConcepts.map((k, i) => <>{i > 0 ? ', ' : ''}<a href={href.concept(k)}>{CONCEPT_NAMES[k]}</a></>)}
          </p>
        </section>

        <section aria-labelledby="choices-h">
          <SectionHead no={4} title="The choices that were open" id="choices-h" dek="The realistic options, with the case for and against each. Where the organization's choice is known from the facts above, it is marked." />
          <ol class="ib-choices" role="list">
            {
              it.choices.map((ch, i) => (
                <li class:list={['ib-choice', { 'is-taken': ch.taken }]}>
                  <p class="ib-choice__no" aria-hidden="true">
                    {String.fromCharCode(65 + i)}
                  </p>
                  <div>
                    <h3 class="ib-choice__title">
                      {ch.option}
                      {ch.taken && <span class="tag tag--plain ib-choice__taken">The option taken</span>}
                    </h3>
                    <p class="ib-choice__text" set:html={inline(ch.analysis)} />
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="lessons-h">
          <SectionHead no={5} title="What students and managers can learn" id="lessons-h" />
          <ul class="prose ib-lessons">
            {it.lessons.map((l) => <li set:html={inline(l)} />)}
          </ul>
        </section>

        <section aria-labelledby="question-h">
          <SectionHead no={6} title="Discussion question" id="question-h" />
          <div class="ib-question">
            <div class="tags">
              <ProvenanceTag kind="original-practice" />
              {it.question.level === 'HL' && <span class="tag tag--hl">HL</span>}
            </div>
            <p class="ib-question__prompt">{it.question.prompt}</p>
            <p class="small muted">
              Command term:{' '}
              {term ? <a href={href.commandTerm(term.term)}>{term.term}</a> : it.question.command}
              {term && <span> ({term.ao})</span>}. The platform's own question for discussion; it is not an IB examination question and has no official markscheme.
            </p>
          </div>
        </section>

        <section aria-labelledby="limits-h">
          <SectionHead no={7} title="The limits of the evidence" id="limits-h" dek="What the sources do not show, so that no one takes the analysis for more than it is." />
          <ul class="prose ib-limits">
            {it.limits.map((l) => <li set:html={inline(l)} />)}
          </ul>
        </section>

        <section aria-labelledby="sources-h">
          <SectionHead no={8} title="Sources" id="sources-h" dek="Every source was opened and read in full on the date shown. Each entry says which facts on this page it supports." />
          <ol class="ib-sources" role="list">
            {
              it.sources.map((s, i) => (
                <li id={`src-${s.id}`}>
                  <p class="label">
                    [{i + 1}] {SOURCE_KIND_LABELS[s.kind]} · {s.primary ? 'Primary source' : 'Secondary source'}
                  </p>
                  <h3 class="ib-sources__title">
                    <a href={s.url} rel="noopener">
                      {s.title}
                      <span class="sr-only"> (external site)</span>
                    </a>
                  </h3>
                  <dl class="ib-sources__meta">
                    <div>
                      <dt>Publisher</dt>
                      <dd>{s.publisher}</dd>
                    </div>
                    {s.author && (
                      <div>
                        <dt>Author</dt>
                        <dd>{s.author}</dd>
                      </div>
                    )}
                    <div>
                      <dt>Published</dt>
                      <dd>{s.published ? <time datetime={s.published}>{docDate(s)}</time> : docDate(s)}</dd>
                    </div>
                    <div>
                      <dt>Accessed</dt>
                      <dd>
                        <time datetime={s.accessed}>{formatDate(s.accessed)}</time>
                      </dd>
                    </div>
                  </dl>
                  <p class="ib-sources__url small">{s.url}</p>
                  <p class="label ib-sources__supports-h">Supports</p>
                  <ul class="small ib-sources__supports">
                    {s.supports.map((x) => <li set:html={inline(x)} />)}
                  </ul>
                  {s.undated && <p class="small muted">{s.undated}</p>}
                  {s.note && <p class="small muted">{s.note}</p>}
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="ib-doc__side" aria-label="About this item">
        <div class="ib-side">
          <dl class="ib-side__facts">
            <div>
              <dt>Development</dt>
              <dd><time datetime={it.date}>{formatDate(it.date)}</time></dd>
            </div>
            <div>
              <dt>Organizations</dt>
              <dd>{it.organizations.join(', ')}</dd>
            </div>
            <div>
              <dt>Kind</dt>
              <dd>{it.categories.map((k) => CATEGORY_LABELS[k]).join(', ')}</dd>
            </div>
            <div>
              <dt>Course</dt>
              <dd>{unitsLine}</dd>
            </div>
            <div>
              <dt>Key concepts</dt>
              <dd>{it.keyConcepts.map((k) => CONCEPT_NAMES[k]).join(', ')}</dd>
            </div>
          </dl>
          <nav class="ib-side__toc" aria-label="On this page">
            <p class="label">On this page</p>
            <ol role="list">
              {sections.map(([anchor, label]) => (
                <li>
                  <a href={`#${anchor}-h`}>{label}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
    </div>

    <nav class="ib-pager" aria-label="More from the briefing">
      {
        newer && items[newer] ? (
          <a class="ib-pager__link" href={briefingHref(newer)}>
            <span class="label">Newer item</span>
            <span class="ib-pager__title">{items[newer]?.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      <a class="ib-pager__link ib-pager__link--all" href="/intelligence/">
        <span class="label">The briefing</span>
        <span class="ib-pager__title">Every item, newest first</span>
      </a>
      {
        older && items[older] ? (
          <a class="ib-pager__link ib-pager__link--older" href={briefingHref(older)}>
            <span class="label">Older item</span>
            <span class="ib-pager__title">{items[older]?.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .ib-head {
    padding-block: var(--sp-5) var(--sp-6);
  }

  .ib-head__kicker {
    margin-top: var(--sp-5);
  }

  .ib-head__title {
    margin-top: var(--sp-3);
    max-width: 30ch;
    font-size: clamp(2.125rem, 1.6rem + 2.4vw, 3.5rem);
    line-height: var(--lh-tight);
    letter-spacing: -0.012em;
  }

  .ib-head__dek {
    margin-top: var(--sp-4);
    max-width: 46rem;
  }

  .ib-head__stamp {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: var(--sp-5) 0 0;
    padding: var(--sp-3) 0;
    list-style: none;
    border-top: 2px solid var(--rule-ink);
    border-bottom: 1px solid var(--rule-hair);
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }

  .ib-head__stamp li {
    margin: 0;
  }

  .ib-head__stamp .label {
    margin-right: 0.35rem;
  }

  .ib-head__notice {
    margin-top: var(--sp-3);
    max-width: 46rem;
    color: var(--text-muted);
  }

  .ib-head__figures {
    display: grid;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
  }

  @media (min-width: 48rem) {
    .ib-head__figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-6);
    }
  }

  .ib-head__figures > div {
    display: flex;
    flex-direction: column;
    padding-top: var(--sp-3);
    border-top: 3px solid var(--gold-500);
  }

  .ib-head__figures dd {
    order: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.5rem + 1.4vw, 2.75rem);
    line-height: 1.1;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .ib-head__figures dt {
    order: 2;
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    color: var(--text-body);
  }

  .ib-cite {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Document and side rail */
  .ib-doc {
    display: grid;
    gap: var(--sp-7);
  }

  @media (min-width: 66rem) {
    .ib-doc {
      grid-template-columns: minmax(0, 1fr) 17rem;
      column-gap: var(--sp-8);
      align-items: start;
    }
  }

  .ib-doc__main > * + * {
    margin-top: clamp(var(--sp-6), 5vw, var(--sp-8));
  }

  .ib-doc__side {
    order: -1;
  }

  @media (min-width: 66rem) {
    .ib-doc__side {
      order: 0;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-4));
    }
  }

  .ib-side {
    padding: var(--sp-4);
    border: 1px solid var(--rule-hair);
    border-top: 3px solid var(--rule-ink);
    background: var(--surface-sheet);
    font-size: var(--fs-small);
  }

  .ib-side__facts {
    display: grid;
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
  }

  @media (max-width: 65.99rem) {
    .ib-side__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ib-side__facts dt,
  .ib-sources__meta dt {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ib-side__facts dd,
  .ib-sources__meta dd {
    margin: 0.1rem 0 0;
    color: var(--text-strong);
  }

  .ib-side__toc {
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule-hair);
  }

  @media (max-width: 65.99rem) {
    .ib-side__toc {
      display: none;
    }
  }

  .ib-side__toc ol {
    margin: var(--sp-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .ib-side__toc li + li {
    margin-top: 0.15rem;
  }

  .ib-side__toc a {
    display: inline-block;
    padding-block: 0.2rem;
    min-height: 24px;
  }

  /* Lists laid out as grids and rows take no margin from the site's li + li rule. */
  .ib-head__stamp li,
  .ib-facts > li,
  .ib-concepts li,
  .ib-chips li,
  .ib-tools li,
  .ib-choices > li,
  .ib-sources > li {
    margin: 0;
  }

  /* Facts */
  .ib-provenance {
    margin-top: var(--sp-4);
  }

  .ib-facts {
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-ink);
  }

  .ib-fact {
    display: grid;
    gap: var(--sp-1) var(--sp-5);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  @media (min-width: 40rem) {
    .ib-fact {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
  }

  .ib-fact__date {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--brass-text);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .ib-fact__text {
    max-width: var(--text-max);
    color: var(--text-strong);
  }

  .ib-fact__src {
    margin-top: var(--sp-2);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .ib-since__h {
    margin-top: var(--sp-6);
    font-size: var(--fs-h4);
  }

  /* The analysis divider */
  .ib-analysis-mark {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    border-left: 3px solid var(--gold-500);
    background: var(--surface-gold-wash);
  }

  .ib-analysis-mark p {
    max-width: 44rem;
    color: var(--text-body);
  }

  .ib-analysis-mark .tag {
    justify-self: start;
  }

  .ib-prose {
    margin-top: var(--sp-4);
  }

  /* Concepts */
  .ib-concepts {
    display: grid;
    gap: 0 var(--sp-6);
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-ink);
  }

  @media (min-width: 48rem) {
    .ib-concepts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ib-concepts li {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

