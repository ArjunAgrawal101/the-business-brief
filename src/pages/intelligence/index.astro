---
/**
 * The Business Intelligence Briefing: real business developments, curated by
 * hand and read through the ideas of the course, laid out as an issue of a
 * business publication; the span of dates the copy states is computed from
 * the items themselves. The front page carries a lead
 * story and the rest of the issue; the themes, each a page of its own so
 * they work without JavaScript; every item in date order, with filters by
 * unit, key concept and theme; the six questions every item answers; how the
 * briefing is made; and the documents behind it. Without JavaScript every
 * item is listed and the filters are not shown; the filters only hide what
 * the reader asks them to.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import ProvenanceTag from '../../components/ui/ProvenanceTag.astro';
import { briefing, briefingHref } from '../../lib/briefing-content';
import {
  CATEGORY_LABELS,
  SOURCE_KIND_LABELS,
  THEME_INFO,
  dateParts,
  developmentSpan,
  facetsOf,
  filterSummary,
  formatDate,
  inTheme,
  isEditorialTheme,
  itemCount,
  latest,
  regionsLine,
  themeHref,
} from '../../lib/briefing';
import { corpus } from '../../lib/content';
import { CONCEPT_NAMES } from '../../lib/labels';
import { INTEL_CATEGORIES, INTEL_THEMES, type IntelSource } from '../../lib/schemas';
import '../../styles/intelligence.css';

const items = await briefing();
const c = await corpus();
const lead = items.find(([, it]) => it.lead);
// The rest of the issue on the front page: the newest items after the lead.
const stories = items.filter(([, it]) => !it.lead).slice(0, 6);
const curated = latest(items.map(([, it]) => it.written)) ?? '';
// "from February 2025 to October 2026": the span of the items' own dates, never typed.
const span = developmentSpan(items.map(([, it]) => it.date));
const newestCheck = latest(items.map(([, it]) => it.checked)) ?? '';
const units = c.curricula['ib-dp-bm']?.units ?? [];

// The documents behind the edition: one entry per address, with the items that cite it.
const documents = new Map<string, { s: IntelSource; items: Array<{ id: string; title: string }> }>();
for (const [id, it] of items) {
  for (const s of it.sources) {
    const d = documents.get(s.url) ?? { s, items: [] };
    if (!d.items.some((x) => x.id === id)) d.items.push({ id, title: it.title });
    documents.set(s.url, d);
  }
}
const docs = [...documents.values()].sort((a, b) => a.s.publisher.localeCompare(b.s.publisher) || (b.s.published ?? '').localeCompare(a.s.published ?? ''));
const citations = items.reduce((n, [, it]) => n + it.sources.length, 0);
const primaryDocs = docs.filter((d) => d.s.primary).length;
const usedKinds = INTEL_CATEGORIES.filter((k) => items.some(([, it]) => it.categories.includes(k)));
// The twelve editorial themes are the sections; the first edition's other kinds are listed after them.
const themes = [...INTEL_THEMES];
const otherKinds = usedKinds.filter((k) => !isEditorialTheme(k));
const usedUnits = units.filter((u) => items.some(([, it]) => facetsOf(it).units.includes(String(u.number))));
const anyTools = items.some(([, it]) => it.concepts.tools.length > 0);
const regions = new Set(items.flatMap(([, it]) => it.regions));
const docDate = (s: IntelSource) => (s.published ? formatDate(s.published) : 'Undated page');
const kindsLine = (cats: string[]) => cats.map((k) => CATEGORY_LABELS[k as keyof typeof CATEGORY_LABELS]).join(' · ');
const unitsLine = (us: string[]) => us.map((u) => (u === 'toolkit' ? 'Toolkit' : `Unit ${u}`)).join(', ');
const SIX = [
  ['What happened?', 'The development and what followed, as dated facts, each traced to the document that states it.', 'external-evidence'],
  ['What is the business context?', 'The organization, its industry and the position it was in when it acted.', 'analysis'],
  ['Which management concepts are relevant?', 'The IB subtopics, terms, tools and frameworks at work, with what lies beyond the course labelled apart.', 'analysis'],
  ['What choices did the organization face?', 'The realistic options, the case for and against each, and the one it took where the facts show it.', 'analysis'],
  ['What were the implications?', 'What followed, or may follow, for the organization, its stakeholders and its industry.', 'analysis'],
  ['What can a student or manager learn?', 'Lessons that travel to other businesses, a discussion question of the platform’s own, and the limits of the evidence.', 'analysis'],
] as const;
---

<BaseLayout
  title="Business Intelligence Briefing"
  description={`Real business developments ${span}, curated by hand, dated and sourced to the organizations' own documents, filed under twelve themes and read through the ideas of IB Business Management and beyond.`}
  section="intelligence"
>
  <div class="wrap">
    <header class="ib-mast">
      <Breadcrumbs trail={[{ label: 'Business Intelligence Briefing' }]} />
      <div class="ib-mast__grid">
        <div>
          <p class="label label--ink ib-mast__kicker">The Business Brief · A curated briefing</p>
          <h1 class="ib-mast__title">The Business Intelligence <em>Briefing</em></h1>
          <ul class="ib-issue" role="list" aria-label="This edition">
            <li>Edition of <time datetime={curated}>{formatDate(curated)}</time></li>
            <li>{itemCount(items.length)}</li>
            <li>{themes.length} themes</li>
            <li>{regions.size} {regions.size === 1 ? 'region' : 'regions'}</li>
          </ul>
          <p class="lead ib-mast__lead">
            Real business developments {span}, read through the ideas of the course. Each item answers six questions in order: what happened, the business context, the management concepts that apply, the choices the organization faced, the implications, and what a student or manager can learn. Every fact is dated and traced to the document that states it; everything after the facts is labelled as analysis.
          </p>
        </div>
        <nav class="ib-contents" aria-label="In this edition">
          <p class="label label--ink">In this edition</p>
          <ol role="list">
            {
              items.map(([id, it]) => (
                <li>
                  <a href={briefingHref(id)}>{it.title}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
      <dl class="ib-stamp">
        <div>
          <dt>Curated</dt>
          <dd><time datetime={curated}>{formatDate(curated)}</time></dd>
        </div>
        <div>
          <dt>Newest check</dt>
          <dd><time datetime={newestCheck}>{formatDate(newestCheck)}</time></dd>
        </div>
        <div>
          <dt>Items</dt>
          <dd>{itemCount(items.length)}</dd>
        </div>
        <div>
          <dt>Sources</dt>
          <dd>{docs.length} documents, {primaryDocs === docs.length ? 'all' : primaryDocs} primary</dd>
        </div>
      </dl>
      <p class="ib-notice">
        <strong>A curated briefing, not a news feed.</strong> Every item was published and checked on the dates it shows, and nothing here updates by itself. Businesses move on, so an item can become outdated after its check date; read it as an account of what was true then.
      </p>
    </header>
  </div>

  <div class="wrap page-body">
    <div class="ib-front">
      {
        lead && (
          <section class="ib-lead" aria-labelledby="lead-title">
            <article class="ib-lead__card">
              <div class="ib-lead__text">
                <p class="label ib-lead__kicker">
                  <span class="ib-lead__flag">Lead story</span> · {kindsLine(lead[1].categories)} · <time datetime={lead[1].date}>{formatDate(lead[1].date)}</time>
                </p>
                <h2 class="ib-lead__title" id="lead-title">
                  <a href={briefingHref(lead[0])}>{lead[1].title}</a>
                </h2>
                <p class="ib-lead__dek">{lead[1].dek}</p>
                <p class="ib-lead__meta small">
                  {lead[1].organizations.join(', ')} · {regionsLine(lead[1].regions)} · {lead[1].industry} · {unitsLine(facetsOf(lead[1]).units)}
                </p>
                <ul class="ib-dates" role="list">
                  <li><span class="label">Published</span><time datetime={lead[1].written}>{formatDate(lead[1].written)}</time></li>
                  <li><span class="label">Checked</span><time datetime={lead[1].checked}>{formatDate(lead[1].checked)}</time></li>
                </ul>
                <p>
                  <a class="btn btn--gold" href={briefingHref(lead[0])}>
                    Read the briefing<span class="sr-only">: {lead[1].title}</span>
                  </a>
                </p>
              </div>
              {
                lead[1].figures.length > 0 && (
                  <dl class="ib-figures ib-figures--lead" aria-label="Headline figures, from the sources">
                    {lead[1].figures.map((g) => (
                      <div>
                        <dt>{g.label}</dt>
                        <dd>{g.value}</dd>
                      </div>
                    ))}
                  </dl>
                )
              }
            </article>
          </section>
        )
      }

      {
        stories.length > 0 && (
          <section aria-labelledby="issue-h">
            <h2 class="sr-only" id="issue-h">Also in this edition</h2>
            <ul class="ib-stories" role="list">
              {stories.map(([id, it]) => (
                <li class="ib-story">
                  <p class="label">
                    {kindsLine(it.categories)} · <time datetime={it.date}>{formatDate(it.date)}</time>
                  </p>
                  <h3 class="ib-story__title">
                    <a href={briefingHref(id)}>{it.title}</a>
                  </h3>
                  <p class="ib-story__dek">{it.dek}</p>
                  <p class="ib-row__where">
                    {it.organizations.join(', ')} · {regionsLine(it.regions)} · {it.industry}
                  </p>
                  <ul class="ib-dates" role="list">
                    <li><span class="label">Published</span><time datetime={it.written}>{formatDate(it.written)}</time></li>
                    <li><span class="label">Checked</span><time datetime={it.checked}>{formatDate(it.checked)}</time></li>
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <section aria-labelledby="themes-h" id="themes">
      <SectionHead no={1} title="The themes" id="themes-h" dek="Every item is filed under one or more themes. Each theme is a page of its own, with its items newest first." />
      <ul class="ib-themes" role="list">
        {
          themes.map((k) => {
            const list = inTheme(items, k);
            return (
              <li class="ib-theme">
                <h3 class="ib-theme__name">
                  <a href={themeHref(k)}>{THEME_INFO[k].label}</a>
                  <span class="ib-theme__count">{itemCount(list.length)}</span>
                </h3>
                <p class="ib-theme__dek">{THEME_INFO[k].dek}</p>
                {list.length > 0 && (
                  <ul class="ib-theme__latest" role="list">
                    {list.slice(0, 2).map(([id, it]) => (
                      <li>
                        <a href={briefingHref(id)}>{it.title}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
      {
        otherKinds.length > 0 && (
          <p class="small ib-themes__more">
            Also filed under{' '}
            {otherKinds.map((k, i) => (
              <>
                {i > 0 ? ' and ' : ''}
                <a href={themeHref(k)}>{THEME_INFO[k].label}</a> ({itemCount(inTheme(items, k).length)})
              </>
            ))}
            , kinds of development kept from the first edition.
          </p>
        )
      }
    </section>

    <section aria-labelledby="list-h" data-ix="briefing">
      <SectionHead no={2} title="Every item, newest first" id="list-h" dek="Each development is dated by its headline fact, and each item shows when it was published and when its sources were checked. Filter the list by unit, by the IB's key concepts or by theme." />

      <div class="ib-filters js-only" role="group" aria-label="Filter the briefing">
        <div class="ib-filter">
          <label class="label" for="ib-unit">Unit</label>
          <select id="ib-unit" data-filter="unit">
            <option value="">All units</option>
            {usedUnits.map((u) => <option value={String(u.number)}>Unit {u.number}: {u.title}</option>)}
            {anyTools && <option value="toolkit">Toolkit</option>}
          </select>
        </div>
        <div class="ib-filter">
          <label class="label" for="ib-concept">Key concept</label>
          <select id="ib-concept" data-filter="concept">
            <option value="">All key concepts</option>
            {Object.entries(CONCEPT_NAMES).map(([k, name]) => items.some(([, it]) => it.keyConcepts.includes(k as keyof typeof CONCEPT_NAMES)) && <option value={k}>{name}</option>)}
          </select>
        </div>
        <div class="ib-filter">
          <label class="label" for="ib-kind">Theme</label>
          <select id="ib-kind" data-filter="kind">
            <option value="">Every theme</option>
            {usedKinds.map((k) => <option value={k}>{CATEGORY_LABELS[k]}</option>)}
          </select>
        </div>
        <button class="btn btn--small ib-filters__reset" type="button" data-reset hidden>Clear filters</button>
        <p class="ib-count" aria-live="polite" data-count>{filterSummary(items.length, items.length)}</p>
      </div>
      <p class="state state--error" data-error hidden>The filters could not start. Every item is still listed below.</p>

      <ol class="ib-list" role="list">
        {
          items.map(([id, it]) => {
            const f = facetsOf(it);
            const d = dateParts(it.date);
            return (
              <li class="ib-row" data-item data-units={f.units.join(' ')} data-concepts={f.concepts.join(' ')} data-kinds={f.categories.join(' ')}>
                <p class="ib-row__date">
                  <time datetime={it.date}>
                    {d.day ? <span class="ib-row__day">{d.day}</span> : <span class="ib-row__day">{d.month}</span>}
                    {d.day && <span class="ib-row__month">{d.month}</span>}
                    <span class="ib-row__year">{d.year}</span>
                  </time>
                </p>
                <div class="ib-row__body">
                  <p class="label">
                    {kindsLine(it.categories)}
                    {it.lead && <span class="ib-row__lead"> · Lead story</span>}
                  </p>
                  <h3 class="ib-row__title">
                    <a href={briefingHref(id)}>{it.title}</a>
                  </h3>
                  <p class="ib-row__dek">{it.dek}</p>
                  <ul class="ib-dates" role="list">
                    <li><span class="label">Published</span><time datetime={it.written}>{formatDate(it.written)}</time></li>
                    <li><span class="label">Checked</span><time datetime={it.checked}>{formatDate(it.checked)}</time></li>
                  </ul>
                </div>
                <dl class="ib-row__side">
                  <div>
                    <dt>Organizations</dt>
                    <dd>{it.organizations.join(', ')}</dd>
                  </div>
                  <div>
                    <dt>Where</dt>
                    <dd>
                      {regionsLine(it.regions)} · {it.industry}
                    </dd>
                  </div>
                  <div>
                    <dt>Course</dt>
                    <dd>{unitsLine(f.units)}</dd>
                  </div>
                  <div>
                    <dt>Key concepts</dt>
                    <dd>{it.keyConcepts.map((k) => CONCEPT_NAMES[k]).join(', ')}</dd>
                  </div>
                  <div>
                    <dt>Sources</dt>
                    <dd>
                      {it.sources.length} {it.sources.length === 1 ? 'source' : 'sources'}, {it.sources.every((s) => s.primary) ? 'all primary' : `${it.sources.filter((s) => s.primary).length} primary`}
                    </dd>
                  </div>
                </dl>
              </li>
            );
          })
        }
      </ol>
      <div class="state ib-none" data-none hidden>
        <p>No item matches all of these filters. Try fewer filters, or clear them to see the whole briefing.</p>
        <button class="btn btn--small" type="button" data-reset>Clear filters</button>
      </div>
    </section>

    <section aria-labelledby="six-h">
      <SectionHead no={3} title="Six questions, in order" id="six-h" dek="Every item answers the same six questions, so that items can be compared and a reader always knows where the facts end and the analysis begins." />
      <ol class="ib-six" role="list">
        {
          SIX.map(([q, text, kind]) => (
            <li>
              <div>
                <h3>{q}</h3>
                <p>{text}</p>
                {kind === 'external-evidence' ? <ProvenanceTag kind="external-evidence" /> : <span class="tag tag--framework">The Business Brief's analysis</span>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="method-h">
      <SectionHead no={4} title="How this briefing is made" id="method-h" dek="The rules every item follows. The build checks them, and fails if any item breaks one." />
      <div class="ib-rules">
        <div>
          <h3>Curated, not live</h3>
          <p>Items are chosen by hand for what they teach, not for how recent they are. Each shows when it was published and when its sources were last checked. Nothing changes after that unless the item is checked again and its dates move.</p>
        </div>
        <div>
          <h3>Traced to the document</h3>
          <p>Every fact names the source that states it, and every source was opened and read on its access date. A development is included only when its primary sources could be read: fewer items, rather than weaker ones.</p>
        </div>
        <div>
          <h3>Facts apart from analysis</h3>
          <p>"What happened?" holds only sourced facts. Everything after it, from the business context to the lessons, is the platform's analysis and is labelled as such. Quotations are avoided; facts are given in the platform's own words.</p>
        </div>
        <div>
          <h3>Primary sources first</h3>
          <p>The sources are the organizations' own releases, reports and annual reports. They are authoritative on what a business did and said, and partial on why. Each item ends with the limits of its evidence.</p>
        </div>
        <div>
          <h3>The course, and beyond it</h3>
          <p>Each item links to the IB subtopics, terms, toolkit tools and frameworks it illustrates. Ideas beyond the IB course, for undergraduate, MBA and professional readers, are shown apart and labelled as enrichment.</p>
        </div>
        <div>
          <h3>Every theme covered</h3>
          <p>The briefing covers all twelve themes, from corporate strategy to industry developments, and the build fails if a theme is left without an item.</p>
        </div>
        <div>
          <h3>Dated as precisely as the source</h3>
          <p>A fact carries the date its source gives. When a source names only a month, so does the item. Facts read from a live page with no date are marked as at the day the page was read, and no fact is dated later than every source it cites.</p>
        </div>
        <div>
          <h3>A question of our own</h3>
          <p>Each item ends with a discussion question written for the platform. It is not an IB examination question, and it has no official markscheme.</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="docs-h">
      <SectionHead no={5} title="The documents behind this edition" id="docs-h" dek={`${docs.length} documents, cited ${citations} times across ${itemCount(items.length)}. Each was read on the date shown.`} />
      <ul class="ib-docs" role="list">
        {
          docs.map(({ s, items: used }) => (
            <li>
              <p class="label">
                {s.publisher} · {SOURCE_KIND_LABELS[s.kind]} · {docDate(s)}
              </p>
              <p class="ib-docs__title">
                <a href={s.url} rel="noopener">
                  {s.title}
                  <span class="sr-only"> (external site)</span>
                </a>
              </p>
              <p class="small muted">
                Read {formatDate(s.accessed)}. Cited in: {used.map((u, i) => <>{i > 0 ? '; ' : ''}<a href={briefingHref(u.id)}>{u.title}</a></>)}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../scripts/briefing';
</script>
