---
/**
 * The home page, in the order the 2.0 brief sets out:
 *  1. the platform and what it is for, with this week's brief beside it;
 *  2. the way of thinking every page practises;
 *  3. the whole IB course, unit by unit, one click from any subtopic;
 *  4. the case of the week;
 *  5. the strategic decision of the week;
 *  6. the financial analysis laboratory, live, with the week's challenge;
 *  7. frameworks and management tools, by the question each answers;
 *  8. the Assessment Centre;
 *  9. the interactive learning environments;
 * 10. mindmaps, diagrams and the glossary;
 * 11. business intelligence: the newest sourced items;
 * 12. the creator, and tutoring;
 * 13. routes through the platform and the other two platforms;
 * then the footer.
 *
 * Every figure is counted from the content. The weekly features are the
 * platform's own material: the build week's shows by default and the
 * reader's own ISO week chooses in the browser (src/scripts/home.ts). The
 * cases, decisions and figures are fictional and labelled; the intelligence
 * items are real, dated and sourced.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CreatorPhoto from '../components/brand/CreatorPhoto.astro';
import BreakEvenPreview from '../components/home/BreakEvenPreview.astro';
import { corpus, href, modulesInOrder, pathwaysInOrder } from '../lib/content';
import { curriculumOf, subtopicCoverage } from '../lib/coverage';
import { subtopicHref } from '../lib/learning';
import { DIAGRAMS } from '../lib/diagrams';
import { renderThumb } from '../lib/mindmap';
import { CHALLENGES, FRAMEWORKS, INSIGHTS, isoWeek } from '../lib/home';
import { calendarDate, caseOfTheWeek, rotationOrder } from '../lib/case-vault';
import { buildBank } from '../lib/bank-build';
import { isEnrichment } from '../lib/glossary';
import { library as frameworkLibrary } from '../lib/frameworks-content';
import { frameworkHref, grouped } from '../lib/frameworks';
import { briefing, briefingHref } from '../lib/briefing-content';
import { formatDate } from '../lib/briefing';
import { ECOSYSTEM } from '../lib/ecosystem';
import { SESSION as TUTOR_SESSION } from '../lib/tutorials';

const c = await corpus();
const cur = curriculumOf(c);
const coverage = subtopicCoverage(c);
const bankSize = buildBank(c).items.length;
const ibTerms = Object.values(c.glossary).filter((g) => !isEnrichment(g)).length;
const maps = Object.entries(c.mindmaps).sort((a, b) => a[1].order - b[1].order);
const fw = (await frameworkLibrary()).frameworks;
const fwGroups = grouped(fw).filter((g) => g.items.length);
const fwCount = Object.keys(fw).length;
const news = (await briefing()).slice(0, 3);
const pathways = await pathwaysInOrder();
const modules = (await modulesInOrder()).map((m) => ({ id: m.id, ...m.data }));
const comps = Object.entries(c.assessment).sort((a, b) => a[1].order - b[1].order);

/* ---------- The weekly features: the platform's own material, rotating by week ---------- */
const week = isoWeek(new Date());
const pick = (n: number) => (n ? week % n : 0);
// The case of the week is the Case Vault's own, from the same rotation, so the two pages always agree.
const caseOrder = rotationOrder(Object.keys(c.cases));
const cases = caseOrder.map((id) => [id, c.cases[id]!] as const);
const casePick = caseOfTheWeek(caseOrder, calendarDate(new Date()))?.position ?? 0;
const decisions = Object.entries(c.decisions).sort((a, b) => a[0].localeCompare(b[0]));
const featuredFw = FRAMEWORKS.filter((f) => c.tools[f.tool]?.status === 'complete' && DIAGRAMS[f.diagram]);

/* ---------- The three chains of reasoning ---------- */
const METHODS = [
  {
    name: 'Decide',
    steps: ['Situation', 'Decision', 'Consequence'],
    text: 'Commit to a choice, then follow what it does to the business and to the people in it.',
    where: { label: 'The Decision Room', href: '/decision-room/' },
  },
  {
    name: 'Analyse',
    steps: ['Data', 'Insight', 'Option', 'Recommendation'],
    text: 'From the evidence to a recommendation you can defend, one supported step at a time.',
    where: { label: 'The Case Vault', href: '/case-vault/' },
  },
  {
    name: 'Diagnose',
    steps: ['Problem', 'Cause', 'Strategy', 'Implementation', 'Evaluation'],
    text: 'Find the cause before choosing the cure, then say how you would know it worked.',
    where: { label: 'The Case Room lab', href: '/case-room/halden-diagnosis/' },
  },
];

/* ---------- The learning environments, in the order a learner meets them ---------- */
const ENV_IDS = ['case-room', 'decision-room', 'boardroom', 'finance-desk', 'strategy-studio', 'market-studio', 'people-and-culture', 'operations-floor', 'entrepreneurship-lab'];
const ENV_LINE: Record<string, string> = {
  'case-room': 'Diagnose a business stage by stage, against its evidence.',
  'decision-room': 'Commit to a decision and live with its consequences.',
  boardroom: 'Board simulations over several rounds, and a company to run for three years.',
  'finance-desk': 'Costs, break-even, cash flow, ratios and investment appraisal, with the working.',
  'strategy-studio': 'SWOT, STEEPLE, five forces, Ansoff, BCG, decision trees and scenarios.',
  'market-studio': 'Segments, personas, positioning, the marketing mix and campaigns.',
  'people-and-culture': 'Motivation, leadership, structure, workforce and change.',
  'operations-floor': 'Production methods, location, capacity and stock control.',
  'entrepreneurship-lab': 'From an idea to a tested business model and a plan.',
};
const envs = ENV_IDS.map((id) => modules.find((m) => m.id === id)).filter((m): m is NonNullable<typeof m> => Boolean(m && m.href));

/* ---------- Visual learning: three maps from different units ---------- */
const MAP_PICK = ['2.4', '3.7', '4.5'];
const showMaps = MAP_PICK.map((code) => maps.find(([, m]) => m.code === code)).filter((x): x is (typeof maps)[number] => Boolean(x));
const HOME_DIAGRAMS = ['break-even-chart', 'bcg-matrix', 'maslow-hierarchy'].filter((d) => DIAGRAMS[d]);

const ASSESS_HREF: Record<string, string> = {
  'internal-assessment': '/assessment/internal-assessment/',
  'paper-1': '/assessment/paper-1/',
  'paper-2': '/assessment/paper-2/',
  'paper-3': '/assessment/paper-3/',
};
/** "SL and HL; SL 1 hour 30 minutes, 30 marks; HL 1 hour 30 minutes, 30 marks". */
const metaOf = (a: (typeof comps)[number][1]) =>
  [a.levels, a.outline?.sl && `SL ${a.outline.sl.duration}, ${a.outline.sl.marks} marks`, a.outline?.hl && `HL ${a.outline.hl.duration}, ${a.outline.hl.marks} marks`]
    .filter(Boolean)
    .join('; ');
const weights = (level: 'sl' | 'hl') => comps.map(([id, a]) => ({ id, name: a.short, w: a.outline?.[level]?.weight ?? 0 })).filter((x) => x.w > 0);

const sisters = ECOSYSTEM.filter((p) => !p.current);
const plural = (n: number, one: string, many: string) => `${n.toLocaleString('en-GB')} ${n === 1 ? one : many}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Arjun Agrawal | The Business Brief',
  alternateName: 'The Business Brief',
  description: 'Strategy. Leadership. Decisions. An IB Diploma Programme Business Management learning platform by Arjun Agrawal.',
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: 'Arjun Agrawal' },
  ...(Astro.site ? { url: Astro.site.href, potentialAction: { '@type': 'SearchAction', target: `${new URL('/search/', Astro.site).href}?q={query}`, 'query-input': 'required name=query' } } : {}),
};
---

<BaseLayout
  title="home"
  description="The Business Brief by Arjun Agrawal: IB Diploma Programme Business Management for SL and HL, learned through evidence, strategic judgement and decisions, with notes for every subtopic, cases, live financial tools and an Assessment Centre."
  jsonLd={jsonLd}
>
  <!-- 1. The platform, and this week's brief -->
  <section class="hx" aria-labelledby="hx-h" data-rotate-root data-build-week={week}>
    <div class="wrap hx__grid">
      <div class="hx__copy enter">
        <p class="hx__kicker">IB Diploma Programme Business Management <span aria-hidden="true">·</span> SL and HL</p>
        <h1 id="hx-h" class="hx__title">The Business Brief</h1>
        <p class="hx__tagline">Strategy. Leadership. Decisions.</p>
        <p class="hx__lead">
          Business is learned here the way it is practised: read the evidence, weigh the options, make a decision you can defend, and follow its
          consequences through.
        </p>
        <form class="hx__search" action="/search/" method="get" role="search">
          <label class="sr-only" for="hx-q">Search the platform</label>
          <input id="hx-q" name="q" type="search" autocomplete="off" placeholder="Search topics, frameworks, terms" />
          <button class="btn btn--primary" type="submit">Search</button>
        </form>
        <p class="hx__actions">
          <a class="btn btn--primary" href="/topics/">Explore the topic library <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
          <a class="btn" href="/assessment/">Enter the Assessment Centre</a>
        </p>
      </div>

      <aside class="hx__issue enter" aria-labelledby="hx-issue-h">
        <p class="hx__issue-head">
          <span id="hx-issue-h" class="hx__issue-k">In this week's brief</span>
          <span class="hx__issue-week" data-week-label>Week {week}</span>
        </p>
        <ol class="hx__issue-list" role="list">
          <li data-rotate={cases.length} data-rotate-by="vault">
            {
              cases.map(([id, cs], i) => (
                <a class="hx__item" href="#case-of-the-week" data-variant={i} data-id={id} hidden={i !== casePick}>
                  <span class="hx__item-k">Case of the week</span>
                  <span class="hx__item-t">{cs.title}</span>
                </a>
              ))
            }
          </li>
          <li data-rotate={decisions.length}>
            {
              decisions.map(([, d], i) => (
                <a class="hx__item" href="#decision-of-the-week" data-variant={i} hidden={i !== pick(decisions.length)}>
                  <span class="hx__item-k">Strategic decision</span>
                  <span class="hx__item-t">{d.title}</span>
                </a>
              ))
            }
          </li>
          <li data-rotate={CHALLENGES.length}>
            {
              CHALLENGES.map((ch, i) => (
                <a class="hx__item" href="#financial-laboratory" data-variant={i} hidden={i !== pick(CHALLENGES.length)}>
                  <span class="hx__item-k">Financial challenge</span>
                  <span class="hx__item-t">{ch.title}</span>
                </a>
              ))
            }
          </li>
          <li data-rotate={INSIGHTS.length}>
            {
              INSIGHTS.map((ins, i) => (
                <a class="hx__item" href={ins.href} data-variant={i} hidden={i !== pick(INSIGHTS.length)}>
                  <span class="hx__item-k">Management concept, {ins.code}</span>
                  <span class="hx__item-t">{ins.title}</span>
                </a>
              ))
            }
          </li>
          {
            news[0] && (
              <li>
                <a class="hx__item" href={briefingHref(news[0][0])}>
                  <span class="hx__item-k">
                    Business in the news, <time datetime={news[0][1].date}>{formatDate(news[0][1].date)}</time>
                  </span>
                  <span class="hx__item-t">{news[0][1].title}</span>
                </a>
              </li>
            )
          }
        </ol>
        <p class="hx__issue-note">The cases, decisions and figures are fictional, written for learning. The news is real, dated and sourced.</p>
      </aside>
    </div>

    <div class="wrap">
      <ul class="hx__facts" role="list" aria-label="What the platform holds">
        <li><a href="/topics/"><b>{coverage.length}</b> subtopics in five units</a></li>
        <li><a href="/assessment/question-bank/"><b>{bankSize.toLocaleString('en-GB')}</b> original practice questions</a></li>
        <li><a href="/glossary/"><b>{ibTerms.toLocaleString('en-GB')}</b> IB terms defined</a></li>
        <li><a href="/frameworks/"><b>{fwCount}</b> frameworks</a></li>
        <li><a href="/mindmaps/"><b>{maps.length}</b> mindmaps</a></li>
      </ul>
    </div>
  </section>

  <!-- 2. The way of thinking -->
  <section class="hp" aria-labelledby="hp-h">
    <div class="wrap hp__grid">
      <div class="hp__intro">
        <p class="hk hk--ink">The Business Brief philosophy</p>
        <h2 id="hp-h" class="hp__title">Every page ends in a decision.</h2>
        <p class="hp__lead">
          Definitions matter, but they are where the work starts. Three chains of reasoning run through every topic, case and tool, until weighing
          evidence and judging a course of action become habits.
        </p>
      </div>
      <ol class="hp__chains" role="list">
        {
          METHODS.map((m) => (
            <li class="hp__chain">
              <p class="hp__name">{m.name}</p>
              <ol class="hp__steps" aria-label={`${m.name}: ${m.steps.join(', then ')}`}>
                {m.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
              <p class="hp__text">
                {m.text} <a href={m.where.href}>{m.where.label}</a>
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. The course -->
  <section class="hc band band--white" aria-labelledby="hc-h">
    <div class="wrap">
      <div class="hhead">
        <p class="hk">The IB Business Management course</p>
        <h2 id="hc-h" class="hhead__title">Every subtopic, one click away</h2>
        <p class="hhead__dek">
          All {coverage.length} subtopics of the course in its five units, each with full notes, a mindmap, key terms and practice. HL-only subtopics are
          marked.
        </p>
      </div>
      <ol class="hc__units" role="list" data-reveal="group">
        {
          cur.units.map((u) => {
            const subs = coverage.filter((s) => s.unit.id === u.id);
            return (
              <li class="hc__unit">
                <div class="hc__head">
                  <span class="hc__no" aria-hidden="true">
                    {u.number}
                  </span>
                  <h3 class="hc__name">
                    <a href={`/topics/#unit-${u.number}`}>
                      <span class="sr-only">Unit {u.number}: </span>
                      {u.title}
                    </a>
                  </h3>
                  {u.hours && <p class="hc__hours">{u.hours.sl === u.hours.hl ? `${u.hours.sl} teaching hours` : `${u.hours.sl} hours SL, ${u.hours.hl} HL`}</p>}
                </div>
                <ul class="hc__subs" role="list">
                  {subs.map((s) => (
                    <li>
                      <a href={subtopicHref(c, s.subtopic.code)}>
                        <span class="hc__code">{s.subtopic.code}</span>
                        <span class="hc__t">
                          {s.subtopic.title}
                          {s.subtopic.level === 'HL' && <span class="tag tag--hl">HL</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ol>
      <p class="hmore">
        <a class="btn" href="/topics/">The topic library <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/ib/connections/">How the subtopics connect</a>
        <a href="/revision/">A revision sheet for every subtopic</a>
        <a href="/revision/flashcards/">The course as flashcards</a>
        <a href="/ib/map/">The course map, statement by statement</a>
      </p>
    </div>
  </section>

  <!-- 4. Case of the week -->
  <section class="hcase band" id="case-of-the-week" aria-label="Case of the week" data-rotate-root>
    <div class="wrap">
      <div data-rotate={cases.length} data-rotate-by="vault">
        {
          cases.map(([id, cs], i) => (
            <article class="hcase__grid" data-variant={i} data-id={id} hidden={i !== casePick}>
              <div class="hcase__text">
                <p class="hk">
                  Case of the week <span class="tag tag--simulated">Fictional</span>
                </p>
                <h2 class="hcase__title">
                  {cs.title}
                </h2>
                <p class="hcase__q">{cs.decision}</p>
                <p class="hcase__dek">{cs.dek}</p>
                <p class="hcase__actions">
                  <a class="btn btn--primary" href={href.case(id)}>
                    Open the case file <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                  </a>
                  <a href="/case-vault/">Every case in the Case Vault</a>
                </p>
              </div>
              <dl class="hcase__file">
                <div>
                  <dt>Organization</dt>
                  <dd>{cs.organization.name}</dd>
                </div>
                <div>
                  <dt>Sector</dt>
                  <dd>{cs.organization.sector}</dd>
                </div>
                <div>
                  <dt>Location</dt>
                  <dd>{cs.organization.location}</dd>
                </div>
                <div>
                  <dt>Size</dt>
                  <dd>{cs.organization.size}</dd>
                </div>
                <div>
                  <dt>In the file</dt>
                  <dd>
                    {plural(cs.exhibits.length, 'exhibit', 'exhibits')}, {plural(cs.stakeholders.length, 'stakeholder', 'stakeholders')},{' '}
                    {plural(cs.options.length, 'option', 'options')}
                  </dd>
                </div>
                <div>
                  <dt>Data</dt>
                  <dd>{cs.dataStatus === 'simulated' ? 'Simulated figures that add up' : cs.dataStatus === 'real' ? 'Real, sourced figures' : 'Real and simulated figures, each marked'}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. Strategic decision challenge -->
  <section class="hdec band band--white" id="decision-of-the-week" aria-label="Strategic decision challenge" data-rotate-root>
    <div class="wrap hdec__wrap" data-rotate={decisions.length}>
      {
        decisions.map(([id, d], i) => (
          <article class="hdec__item" data-variant={i} hidden={i !== pick(decisions.length)}>
            <p class="hk">
              Strategic decision challenge <span class="tag tag--simulated">Fictional</span>
            </p>
            <h2 class="hdec__title">
              {d.title}
            </h2>
            <p class="hdec__dek">{d.dek}</p>
            <ol class="hdec__flow" role="list" aria-label="How a Decision Room works">
              <li>
                <b>Situation.</b> Read the brief and the evidence.
              </li>
              <li>
                <b>Decision.</b> Commit to one option and give your reason.
              </li>
              <li>
                <b>Consequence.</b> See what it does to each stakeholder, then weigh it.
              </li>
            </ol>
            <p class="hdec__actions">
              <a class="btn btn--primary" href={href.decision(id)}>
                Make the decision <span class="btn__arrow" aria-hidden="true">&rarr;</span>
              </a>
              <a href="/decision-room/scenarios/">A new scenario, worked step by step</a>
              <a href="/decision-room/stakeholder-impact/">Who gains and who loses: the stakeholder simulator</a>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 6. Financial analysis laboratory -->
  <section class="hfin band band--sunk" id="financial-laboratory" aria-labelledby="hfin-h" data-rotate-root>
    <div class="wrap">
      <div class="hhead">
        <p class="hk">Financial analysis laboratory</p>
        <h2 id="hfin-h" class="hhead__title">Where does the loss stop?</h2>
        <p class="hhead__dek">A working piece of the Finance Desk. Change any figure and the break-even point, the margin of safety and the chart answer at once, with the working shown.</p>
      </div>
      <div class="hfin__grid">
        <div class="hfin__tool">
          <BreakEvenPreview />
        </div>
        <aside class="hfin__side" aria-label="This week's financial challenge">
          <div data-rotate={CHALLENGES.length}>
            {
              CHALLENGES.map((ch, i) => (
                <div class="hfin__ch" data-variant={i} hidden={i !== pick(CHALLENGES.length)}>
                  <p class="hfin__k">
                    This week's challenge <span class="tag tag--simulated">Fictional figures</span>
                  </p>
                  <h3 class="hfin__t">{ch.title}</h3>
                  <p>{ch.question}</p>
                  <details class="hfin__answer">
                    <summary>Show the answer and the working</summary>
                    <p class="hfin__result">{ch.answer}</p>
                    <ol>
                      {ch.working.map((w) => (
                        <li>{w}</li>
                      ))}
                    </ol>
                    <a href={ch.href}>{ch.linkLabel}</a>
                  </details>
                </div>
              ))
            }
          </div>
          <p class="hfin__more">
            <a href="/finance-desk/lab/">Twenty calculators in the Financial Laboratory</a>
            <a href="/assessment/paper-2/practice/">Paper 2 calculation practice</a>
            <a href="/resources/formula-sheet/">The formula sheet</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 7. Frameworks and management tools -->
  <section class="hfw band band--white" aria-labelledby="hfw-h" data-rotate-root>
    <div class="wrap">
      <div class="hhead">
        <p class="hk">Business frameworks and management tools</p>
        <h2 id="hfw-h" class="hhead__title">Choose the tool by the question you face</h2>
        <p class="hhead__dek">{fwCount} frameworks, each with a diagram, a method, a worked example and an exercise, labelled as syllabus, toolkit or enrichment.</p>
      </div>
      <div class="hfw__grid">
        <dl class="hfw__index">
          {
            fwGroups.map((g) => (
              <div class="hfw__row">
                <dt>{g.question}</dt>
                <dd>
                  <ul class="hfw__names" role="list">
                    {g.items.map(([id, f]) => (
                      <li>
                        <a href={frameworkHref(id)}>{f.name}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="hfw__feature" data-rotate={featuredFw.length}>
          {
            featuredFw.map((f, i) => (
              <figure class="hfw__fig" data-variant={i} hidden={i !== pick(featuredFw.length)}>
                <figcaption>
                  <span class="hfw__fk">Framework of the week</span>
                  <a class="hfw__ft" href={`/toolkit/${f.tool}/`}>
                    {c.tools[f.tool]!.name}
                  </a>
                  <span class="hfw__fn">{f.note}</span>
                </figcaption>
                <div class="hfw__dg" aria-hidden="true" set:html={DIAGRAMS[f.diagram]!.render(`home-fw-${f.diagram}`)} />
              </figure>
            ))
          }
        </div>
      </div>
      <p class="hmore">
        <a class="btn" href="/frameworks/">The frameworks library <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/frameworks/compare/">Compare two side by side</a>
        <a href="/frameworks/lab/">Apply one in the Framework Application Lab</a>
        <a href="/strategy-studio/">Work one through in the Strategy Studio</a>
      </p>
    </div>
  </section>

  <!-- 8. Assessment Centre -->
  <section class="has" aria-labelledby="has-h">
    <div class="wrap has__grid">
      <div class="has__intro">
        <p class="hk hk--ink">The Assessment Centre</p>
        <h2 id="has-h" class="has__title">Know exactly what is asked. Then practise it.</h2>
        <p class="has__lead">
          Every component of the IB assessment explained from the guide, with each statement labelled: an IB requirement, examiner emphasis, a recommended
          strategy or an illustrative example.
        </p>
        <div class="has__weights">
          {
            (['sl', 'hl'] as const).map((lv) => (
              <figure class="has__w">
                <figcaption>{lv === 'sl' ? 'Standard Level' : 'Higher Level'}</figcaption>
                <div
                  class="has__bar"
                  role="img"
                  aria-label={`${lv === 'sl' ? 'Standard' : 'Higher'} Level weighting: ${weights(lv)
                    .map((x) => `${x.name} ${x.w}%`)
                    .join(', ')}`}
                >
                  {weights(lv).map((x) => (
                    <span class={`has__part has__part--${x.id}`} style={`flex:${x.w}`}>
                      <b>{x.name}</b> {x.w}%
                    </span>
                  ))}
                </div>
              </figure>
            ))
          }
          <p class="has__note">Weightings from the guide's assessment outlines.</p>
        </div>
      </div>
      <ol class="has__list" role="list">
        {
          comps.map(([id, a]) => (
            <li>
