---
/**
 * The home page. Its signature object is the decision memo: a real decision
 * from one of the cases, waiting for the reader to make it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/layout/SectionHead.astro';
import StatusTag from '../components/ui/StatusTag.astro';
import Icon from '../components/ui/Icon.astro';
import { corpus, href, modulesInOrder, pathwaysInOrder, topicsInOrder } from '../lib/content';
import { isIcon } from '../lib/icons';

const c = await corpus();
const topics = await topicsInOrder();
const modules = await modulesInOrder();
const pathways = await pathwaysInOrder();
const memo = c.decisions['marigold-growth'];
const memoCase = memo ? c.cases[memo.case] : undefined;
const METHODS = [
  {
    letter: 'A',
    name: 'Decide',
    steps: ['Situation', 'Decision', 'Consequence'],
    text: 'Commit to a choice, then live with what it does to the business and the people in it.',
    where: { label: 'In every Decision Room', href: '/decision-room/' },
  },
  {
    letter: 'B',
    name: 'Analyse',
    steps: ['Data', 'Insight', 'Option', 'Recommendation'],
    text: 'From the exhibits to a recommendation you can defend, one supported step at a time.',
    where: { label: 'In every case file', href: '/cases/' },
  },
  {
    letter: 'C',
    name: 'Diagnose',
    steps: ['Problem', 'Cause', 'Strategy', 'Implementation', 'Evaluation'],
    text: 'Find the cause before choosing the cure, then say how you would know it worked.',
    where: { label: 'In the Case Room lab', href: '/case-room/halden-diagnosis/' },
  },
];
const liveRooms = modules.filter((m) => m.data.status !== 'planned').length;
/** Working experiences, each a link to a page that exists (the link check fails the build otherwise). */
const WORKBENCH = [
  { room: 'case-room', title: 'Diagnose before you decide', text: 'A staged case lab: problem, cause, strategy, a plan against the deadline, and a judgement on the results.', href: '/case-room/halden-diagnosis/' },
  { room: 'finance-desk', title: 'Will the cash last the winter?', text: 'A cash flow forecast in the IB layout, and five ways to pay for a kiln.', href: '/finance-desk/cash-flow/' },
  { room: 'finance-desk', title: 'Ratio analysis', text: "Two years of accounts, the guide's ratios, and strategies that move them.", href: '/finance-desk/ratios/' },
  { room: 'finance-desk', title: 'Investment appraisal', text: "Payback, ARR and, at HL, NPV with the guide's discount factors.", href: '/finance-desk/investment-appraisal/' },
  { room: 'market-studio', title: 'Market share and position maps', text: 'A growing market where more sales can mean a smaller share.', href: '/market-studio/' },
  { room: 'operations-floor', title: 'Capacity, stock and location', text: 'Stock control charts and capacity at HL; weighted location scoring for all.', href: '/operations-floor/' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Arjun Agrawal | The Business Brief',
  description: 'Business management learned through decisions. Strategy. Leadership. Decisions.',
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: 'Arjun Agrawal' },
};
---

<BaseLayout title="home" description="The Business Brief by Arjun Agrawal: business management learned through decisions. Topic briefs, case files, Decision Rooms and a Finance Desk for IB DP Business Management and beyond." jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="enter">
        <p class="hero__kicker"><b>Arjun Agrawal</b> <span aria-hidden="true">·</span> The Business Brief</p>
        <h1 id="hero-h">Learn business by making the decision.</h1>
        <p class="hero__tag">Strategy. Leadership. Decisions.</p>
        <p class="lead hero__lead">
          Every topic starts with a business in a situation and ends with a decision you make, defend and live with. Built for IB Diploma
          Programme Business Management, with pathways for teachers, university students, entrepreneurs and anyone learning on their own.
        </p>
        <p class="cluster hero__actions">
          <a class="btn btn--primary" href="/topics/">Start with a topic</a>
          <a class="btn" href="/decision-room/">Enter the Decision Room</a>
        </p>
      </div>
      {
        memo && memoCase && (
          <aside class="memo memo--enter" aria-labelledby="memo-h">
            <div class="memo__head">
              <span id="memo-h">Decision memo</span>
              <span>Case 01</span>
            </div>
            <dl class="memo__rows">
              <div>
                <dt>To</dt>
                <dd>Meera Rao, founder, {memoCase.title}</dd>
              </div>
              <div>
                <dt>From</dt>
                <dd>You</dd>
              </div>
              <div>
                <dt>Re</dt>
                <dd class="memo__q">{memoCase.decision}</dd>
              </div>
              <div>
                <dt>Options</dt>
                <dd>{memo.rounds[0]?.choices.map((ch) => ch.label).join(', ')}</dd>
              </div>
              <div>
                <dt>Evidence</dt>
                <dd>{memoCase.exhibits.length} exhibits, {memoCase.stakeholders.length} stakeholders</dd>
              </div>
            </dl>
            <div class="memo__foot">
              <span class="memo__stamp stamp-in">Awaiting your decision</span>
              <a class="btn btn--ink btn--small" href={href.decision('marigold-growth')}>
                Make the decision
              </a>
            </div>
          </aside>
        )
      }
    </div>
  </section>

  <section class="band band--ink chain-band" aria-labelledby="method-h">
    <div class="wrap">
      <SectionHead no="01" title="Three ways of thinking, everywhere" id="method-h" dek="The same three chains of reasoning run through every brief, case and Decision Room, until they become a habit." />
      <ol class="methods" role="list" data-reveal="group">
        {
          METHODS.map((m) => (
            <li class="method">
              <p class="method__head">
                <span class="method__letter" aria-hidden="true">{m.letter}</span>
                <span class="method__name">{m.name}</span>
              </p>
              <ol class="method__steps" aria-label={`${m.name}: ${m.steps.join(', ')}`}>
                {m.steps.map((st) => (
                  <li>{st}</li>
                ))}
              </ol>
              <p class="method__text">{m.text}</p>
              <a class="method__where" href={m.where.href}>
                {m.where.label} <Icon id="arrow" size={16} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="bench-h">
    <div class="wrap">
      <SectionHead no="02" title="Work on something real" id="bench-h" dek="Labs and workspaces where you change the plan and the numbers answer back. Every business in them is fictional; every figure is checked." />
      <ul class="bench" role="list" data-reveal="group">
        {
          WORKBENCH.map((w) => (
            <li class="bench__item lift">
              <span class="bench__icon" aria-hidden="true">{isIcon(w.room) && <Icon id={w.room} size={22} />}</span>
              <h3 class="bench__title">
                <a href={w.href}>{w.title}</a>
              </h3>
              <p class="bench__text">{w.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="small" style="margin-top:var(--sp-4)">
        <a href="/ib/map/">See the whole course on one map</a>, with what exists for every subtopic.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="briefs-h">
    <div class="wrap">
      <SectionHead no="03" title="Three complete briefs" id="briefs-h" dek="A strategic topic, a quantitative one and a people one, each with a case, interactions, a Decision Room, practice and a revision page." />
      <div class="feature-briefs" data-reveal="group">
        {
          topics.map(([id, t]) => {
            const cs = c.cases[t.related.cases[0] ?? ''];
            return (
              <article class="feature lift">
                <span class="feature__code">Brief {t.code}</span>
                <h3>
                  <a href={href.topic(id)}>{t.title}</a>
                </h3>
                <p class="feature__q">{t.decisionQuestion}</p>
                <p class="feature__meta">
                  <span>Case: {cs?.title}</span>
                  <span>{t.related.questions.length} practice questions</span>
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="band band--sunk" aria-labelledby="modules-h">
    <div class="wrap">
      <SectionHead no="04" title="Fourteen rooms, one platform" id="modules-h" dek={`${liveRooms} of the fourteen rooms have working material now. A room is linked only when something in it works; the rest say what is planned.`} />
      <ul class="rooms" role="list" data-reveal="group">
        {
          modules.map((m) => (
            <li class:list={['room', `room--${m.data.status}`, { lift: Boolean(m.data.href) }]}>
              <span class="room__icon" aria-hidden="true">{isIcon(m.id) && <Icon id={m.id} size={28} />}</span>
              <h3 class="room__name">{m.data.href ? <a href={m.data.href}>{m.data.name}</a> : m.data.name}</h3>
              <StatusTag status={m.data.status} />
              <p class="room__purpose">{m.data.purpose}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="paths-h">
    <div class="wrap">
      <SectionHead no="05" title="Who it is for" id="paths-h" dek="One foundation, with a way in for each kind of learner." />
      <ul class="pathway-strip" data-reveal="group">
        {
          pathways.map((p) => (
            <li>
              <a href={href.pathway(p.id)}>
                <strong>{p.data.name}</strong>
                <span class="small">{p.data.promise}</span>
                <StatusTag status={p.data.status} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band--sunk" aria-labelledby="honest-h">
    <div class="wrap">
      <SectionHead no="06" title="How far to trust it" id="honest-h" />
      <div class="honesty" data-reveal="group">
        <div>
          <h3>Every claim is sourced</h3>
          <p>Statements about the IB course are checked against the Business management guide and give its page, in a public <a href="/sources/">claims register</a>.</p>
        </div>
        <div>
          <h3>Fiction is labelled</h3>
          <p>The cases are fictional, with simulated data that adds up. Real organizations appear only as cited, dated facts.</p>
        </div>
        <div>
          <h3>Practice is practice</h3>
          <p>Every question is original and labelled as such. Nothing is presented as an IB question, markscheme or markband.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
