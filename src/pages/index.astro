---
/**
 * The home page. It opens (on a first visit) with the brand reveal, then a
 * hero that says who made the platform and what it is for, and then one
 * section for each part of the platform. Every figure on the page is counted
 * from the content, so it changes when the content does.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/layout/SectionHead.astro';
import Monogram from '../components/brand/Monogram.astro';
import CreatorPhoto from '../components/brand/CreatorPhoto.astro';
import HeroBlueprint from '../components/home/HeroBlueprint.astro';
import StatusTag from '../components/ui/StatusTag.astro';
import Icon from '../components/ui/Icon.astro';
import { casesInOrder, corpus, href, modulesInOrder, pathwaysInOrder } from '../lib/content';
import { curriculumOf, subtopicCoverage } from '../lib/coverage';
import { isIcon } from '../lib/icons';
import { library } from '../lib/resources';
import { DIAGRAMS } from '../lib/diagrams';
import { renderThumb } from '../lib/mindmap';
import ResourceCover from '../components/resources/ResourceCover.astro';

const c = await corpus();
const cur = curriculumOf(c);
const coverage = subtopicCoverage(c);
const modules = await modulesInOrder();
const pathways = await pathwaysInOrder();
const cases = await casesInOrder();
/** The four ways in offered in the hero; the full list is further down the page. */
const HERO_PATHS = ['ib-dp', 'teachers', 'undergraduate', 'independent'];
const heroPaths = HERO_PATHS.map((id) => pathways.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));

const complete = coverage.filter((s) => s.state === 'complete').length;
const partial = coverage.filter((s) => s.state === 'partial').length;
const interactions = Object.values(c.interactives).filter((it) => it.page).length;
const questions = Object.keys(c.questions).length;
const terms = Object.keys(c.glossary).length;
const maps = Object.entries(c.mindmaps).sort((a, b) => a[1].order - b[1].order);
const resources = (await library()).sort((a, b) => a.order - b.order);
const featured = resources.filter((r) => r.curated).slice(0, 4);
const HOME_DIAGRAMS = ['break-even-chart', 'bcg-matrix', 'maslow-hierarchy'];
const LETTERS = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].filter((l) => Object.values(c.glossary).some((g) => g.term.toUpperCase().startsWith(l)));

const INDEX = [
  { value: String(coverage.length), label: 'subtopics', note: 'the whole IB course, mapped' },
  { value: String(complete), label: complete === 1 ? 'subtopic complete' : 'subtopics complete', note: `full notes or a brief; ${partial} more partly built` },
  { value: String(interactions), label: 'interactive tools', note: 'labs, desks and simulations' },
  { value: String(questions), label: 'practice questions', note: 'original, with mark schemes' },
  { value: String(terms), label: 'glossary terms', note: 'defined, connected, searchable' },
  { value: String(maps.length), label: 'mindmaps', note: 'interactive, printable, downloadable' },
];

const METHODS = [
  {
    no: 'A',
    name: 'Decide',
    steps: ['Situation', 'Decision', 'Consequence'],
    text: 'Commit to a choice, then live with what it does to the business and the people in it.',
    where: { label: 'In every Decision Room', href: '/decision-room/' },
  },
  {
    no: 'B',
    name: 'Analyse',
    steps: ['Data', 'Insight', 'Option', 'Recommendation'],
    text: 'From the evidence to a recommendation you can defend, one supported step at a time.',
    where: { label: 'In every case file', href: '/cases/' },
  },
  {
    no: 'C',
    name: 'Diagnose',
    steps: ['Problem', 'Cause', 'Strategy', 'Implementation', 'Evaluation'],
    text: 'Find the cause before choosing the cure, then say how you would know it worked.',
    where: { label: 'In the Case Room lab', href: '/case-room/halden-diagnosis/' },
  },
];

const WORKBENCH = [
  { room: 'case-room', title: 'Diagnose before you decide', text: 'A staged case lab: problem, cause, strategy, a plan against the deadline, and a judgement.', href: '/case-room/halden-diagnosis/' },
  { room: 'finance-desk', title: 'Will the cash last the winter?', text: 'A cash flow forecast in the IB layout, and five ways to pay for a kiln.', href: '/finance-desk/cash-flow/' },
  { room: 'finance-desk', title: 'Break-even, live', text: 'Move price and costs; the chart, the margin of safety and the profit answer back.', href: '/finance-desk/break-even/' },
  { room: 'finance-desk', title: 'Ratio analysis', text: "Two years of accounts, the guide's ratios, and the strategies that move them.", href: '/finance-desk/ratios/' },
  { room: 'finance-desk', title: 'Investment appraisal', text: "Payback, ARR and, at HL, NPV with the guide's discount factors.", href: '/finance-desk/investment-appraisal/' },
  { room: 'operations-floor', title: 'Capacity, stock and location', text: 'Stock control charts and capacity at HL; weighted location scoring for all.', href: '/operations-floor/' },
];

const components = Object.entries(c.assessment).sort((a, b) => a[1].order - b[1].order);
const ASSESS_HREF: Record<string, string> = {
  'internal-assessment': '/assessment/internal-assessment/',
  'paper-1': '/assessment/paper-1/',
  'paper-2': '/assessment/paper-2/',
  'paper-3': '/assessment/paper-3/',
};
const fmtOutline = (o: { duration: string; marks: number; weight: number } | undefined) => (o ? `${o.marks} marks, ${o.weight}%` : '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Arjun Agrawal | The Business Brief',
  description: 'Understand business. Think strategically. Make better decisions. A Business Management learning platform by Arjun Agrawal.',
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: 'Arjun Agrawal' },
};
---

<BaseLayout
  title="home"
  intro
  description="The Business Brief by Arjun Agrawal: a Business Management learning platform with topic notes, mindmaps, case studies, interactive tools and an Assessment Centre for IB Diploma Programme Business Management."
  jsonLd={jsonLd}
>
  <section class="hh band--grain" aria-labelledby="hero-h">
    <div class="wrap hh__grid">
      <div class="hh__copy enter">
        <p class="hh__eyebrow">
          <Monogram height={22} />
          <span class="hh__brand">Arjun Agrawal</span>
          <span class="hh__sep" aria-hidden="true"></span>
          <span class="hh__brand hh__brand--product">The Business Brief</span>
        </p>
        <h1 id="hero-h" class="hh__title">
          Understand business. <em>Think strategically.</em> Make better decisions.
        </h1>
        <p class="hh__lead">
          A Business Management learning platform by Arjun Agrawal: the IB course mapped topic by topic, with notes, mindmaps, case studies, live
          financial tools and an Assessment Centre, all built around one habit. Read the situation, weigh the evidence, decide, and own the
          consequence.
        </p>
        <p class="hh__actions">
          <a class="btn btn--primary" href="/topics/">Explore the topic library <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
          <a class="btn" href="/assessment/">Assessment Centre</a>
        </p>
        <nav class="hh__paths" aria-labelledby="hh-paths-h">
          <p class="label" id="hh-paths-h">Start where you are</p>
          <ul>
            {
              heroPaths.map((p) => (
                <li>
                  <a href={href.pathway(p.id)}>{p.data.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <figure class="hh__figure enter">
        <HeroBlueprint />
        <div class="hh__frame">
          <CreatorPhoto name="portrait-formal" alt="Arjun Agrawal" priority sizes="(min-width: 64rem) 30vw, 70vw" />
        </div>
        <span class="hh__seal" aria-hidden="true"><Monogram height={30} reversed /></span>
        <figcaption class="hh__caption">
          <span class="hh__caption-name">Arjun Agrawal</span>
          <span class="hh__caption-role">IB Diploma Programme educator in Economics, Business Management and Global Politics</span>
        </figcaption>
      </figure>
    </div>

    <div class="wrap">
      <dl class="hh__index" data-reveal="group">
        {
          INDEX.map((f) => (
            <div>
              <dt>
                <span class="hh__index-v">{f.value}</span> {f.label}
              </dt>
              <dd>{f.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="method-h">
    <div class="wrap">
      <SectionHead no="01" title="Three chains of reasoning, everywhere" id="method-h" dek="The same habits of mind run through every topic, case and Decision Room until they become second nature." />
      <ol class="hm" role="list" data-reveal="group">
        {
          METHODS.map((m) => (
            <li class="hm__item">
              <p class="hm__head">
                <span class="hm__no" aria-hidden="true">{m.no}</span>
                <span class="hm__name">{m.name}</span>
              </p>
              <ol class="hm__steps" aria-label={`${m.name}: ${m.steps.join(', ')}`}>
                {m.steps.map((st) => (
                  <li>{st}</li>
                ))}
              </ol>
              <p class="hm__text">{m.text}</p>
              <a class="hm__where" href={m.where.href}>
                {m.where.label} <Icon id="arrow" size={16} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="course-h">
    <div class="wrap">
      <SectionHead no="02" title="The course, unit by unit" id="course-h" dek={`All ${coverage.length} subtopics of IB DP Business Management in their five units. Each square is a subtopic: filled where its full notes or a complete brief exist, outlined in gold where its page has a mindmap, key terms and diagrams but the notes are still to come, ruled where it is planned.`} />
      <ol class="hc" role="list" data-reveal="group">
        {
          cur.units.map((u) => {
            const subs = coverage.filter((s) => s.unit.id === u.id);
            return (
              <li class="hc__unit">
                <span class="hc__no" aria-hidden="true">{u.number}</span>
                <div class="hc__body">
                  <h3 class="hc__title">
                    <a href={`/topics/#unit-${u.number}`}>{u.title}</a>
                  </h3>
                  <p class="hc__meta">
                    {subs.length} subtopics
                    {u.hours && <span> · {u.hours.sl === u.hours.hl ? `${u.hours.sl} hours` : `${u.hours.sl} hours SL, ${u.hours.hl} HL`}</span>}
                  </p>
                  <ul class="hc__ticks" aria-label={`Unit ${u.number} subtopics`}>
                    {subs.map((s) => (
                      <li class:list={['hc__tick', `hc__tick--${s.state}`]} title={`${s.subtopic.code} ${s.subtopic.title}`}>
                        <span class="sr-only">
                          {s.subtopic.code} {s.subtopic.title}: {s.state === 'complete' ? 'complete' : s.state === 'partial' ? 'partly built' : 'planned'}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="hc__more">
        <a class="btn" href="/topics/">Open the topic library <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/ib/map/">See the course map</a>
        <a href="/ib/coverage/">Read the coverage tracker</a>
      </p>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="see-h">
    <div class="wrap">
      <SectionHead no="03" title="See the structure, know the words" id="see-h" dek="Every subtopic as a mindmap you can fold, zoom, print and download, original diagrams for every unit, and a glossary of the whole course in plain language." />
      <div class="hv">
        <a class="hv__maps" href="/mindmaps/">
          <span class="hv__thumbs" aria-hidden="true">
            {maps.slice(0, 6).map(([, m]) => <span class="hv__thumb" set:html={renderThumb(m)} />)}
          </span>
          <span class="hv__label">Mindmaps</span>
          <span class="hv__title">{maps.length} {maps.length === 1 ? 'map' : 'maps'} of the course, subtopic by subtopic</span>
          <span class="hv__text">A full map for study and a revision view of the essentials; colour-coded branches for ideas, types, theories, tools, calculations and evaluation.</span>
        </a>
        <div class="hv__gloss">
          <p class="hv__label">Glossary</p>
          <p class="hv__title">{terms} terms, defined in the platform's own words</p>
          <form class="hv__search" action="/glossary/" method="get" role="search">
            <label class="sr-only" for="hv-q">Search the glossary</label>
            <input id="hv-q" name="q" type="search" placeholder="Look up a term" autocomplete="off" />
            <button class="btn btn--primary" type="submit">Look up</button>
          </form>
          <ul class="hv__az" aria-label="Browse the glossary from A to Z">
            {LETTERS.map((l) => <li><a href={`/glossary/#letter-${l}`}>{l}</a></li>)}
          </ul>
        </div>
        <a class="hv__dg" href="/diagrams/">
          <span class="hv__dgthumbs" aria-hidden="true">
            {HOME_DIAGRAMS.map((did) => <span class="hv__dgthumb" set:html={DIAGRAMS[did]!.render(`home-${did}`)} />)}
          </span>
          <span class="hv__dgtext">
            <span class="hv__label">Diagrams and infographics</span>
            <span class="hv__title">{Object.keys(DIAGRAMS).length} original diagrams, drawn from data</span>
            <span class="hv__text">Models, processes, structures and charts for all five units and the toolkit, each with a text description and an SVG download.</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="bench-h">
    <div class="wrap">
      <SectionHead no="04" title="Interactive tools that answer back" id="bench-h" dek="Change the plan or the numbers and watch the business respond. Every business in them is fictional; every figure is checked." />
      <ol class="hb" role="list" data-reveal="group">
        {
          WORKBENCH.map((w, i) => (
            <li class="hb__item lift">
              <span class="hb__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="hb__icon" aria-hidden="true">{isIcon(w.room) && <Icon id={w.room} size={22} />}</span>
              <h3 class="hb__title">
                <a href={w.href}>{w.title}</a>
              </h3>
              <p class="hb__text">{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="cases-h">
    <div class="wrap">
      <SectionHead no="05" title="Business case studies" id="cases-h" dek="Fictional organizations with complete, consistent data: exhibits, stakeholders and a decision to make. Each is labelled as fiction." />
      <div class="hk" data-reveal="group">
        {
          cases.map(([id, cs]) => (
            <article class="hk__case lift">
              <p class="label">Case file · fictional</p>
              <h3 class="hk__title">
                <a href={href.case(id)}>{cs.title}</a>
              </h3>
              <p class="hk__q">{cs.decision}</p>
              <p class="hk__meta">
                {cs.exhibits.length} exhibits · {cs.stakeholders.length} stakeholders
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="assess-h">
    <div class="wrap">
      <SectionHead no="06" title="The Assessment Centre" id="assess-h" dek="Every component of the IB assessment, explained from the guide, with practice built for it: the research project, Paper 1, Paper 2 and the HL Paper 3." />
      <ul class="ha" role="list" data-reveal="group">
        {
          components.map(([id, a]) => (
            <li class="ha__item">
              <p class="ha__short" aria-hidden="true">{a.short}</p>
              <h3 class="ha__name">
                <a href={ASSESS_HREF[id] ?? '/assessment/'}>{a.name}</a>
              </h3>
              <p class="ha__levels">{a.levels}</p>
              <dl class="ha__facts">
                {a.outline?.sl && (
                  <div>
                    <dt>SL</dt>
                    <dd>{fmtOutline(a.outline.sl)}</dd>
                  </div>
                )}
                {a.outline?.hl && (
                  <div>
                    <dt>HL</dt>
                    <dd>{fmtOutline(a.outline.hl)}</dd>
                  </div>
                )}
              </dl>
            </li>
          ))
        }
      </ul>
      <p class="ha__more">
        <a class="btn btn--gold" href="/assessment/">Enter the Assessment Centre <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="res-h">
    <div class="wrap">
      <SectionHead no="07" title="The Resources Library" id="res-h" dek={`${resources.length} resources to learn, teach and revise with: assessment guides, notes, mindmaps, case studies, practice, a formula sheet and the tools. Downloads only where a real file exists.`} />
      <ul class="hres" role="list">
        {
          featured.map((r) => (
            <li>
              <a href={r.details ?? r.primary.href} class="hres__item">
                <ResourceCover item={r} />
                <span class="hres__title">{r.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="hc__more">
        <a class="btn" href="/resources/">Open the library <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/resources/formula-sheet/">The formula sheet</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="rooms-h">
    <div class="wrap">
      <SectionHead
        no="08"
        title="Learning environments"
        id="rooms-h"
        dek={`Fourteen rooms, each a way of working. ${modules.filter((m) => m.data.status !== 'planned').length} have working material now; a room is linked only when something in it works.`}
      />
      <ul class="hr" role="list" data-reveal="group">
        {
          modules.map((m) => (
            <li class:list={['hr__room', `hr__room--${m.data.status}`, { lift: Boolean(m.data.href) }]}>
              <span class="hr__icon" aria-hidden="true">{isIcon(m.id) && <Icon id={m.id} size={24} />}</span>
              <h3 class="hr__name">{m.data.href ? <a href={m.data.href}>{m.data.name}</a> : m.data.name}</h3>
              <StatusTag status={m.data.status} />
              <p class="hr__purpose">{m.data.purpose}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="creator-h">
    <div class="wrap hcr">
      <figure class="hcr__figure">
        <CreatorPhoto name="audience-portrait" alt="Arjun Agrawal speaking to a class, gesturing towards a budget table on the screen behind him" sizes="(min-width: 64rem) 32vw, 90vw" />
      </figure>
      <div class="hcr__text">
        <p class="label">09 · About the creator</p>
        <h2 id="creator-h" class="hcr__title">Arjun Agrawal</h2>
        <p class="hcr__lead">
          An IB Diploma Programme educator in Economics, Business Management and Global Politics, with an academic background in Economics at St.
          Stephen's College, University of Delhi, undergraduate teaching at Fergusson College, Pune, and Diploma Programme teaching and academic work in
          Pune. He also mentors UPSC Civil Services aspirants in Economics.
        </p>
        <p>
          The Business Brief and Arjun Agrawal Economics are the two platforms of the Arjun Agrawal Knowledge Series: the resources a classroom needs,
          built to be used by anyone.
        </p>
        <p class="hcr__actions">
          <a class="btn" href="/about/">Read the full profile <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="paths-h">
    <div class="wrap">
      <SectionHead no="10" title="A way in for every learner" id="paths-h" dek="One foundation, with a route through it for IB students, teachers, university students, entrepreneurs and anyone learning on their own." />
      <ul class="hp" data-reveal="group">
        {
          pathways.map((p) => (
            <li>
              <a href={href.pathway(p.id)}>
                <strong>{p.data.name}</strong>
                <span class="small">{p.data.promise}</span>
                <StatusTag status={p.data.status} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band--sunk" aria-labelledby="honest-h">
    <div class="wrap">
      <SectionHead no="11" title="How far to trust it" id="honest-h" />
      <div class="ht" data-reveal="group">
        <div>
          <h3>Every claim is sourced</h3>
          <p>Statements about the IB course are checked against the Business management guide and give its page, in a public <a href="/sources/">claims register</a>.</p>
        </div>
        <div>
          <h3>Fiction is labelled</h3>
          <p>The cases are fictional, with simulated data that adds up. Real organizations appear only as cited, dated facts.</p>
        </div>
        <div>
          <h3>Practice is practice</h3>
          <p>Every question is original and labelled as such. Nothing is presented as an IB question, markscheme or markband.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hh {
    position: relative;
    padding-block: clamp(2.5rem, 5vw, 5rem) var(--sp-7);
    overflow: hidden;
  }

  .hh__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  .hh__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 0.75rem;
  }

  .hh__brand {
    font-family: var(--font-brand);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--navy-900);
  }

  .hh__brand--product {
    color: var(--brass-text);
  }

  .hh__sep {
    width: 1.75rem;
    height: 1px;
    background: var(--gold-500);
  }

  .hh__title {
    margin-top: var(--sp-5);
    font-size: clamp(2.75rem, 1.45rem + 4.4vw, 5.375rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.024em;
    color: var(--navy-900);
    text-wrap: balance;
  }

  .hh__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--brass-text);
  }

  .hh__lead {
    margin-top: var(--sp-5);
    max-width: 38rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text-body);
  }

  .hh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .hh__paths {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
    max-width: 38rem;
  }

  .hh__paths ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .hh__paths li {
    margin: 0;
  }

  .hh__paths a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    color: var(--navy-900);
    font-size: 0.875rem;
    font-weight: 540;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .hh__paths a:hover {
    border-color: var(--gold-500);
    background: #fff;
  }

  /* The figure: portrait in a frame, the line drawing around it */
  .hh__figure {
    position: relative;
    aspect-ratio: 560 / 680;
    width: 100%;
    max-width: 34rem;
    margin: 0 0 0 auto;
  }

  .hh__frame {
    position: absolute;
