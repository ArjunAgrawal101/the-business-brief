---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import SectionHead from '../../components/layout/SectionHead.astro';
import VerifyTag from '../../components/ui/VerifyTag.astro';
import { corpus, href, questionsInOrder } from '../../lib/content';

const c = await corpus();
const comps = Object.entries(c.assessment).sort((a, b) => a[1].order - b[1].order);
const questions = await questionsInOrder();
const weightClaim = c.claims['assessment-weightings'];
---

<BaseLayout title="Exam Desk" description="The IB Business Management assessment, stated with its sources and verification status, and original practice organized by paper." section="exam-desk">
  <PageIntro
    trail={[{ label: 'Exam Desk' }]}
    kicker="Exam Desk"
    title="The assessment, and how to prepare"
    lead="Each component as the Business management guide describes it, with page references, followed by original practice. Nothing here is an IB examination question, and every mark allocation shown is either the guide's or clearly labelled as the platform's own."
  />
  <div class="wrap page-body">
    <section aria-labelledby="comp-h">
      <SectionHead no={1} title="The components" id="comp-h" />
      <ol class="index-list" style="margin-top:var(--sp-4)">
        {
          comps.map(([id, a]) => (
            <li class="index-item">
              <span class="index-item__code">{a.short}</span>
              <div class="index-item__body">
                <h3 class="index-item__title">
                  <a href={href.assessment(id)}>{a.name}</a>
                </h3>
                <p>{a.summary}</p>
              </div>
              <div class="index-item__side">
                <span class={`tag ${a.levels === 'HL only' ? 'tag--hl' : 'tag--sl'}`}>{a.levels}</span>
                <span class="muted">{a.questions.length} practice questions</span>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
    <section aria-labelledby="w-h">
      <SectionHead no={2} title="Weightings and timings" dek="From the guide's assessment outlines. SL and HL sit different combinations of the same components." id="w-h" />
      <div class="table-scroll" role="region" aria-label="Weightings and timings by component" tabindex="0" style="margin-top:var(--sp-4)">
        <table class="table outline">
          <caption class="sr-only">Duration, marks and weighting of each component at SL and HL</caption>
          <thead>
            <tr>
              <th scope="col" rowspan="2">Component</th>
              <th scope="colgroup" colspan="3">SL</th>
              <th scope="colgroup" colspan="3">HL</th>
            </tr>
            <tr>
              <th scope="col">Time</th>
              <th scope="col" class="n">Marks</th>
              <th scope="col" class="n">Weight</th>
              <th scope="col">Time</th>
              <th scope="col" class="n">Marks</th>
              <th scope="col" class="n">Weight</th>
            </tr>
          </thead>
          <tbody>
            {
              comps.map(([id, a]) => (
                <tr>
                  <th scope="row">
                    <a href={href.assessment(id)}>{a.name}</a>
                  </th>
                  {(['sl', 'hl'] as const).map((l) => {
                    const o = a.outline?.[l];
                    return o ? (
                      <>
                        <td>{o.duration}</td>
                        <td class="n">{o.marks}</td>
                        <td class="n">{o.weight}%</td>
                      </>
                    ) : (
                      <td colspan="3" class="muted">Not taken at {l.toUpperCase()}</td>
                    );
                  })}
                </tr>
              ))
            }
            <tr class="is-total">
              <th scope="row">Total</th>
              {(['sl', 'hl'] as const).map((l) => (
                <>
                  <td colspan="2" />
                  <td class="n">
                    <strong>{comps.reduce((n, [, a]) => n + (a.outline?.[l]?.weight ?? 0), 0)}%</strong>
                  </td>
                </>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
      {
        weightClaim && (
          <p class="small muted" style="margin-top:var(--sp-3)">
            {weightClaim.statement} Business management guide, {weightClaim.location}. <VerifyTag status={weightClaim.status} />
          </p>
        )
      }
    </section>
    <section aria-labelledby="p-h">
      <SectionHead no={3} title="Practice" id="p-h" />
      <div class="grid grid--2" style="margin-top:var(--sp-4)">
        <div class="prose">
          <p>
            {questions.length} original practice questions, written for the cases on this platform in the style of each paper. Each
            has a mark scheme or levels of its own, labelled as the platform's, and the errors that most often cost marks.
          </p>
          <p><a class="btn btn--primary" href="/exam-desk/practice/">Open the practice set</a></p>
        </div>
        <div class="prose">
          <p>
            Command terms decide what an answer must do. The <a href="/examiner-lens/">Examiner Lens</a> lists the guide's 31 terms at
            their assessment objective levels, explains each in the platform's words, and shows how to answer to it.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
