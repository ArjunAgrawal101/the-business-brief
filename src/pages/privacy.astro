---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import SectionHead from '../components/layout/SectionHead.astro';

const KEYS = [
  { key: 'bb:level', what: 'Whether you chose to see SL or HL content.' },
  { key: 'bb:quiz:…', what: 'Your answers in the classification exercises, so they are still there when you return.' },
  { key: 'bb:q:…', what: 'Your answers to practice questions, and your self-check against the mark scheme.' },
  { key: 'bb:dr:…', what: 'Your choices and notes in each Decision Room.' },
  { key: 'bb:boardroom:…', what: 'Your seat, decisions, reasoning and board memo in each Boardroom simulation.' },
  { key: 'bb:ff:…', what: 'Your weighting of the forces in a force field analysis, and your note on it.' },
  { key: 'bb:rc:…', what: 'How well you recalled each retrieval card.' },
  { key: 'bb:ia-plan', what: 'Your IA Studio plan: the notes, the list of candidate documents, the self-assessed marks and the steps marked done.' },
  { key: 'bb:bank', what: 'Your attempts and self-ratings in the question bank, and the timed sets you finished there.' },
  { key: 'bb:p2-practice', what: 'Your record in Paper 2 calculation practice: the calculations you checked, how many were right first time, and your timed sets.' },
  { key: 'bb:p2-prefs', what: 'The level and topics you last chose in Paper 2 calculation practice.' },
  { key: 'bb:ia-concept', what: 'Your organization, issue, research question, chosen key concept and ticked tests in the IA key concept guide.' },
  { key: 'bb:ia-documents', what: 'The supporting documents you listed in the IA document tool, with your notes on each.' },
  { key: 'bb:ia-tools', what: 'Your answers and shortlist in the IA tool selection assistant.' },
  { key: 'bb:ia-timeline', what: 'The start date, deadline and session you entered in the IA research timeline.' },
  { key: 'bb:ia-progress', what: 'The stages, notes, word count and final checks in the IA progress tracker.' },
  { key: 'bb:p1-workspace', what: 'The case you pasted into the Paper 1 workspace, the evidence you tagged and your answer plan.' },
  { key: 'bb:studio:…', what: 'Your notes, chosen axes and weights in the Market Studio and Operations Floor tools.' },
  { key: 'bb:market:…', what: 'Your work in each Market Studio instrument: segments and positioning, the marketing mix, the persona, the positioning map, the questionnaire, the product life cycle, the campaign plan, the budget split and the market metrics.' },
  { key: 'bb:cash-flow:…', what: 'How you chose to pay for the kiln, and the measures you chose, in the cash flow lab.' },
  { key: 'bb:case-lab:…', what: 'Your progress through a case lab, the sentences you wrote at each stage and the plan you tried.' },
  { key: 'bb:strategy:…', what: 'Your analysis in each Strategy Studio tool, such as your SWOT, decision tree or recommendation memo, with a one-line summary of it.' },
  { key: 'bb:lab:…', what: 'Your work in the Entrepreneurship and Innovation Lab: the canvas, the feasibility scores, the costs, revenue and unit economics you entered, your business plan outline, and a summary of each tool’s results for the plan to quote.' },
  { key: 'bb:case:…', what: 'The alternative you chose in a case file’s decision exercise, your reasons and the date you committed.' },
  { key: 'bb:ck:…', what: 'The items you ticked in the Assessment Centre checklists.' },
  { key: 'bb:ia:rq', what: 'Your research question in the Assessment Centre builder.' },
  { key: 'bb:ia:sd', what: 'The supporting documents you listed in the Assessment Centre, with their dates.' },
  { key: 'bb:p3:plan', what: 'Your Paper 3 plan of action in the plan builder.' },
  { key: 'bb:learner', what: 'For your dashboard: the subtopic, mindmap, case, toolkit, framework and tool pages you open, with the time of your first and latest visit, and the exercise items you check, with whether each was right. Capped at the 400 most recent pages.' },
  { key: 'bb:saved', what: 'The pages and items you saved with the Save button, listed on your dashboard.' },
  { key: 'bb:framework:…', what: 'Your answer to the exercise on each page of the frameworks library.' },
];
---

<BaseLayout title="Privacy" description="The Business Brief has no accounts, no analytics and no cookies. What it keeps on your device, and how to clear it." section="platform">
  <PageIntro trail={[{ label: 'Privacy' }]} kicker="Privacy" title="Your work stays on your device" lead="There are no accounts, no analytics, no advertising and no cookies. Nothing you type is sent anywhere." />
  <div class="wrap page-body">
    <section aria-labelledby="kept-h">
      <SectionHead no={1} title="What is kept, and where" id="kept-h" />
      <div class="prose" style="margin-top:var(--sp-4)">
        <p>
          Some pages remember your work using your browser's local storage, which stays on this device and in this browser. It is not
          sent to the platform or to anyone else, and the platform cannot see it. Each item starts with <code>bb:</code>.
        </p>
      </div>
      <div class="table-scroll" role="region" aria-label="What is stored on this device" tabindex="0" style="margin-top:var(--sp-4)">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">What it holds</th>
            </tr>
          </thead>
          <tbody>
            {
              KEYS.map((k) => (
                <tr>
                  <th scope="row">
                    <code>{k.key}</code>
                  </th>
                  <td>{k.what}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="prose" style="margin-top:var(--sp-5)">
        <p>
          Your <a href="/dashboard/">dashboard</a> is built from these items. To show where you have been, the site notes in
          <code>bb:learner</code> the pages you open, by kind, and when. Like everything else here, it stays in this browser and is never
          sent anywhere. You can turn it off on the dashboard (nothing new is noted while it is off), download a copy, or clear it.
        </p>
      </div>
      <div class="clear-box" data-clear-box>
        <p class="small" data-count>Clearing needs JavaScript. You can also clear this site's data in your browser's settings.</p>
        <button type="button" class="btn btn--primary" data-clear hidden>Clear everything this site has stored</button>
      </div>
    </section>
    <section aria-labelledby="other-h">
      <SectionHead no={2} title="Everything else" id="other-h" />
      <div class="prose" style="margin-top:var(--sp-4)">
        <p>
          The site is a set of static files. Fonts and images are served from the site itself, so a visit makes no requests to other
          services. The company that hosts the files may keep standard request logs, such as the time of a request and the address it came
          from, for security and to keep the service running; the platform does not use them.
        </p>
        <p>
          Links to other sites, such as the sources on the sources page, take you to sites with their own policies.
        </p>
        <p>
          If accounts, analytics or any tracking that leaves your device are ever added, this page will say so first, with what is collected,
          why, and how to say no.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const box = document.querySelector<HTMLElement>('[data-clear-box]');
  const count = box?.querySelector<HTMLElement>('[data-count]');
  const btn = box?.querySelector<HTMLButtonElement>('[data-clear]');
  const keys = () => {
    try {
      return Object.keys(localStorage).filter((k) => k.startsWith('bb:'));
    } catch {
      return null;
    }
  };
  const show = () => {
    const k = keys();
    if (!count || !btn) return;
    if (k === null) {
      count.textContent = 'This browser is not allowing the site to store anything, so there is nothing to clear.';
      btn.hidden = true;
      return;
    }
    count.textContent = k.length ? `This browser holds ${k.length} ${k.length === 1 ? 'item' : 'items'} from this site.` : 'This browser holds nothing from this site.';
    btn.hidden = k.length === 0;
  };
  btn?.addEventListener('click', () => {
    if (!window.confirm('Clear all your answers, notes and choices on this site, in this browser?')) return;
    keys()?.forEach((k) => localStorage.removeItem(k));
    document.documentElement.removeAttribute('data-level');
    show();
    btn.focus();
  });
  show();
</script>

<style>
  .clear-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-5);
    padding: var(--sp-4);
    background: var(--surface-sunk);
    border-left: 3px solid var(--bb-ink);
  }

  .clear-box p {
    margin: 0;
  }
</style>
