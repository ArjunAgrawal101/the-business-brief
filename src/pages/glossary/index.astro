---
/**
 * The glossary: every term the course uses, and the terms beyond it, in the
 * platform's own words. Search it as you type, filter it by unit, level,
 * category and qualification, or browse it from A to Z. Without JavaScript
 * every term is listed. Each term has its own page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import { corpus, href } from '../../lib/content';
import { inline } from '../../lib/markup';
import { GLOSSARY_CATEGORIES, GLOSSARY_CATEGORY_LABELS, QUALIFICATION_TAGS, QUALIFICATION_TAG_LABELS } from '../../lib/schemas';
import { isDeep, isEnrichment, qualificationsOf, searchKeys } from '../../lib/glossary';

const c = await corpus();
const entries = Object.entries(c.glossary).sort((a, b) => a[1].term.localeCompare(b[1].term, 'en', { sensitivity: 'base' }));
const letterOf = (t: string) => {
  const ch = t.trim()[0]?.toUpperCase() ?? '#';
  return /[A-Z]/.test(ch) ? ch : '#';
};
const present = new Set(entries.map(([, g]) => letterOf(g.term)));
// Terms that start with a figure (360-degree feedback) come first, under "0 to 9".
const ALPHABET = [...(present.has('#') ? ['#'] : []), ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];
const key = (l: string) => (l === '#' ? 'num' : l);
const units = c.curricula['ib-dp-bm']?.units ?? [];
const unitOf = (code: string) => (code === 'toolkit' ? 'toolkit' : code.split('.')[0]);
const usedCats = GLOSSARY_CATEGORIES.filter((k) => entries.some(([, g]) => g.category === k));
const hlCount = entries.filter(([, g]) => g.level === 'HL' && !isEnrichment(g)).length;
const beyondCount = entries.filter(([, g]) => isEnrichment(g)).length;
const ibCount = entries.length - beyondCount;
const deepCount = entries.filter(([, g]) => isDeep(g)).length;
const usedQuals = QUALIFICATION_TAGS.filter((q) => entries.some(([, g]) => qualificationsOf(g).includes(q)));
const unitsOf = (g: (typeof entries)[number][1]) => (isEnrichment(g) ? 'beyond' : [...new Set(g.subtopics.map(unitOf))].join(' '));
---

<BaseLayout title="Glossary" description={`${entries.length} business management terms defined in plain language, with context, examples, formulas and links to the notes, mindmaps and frameworks that use them.`} section="glossary">
  <PageIntro
    trail={[{ label: 'Glossary' }]}
    kicker="Reference"
    title="Business Management, defined"
    lead={`${ibCount} terms from the IB course and ${beyondCount} beyond it, in the platform's own words. Search as you type, filter by unit, level, category or qualification, or browse from A to Z. ${hlCount} are HL only and marked as such.`}
  />

  <div class="wrap page-body" data-ix="glossary">
    <dl class="gl-key" aria-label="What the glossary holds">
      <div><dt>{ibCount}</dt><dd>terms from the IB course, each with its place in the syllabus</dd></div>
      <div><dt>{deepCount}</dt><dd>full dictionary entries: plain and technical explanations and common misconceptions</dd></div>
      <div><dt>{beyondCount}</dt><dd>enrichment terms beyond the IB course, for university, MBA and professional study</dd></div>
    </dl>
    <p class="gl-csv"><a href="/downloads/glossary.csv" download>Download every term as a spreadsheet (CSV)</a>, with the plain and technical explanations and the misconceptions.</p>

    <form class="gl-search js-only" role="search" action="/glossary/" method="get" data-form>
      <label class="label label--ink" for="gq">Search the glossary</label>
      <div class="gl-search__row">
        <input id="gq" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Try: gearing, motivation, break-even" aria-describedby="gq-hint" />
        <button class="btn btn--primary" type="submit">Search</button>
      </div>
      <p class="gl-search__hint" id="gq-hint">Results narrow as you type. Searches names, other names, definitions and the plain-language explanations.</p>
    </form>
    <p class="gl-nojs nojs-only">All {entries.length} terms are listed below from A to Z. To search them, use your browser's find on this page.</p>

    <div class="gl-filters js-only">
      <div class="gl-filter">
        <label class="label" for="gl-unit">Unit</label>
        <select id="gl-unit" data-filter="unit">
          <option value="">All units</option>
          {units.map((u) => <option value={String(u.number)}>Unit {u.number}: {u.title}</option>)}
          <option value="toolkit">Toolkit</option>
          {beyondCount > 0 && <option value="beyond">Beyond the IB course</option>}
        </select>
      </div>
      <div class="gl-filter">
        <label class="label" for="gl-level">Level</label>
        <select id="gl-level" data-filter="level">
          <option value="">SL and HL</option>
          <option value="sl">SL only (hide HL-only terms)</option>
          <option value="hl">HL-only terms</option>
        </select>
      </div>
      <div class="gl-filter">
        <label class="label" for="gl-cat">Category</label>
        <select id="gl-cat" data-filter="category">
          <option value="">Every category</option>
          {usedCats.map((k) => <option value={k}>{GLOSSARY_CATEGORY_LABELS[k]}</option>)}
        </select>
      </div>
      <div class="gl-filter">
        <label class="label" for="gl-qual">QualificationTag</label>
        <select id="gl-qual" data-filter="qualification">
          <option value="">Every qualification</option>
          {usedQuals.map((q) => <option value={q}>{QUALIFICATION_TAG_LABELS[q]}</option>)}
        </select>
      </div>
      <p class="gl-count" aria-live="polite" data-count>{entries.length} terms</p>
    </div>

    <nav class="gl-az" aria-label="Browse from A to Z">
      <ul>
        {
          ALPHABET.map((l) => (
            <li>{present.has(l) ? <a href={`#letter-${key(l)}`} data-letter={key(l)}>{l === '#' ? '0-9' : l}</a> : <span aria-hidden="true">{l}</span>}</li>
          ))
        }
      </ul>
    </nav>

    <p class="state" data-none hidden>
      No term matches. Try a shorter word or clear the filters; the <a href="/search/">site search</a> also looks in notes, cases and tools.
    </p>

    {
      ALPHABET.filter((l) => present.has(l)).map((l) => (
        <section class="gl-letter" aria-labelledby={`letter-${key(l)}`} data-letter-section={key(l)}>
          <h2 class="gl-letter__h" id={`letter-${key(l)}`}>
            {l === '#' ? '0 to 9' : l}
          </h2>
          <ul class="gl-list" role="list">
            {entries
              .filter(([, g]) => letterOf(g.term) === l)
              .map(([id, g]) => (
                <li
                  class={`gl-entry${isEnrichment(g) ? ' gl-entry--beyond' : ''}`}
                  id={`term-${id}`}
                  data-entry
                  data-text={searchKeys(g)}
                  data-units={unitsOf(g)}
                  data-level={g.level === 'HL' && !isEnrichment(g) ? 'hl' : 'sl'}
                  data-category={g.category ?? ''}
                  data-qualification={qualificationsOf(g).join(' ')}
                >
                  <h3 class="gl-entry__term">
                    <a href={href.glossary(id)}>{g.term}</a>
                  </h3>
                  {g.level === 'HL' && !isEnrichment(g) && <span class="tag tag--hl">HL</span>}
                  {isEnrichment(g) && <span class="tag tag--enrichment">Beyond IB</span>}
                  {g.subtopics.length > 0 && <span class="gl-entry__codes">{g.subtopics.map((s) => (s === 'toolkit' ? 'Toolkit' : s)).join(' · ')}</span>}
                  <p class="gl-entry__def" set:html={inline(g.definition)} />
                  {g.formula && <p class="gl-entry__formula">{g.formula}</p>}
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gl-key {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--sp-6);
    margin: 0 0 var(--sp-6);
    padding: var(--sp-4) 0;
    border-top: 2px solid var(--rule-ink);
    border-bottom: 1px solid var(--rule-hair);
  }

  .gl-key > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: baseline;
  }

  .gl-key dt {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    color: var(--gold-600);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .gl-key dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-body);
  }

  @media (max-width: 52rem) {
    .gl-key {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
    }
  }

  .gl-csv {
    margin: calc(var(--sp-6) * -1 + var(--sp-3)) 0 var(--sp-6);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .gl-search {
    display: grid;
    gap: var(--sp-2);
    max-width: 44rem;
  }

  .gl-search__hint,
  .gl-nojs {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .gl-search__row {
    display: flex;
    gap: var(--sp-2);
  }

  .gl-search input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--rule-control);
    border-radius: 999px;
    background: var(--surface-sheet);
    color: var(--text-strong);
    font: 400 1.0625rem/1.3 var(--font-ui);
  }

  .gl-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-5);
  }

  .gl-filter {
    display: grid;
    gap: 0.3rem;
  }

  .gl-filter select {
    min-height: 2.5rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--rule-control);
    border-radius: var(--radius-2);
    background: var(--surface-sheet);
    color: var(--text-strong);
    font: 500 0.9375rem/1.2 var(--font-ui);
    max-width: 20rem;
  }

  .gl-count {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .gl-az {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    margin-top: var(--sp-5);
    padding-block: var(--sp-2);
    background: rgba(246, 241, 231, 0.95);
    border-bottom: 1px solid var(--rule-hair);
  }

  .gl-az ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gl-az li {
    margin: 0;
  }

  .gl-az a,
  .gl-az span {
    display: inline-grid;
    place-items: center;
    min-width: 1.85rem;
    height: 1.85rem;
    border-radius: 4px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .gl-az a {
    color: var(--navy-900);
  }

  .gl-az a:hover {
    background: var(--navy-900);
    color: var(--text-on-ink);
  }

  .gl-az a.is-empty {
    color: var(--rule);
    pointer-events: none;
  }

  .gl-az span {
    color: var(--rule);
  }

  .gl-letter {
    scroll-margin-top: calc(var(--header-h) + 3.5rem);
  }

  .gl-letter[hidden] {
    display: none;
  }

  .gl-letter__h {
    margin-top: var(--sp-6);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--navy-900);
    font-size: 2.25rem;
    font-style: italic;
    font-weight: 400;
    color: var(--brass-text);
  }

  .gl-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 var(--sp-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gl-entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
    margin: 0;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .gl-entry[hidden] {
    display: none;
  }

  .gl-entry__def,
  .gl-entry__formula {
    flex-basis: 100%;
  }

  .gl-entry__term {
    font-size: 1.1875rem;
  }

  .gl-entry__term a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .gl-entry__term a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
  }

  .gl-entry__codes {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--brass-text);
    font-variant-numeric: tabular-nums;
  }

  .gl-entry__def {
    margin-top: 0.05rem;
    font-size: 0.9375rem;
    color: var(--text-body);
  }

  .gl-entry__formula {
    margin-top: 0.1rem;
    padding: 0.35rem 0.6rem;
    border-left: 2px solid var(--gold-500);
    background: var(--surface-gold-wash);
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--navy-900);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import '../../scripts/glossary';
</script>
