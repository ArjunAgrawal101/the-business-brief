---
/**
 * The head of an advanced tool's page: where it sits, what it is, the
 * question it answers and, before anything else, that it is advanced
 * financial management beyond the IB course, with the parts of the course it
 * builds on named in a notice the reader cannot miss.
 */
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import { ADVANCED_HREF, ibCodes, type AdvancedTool } from '../../lib/adv-finance/catalogue';
import { BUSINESS } from '../../lib/adv-finance/business';

interface Props {
  tool: AdvancedTool;
}
const { tool } = Astro.props;
const codes = ibCodes(tool).map((x) => (x === 'toolkit' ? 'the toolkit' : x));
---

<div class="wrap">
  <header class="fl-head af-head">
    <Breadcrumbs trail={[{ label: 'Finance Desk', href: '/finance-desk/' }, { label: 'Advanced financial management', href: ADVANCED_HREF }, { label: tool.name }]} />
    <p class="label label--ink fl-head__kicker">Advanced financial management · Beyond the IB course</p>
    <h1>{tool.name}</h1>
    <p class="lead fl-head__q">{tool.question}</p>
    <ul class="fl-scope" role="list">
      <li><span class="tag tag--enrichment">Beyond the IB course</span></li>
      <li>
        <span class="tag tag--ib">Builds on IB {codes.join(', ')}</span>
      </li>
      <li>
        <span class="tag tag--plain">Undergraduate, MBA, professional and teacher</span>
      </li>
      <li>
        <span class="tag tag--simulated">Simulated data</span>
        <span class="fl-scope__text">Example: {BUSINESS.name}, fictional</span>
      </li>
    </ul>
  </header>
</div>

<div class="wrap">
  <aside class="callout callout--enrichment af-notice" aria-labelledby={`af-notice-${tool.id}`}>
    <span class="callout__kicker" id={`af-notice-${tool.id}`}>Advanced financial management, not IB content</span>
    <p>
      This tool goes beyond the IB Business Management course. The IB course uses only part of it, which is marked <span class="tag tag--ib">IB</span> or <span
        class="tag tag--hl">IB HL</span
      > wherever it appears; everything marked <span class="tag tag--enrichment">Beyond the IB course</span> is not in the syllabus, is not assessed by the IB and
      should not be mistaken for it: in an IB examination, use the guide’s methods and formulas. <a href="#where-the-course-stops">Where the IB course stops</a> sets out the line.
    </p>
  </aside>
</div>
