---
/**
 * The executive simulation: nine stages and the debrief. Every stage is
 * rendered here, complete: without JavaScript the page is a casebook with the
 * evidence, every question and its answer, and the worked example's three
 * years and debrief. With JavaScript (src/scripts/executive.ts) the learner
 * chooses a role, works through one stage at a time, sets and commits a plan
 * for each year, and gets a debrief that compares their plan with the
 * strategies', all worked by the same engine in the browser. Progress is kept
 * on this device only, under bb:executive.
 */
import '../../styles/boardroom.css';
import '../../styles/executive.css';
import ProvenanceTag from '../ui/ProvenanceTag.astro';
import Question from './Question.astro';
import { describeSeries, trendChart } from '../../lib/boardroom/charts';
import type { KpiId } from '../../lib/executive/engine';
import { buildConfig } from '../../lib/executive/config';
import { fmtKpi, fmtMoneyCompact, fmtPrice, KPI_DEFS } from '../../lib/executive/kpis';
import { fmtNumber } from '../../lib/format';
import {
  attributionHtml,
  beforeAfterHtml,
  CASH_ROWS,
  comparisonHtml,
  figuresTable,
  fxHtml,
  kpiTiles,
  leverValue,
  planTableHtml,
  PL_ROWS,
  POSITION_ROWS,
  profitBarsHtml,
  ratiosHtml,
  scorecardHtml,
  statementHtml,
  yearResultHtml,
} from '../../lib/executive/render';
import { figureValue, runPlan, scorecard, summarize } from '../../lib/executive/sim';
import { BUDGET_LEVERS, LEVER_HINTS, LEVER_IDS, LEVER_LABELS, ROLE_IDS, ROLE_TITLES } from '../../lib/executive/roles';
import type { Executive, QuestionDef } from '../../lib/executive/schema';
import { labelled, type ExecView } from '../../lib/executive/view';
import { fillTokens } from '../../lib/executive/narrate';
import { href } from '../../lib/content';
import { inline, jsonForScript, rich } from '../../lib/markup';

interface Props {
  id: string;
  sc: Executive;
  view: ExecView;
  pageHref: string;
  subtopics: Record<string, { href: string; title: string; hl: boolean }>;
  glossary: Record<string, string>;
  commandTerms: Record<string, string>;
  sources: Record<string, { title: string; author?: string; year?: string; publisher?: string }>;
}
const { id, sc, view, pageHref, subtopics, glossary, commandTerms, sources } = Astro.props;
const { ctx, history, last, walk } = view;
const config = buildConfig(id, sc, view, pageHref);
const unit = `${ctx.symbol}000`;
const labels = history.map((y) => y.label);
const span = `${labels[0]} to ${labels[labels.length - 1]}`;
const stages = sc.stages;

/* The answer to a number question, in its unit. */
const answerText = (q: QuestionDef, years = history): string | undefined => {
  if (q.kind !== 'number') return undefined;
  const v = figureValue(q.answer, years);
  if (v === null) return undefined;
  if (q.unit === 'percent') return `${fmtNumber(v, 1)}%`;
  if (q.unit === 'money') return fmtMoneyCompact(v, ctx.symbol);
  return fmtNumber(Math.round(v), 0) + (q.unit === 'units' ? ` ${ctx.units}` : '');
};
const toleranceText = (q: QuestionDef): string | undefined => {
  if (q.kind !== 'number') return undefined;
  if (q.unit === 'percent') return `${fmtNumber(q.tolerance, 2)} percentage points`;
  if (q.unit === 'money') return fmtMoneyCompact(q.tolerance, ctx.symbol);
  return `${fmtNumber(q.tolerance, 0)} ${q.unit === 'units' ? ctx.units : 'points'}`;
};

/* Stage 1: the history's trends */
const TRENDS: KpiId[] = ['revenue', 'pbit', 'profitMargin', 'netCash'];
const trends = TRENDS.map((k) => {
  const values = history.map((y) => y.kpis[k]);
  const fmt = (v: number) => fmtKpi(k, v, ctx);
  const tick = (v: number) => fmt(v).replace(/\.0+(?=m\b|%|$)/, '');
  return { k, svg: trendChart(values, { id: `ex-tr-${k}`, title: KPI_DEFS[k].label, desc: describeSeries(KPI_DEFS[k].label, labels, values, fmt), labels, fmt: tick }) };
});

/* Stage 3: competitors, priced from the engine's competitors' average */
const compAvg = last.kpis.competitorPrice;
const othersShare = Math.max(0, 100 - last.kpis.marketShare - stages.market.competitors.reduce((a, c) => a + c.share, 0));

/* Stage 8 and the debrief: the worked example */
const walkYears = walk.run.years;
const walkAll = [...history, ...walkYears];
const walkFinal = walkYears[walkYears.length - 1] ?? last;
const evalQ = stages.evaluate.question;
const walkFill = (t: string) => fillTokens(t, { years: walkAll, focus: walkFinal, derived: view.derived }, ctx);
const intl = view.strategies.find((x) => x.s.plan.some((l) => l.international > 0));
const intlFx = intl
  ? { stronger: summarize(sc, runPlan(sc, intl.s.plan, { fxShift: 8 })), weaker: summarize(sc, runPlan(sc, intl.s.plan, { fxShift: -8 })) }
  : undefined;
const AREA_WORDS = { finance: 'Finance', marketing: 'Customers', operations: 'Workshop', people: 'People', external: 'Outside' } as const;
const VERDICT = { cause: 'A cause', partial: 'Partly a cause', not: 'Not a cause' } as const;
const FIT = { strong: 'A strong fit with the evidence', conditional: 'A conditional fit', weak: 'A weak fit with the evidence' } as const;
const POWER = { high: 'High power', medium: 'Medium power', low: 'Low power' } as const;
const ibList = (codes: string[]) => codes.map((c) => ({ code: c, ...(subtopics[c] ?? { href: '/topics/', title: c, hl: false }) }));
const EVAL_KPIS: KpiId[] = ['revenue', 'pbit', 'profitMargin', 'roce', 'netCash', 'marketShare', 'brand', 'quality', 'morale', 'turnover'];
---

<div class="ex-sim" data-ix="executive" id="ex-sim">
  <script type="application/json" data-config set:html={jsonForScript(config)} />
  <p class="state state--error" data-error hidden>
    The simulation could not start in this browser. Every stage is below with its answers, and the worked example plays the three years with the engine's figures.
  </p>

  <section class="ex-brief" id="brief" aria-labelledby="ex-brief-h">
    <h2 class="ex-brief__title" id="ex-brief-h">The brief</h2>
    <div class="bb-brief">
      <div class="bb-brief__story narrative">
        {sc.background.map((p) => <Fragment set:html={rich(view.fill(p))} />)}
      </div>
      <aside class="bb-brief__side" aria-labelledby="ex-facts-h">
        <h3 class="label label--ink" id="ex-facts-h">The company</h3>
        <dl class="ex-facts">
          <div><dt>Industry</dt><dd>{sc.company.industry}</dd></div>
          <div><dt>Location</dt><dd>{sc.company.location}</dd></div>
          <div><dt>Founded</dt><dd>{sc.company.founded}</dd></div>
          <div><dt>Size</dt><dd>{sc.company.size}</dd></div>
          <div><dt>Ownership</dt><dd>{sc.company.owners}</dd></div>
          <div><dt>Figures in</dt><dd>{sc.currency.name.charAt(0).toUpperCase() + sc.currency.name.slice(1)} ({sc.currency.symbol})</dd></div>
        </dl>
        <p class="small muted">The company, its people, its competitors and its distributor are fictional, and every figure is simulated.</p>
      </aside>
    </div>
    <details class="disclosure nojs-only ex-allroles">
      <summary>The seven roles' briefings</summary>
      <div class="disclosure__body">
        {
          ROLE_IDS.map((r) => (
            <section class="ex-roleblock" aria-labelledby={`ex-rb-${r}`}>
              <h3 class="ex-roleblock__title" id={`ex-rb-${r}`}>{ROLE_TITLES[r]}</h3>
              <div class="prose small" set:html={rich(view.fill(sc.roles[r].brief))} />
              <p class="ex-roleblock__label">Judged on</p>
              <ul class="small">{sc.roles[r].goals.map((g) => <li>{g.label}</li>)}</ul>
            </section>
          ))
        }
      </div>
    </details>
  </section>

  <section class="ex-roles js-only" data-roles aria-labelledby="ex-roles-h">
    <h2 class="ex-roles__title" id="ex-roles-h" tabindex="-1">Choose your role</h2>
    <p class="ex-roles__lead">
      The decisions are the executive team's. Your role sets the measures you watch most closely, what each stage asks you to look for first, and the goals you are judged on at the end. The roles' goals pull
      in different directions: no plan meets every goal of every role.
    </p>
    <fieldset class="ex-rolepick">
      <legend class="sr-only">Your role</legend>
      {
        ROLE_IDS.map((r) => (
          <div class="ex-rolecard">
            <input type="radio" name="ex-role" id={`ex-role-${r}`} value={r} aria-describedby={`ex-role-${r}-d`} />
            <label for={`ex-role-${r}`}>
              <span class="ex-rolecard__title">{ROLE_TITLES[r]}</span>
              <span class="ex-rolecard__watch" id={`ex-role-${r}-d`}>
                Watches {sc.roles[r].pinned.map((k) => KPI_DEFS[k as KpiId].short.toLowerCase()).join(', ')}
              </span>
            </label>
          </div>
        ))
      }
    </fieldset>
    <div class="bb-actions">
      <button type="button" class="btn btn--primary" data-act="role">Take this role</button>
      <span class="field__error" data-role-msg></span>
    </div>
  </section>

  <div class="ex-play js-only" data-play hidden>
    <section class="bb-board ex-dash" aria-labelledby="ex-dash-h">
      <div class="bb-board__head">
        <h2 class="bb-board__title" id="ex-dash-h">Executive dashboard <span class="bb-board__when" data-dash-when>{last.label}</span></h2>
        <p class="bb-board__seat" data-dash-role></p>
        <ProvenanceTag kind="simulated-data" />
      </div>
      <div data-dash-tiles set:html={kpiTiles(history, sc.dashboard as KpiId[], [], ctx, 'exd', history.length)} />
      <details class="bb-board__table">
        <summary>Every figure by year</summary>
        <div data-dash-table set:html={figuresTable(history, sc.dashboard as KpiId[], ctx, 'Dashboard figures by year', history.length)} />
      </details>
    </section>
    <section class="ex-briefing" data-briefing aria-labelledby="ex-briefing-h">
      <h2 class="ex-briefing__title" id="ex-briefing-h" tabindex="-1">Your briefing</h2>
      <div data-briefing-body></div>
    </section>
    <nav class="ex-railwrap" aria-label="Stages of the simulation">
      <ol class="ex-rail" data-rail></ol>
    </nav>
    <div class="ex-restart">
      <button type="button" class="btn btn--small" data-act="change-role">Change role</button>
      <button type="button" class="btn btn--small" data-act="restart">Start again</button>
    </div>
  </div>

  <p class="ex-casebook-note nojs-only">
    This is the casebook of the simulation: every stage with its evidence and questions, the answers in the disclosures, and a worked example that plays the three years with the engine's figures.
    With JavaScript you choose a role, answer each stage, set your own plan for each year and compare it with every strategy.
  </p>

  {/* ------------------------------------------------------------ Stage 1 */}
  <section class="ex-stage" data-stage="finance" id="stage-finance" aria-labelledby="stage-finance-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 1 of 9</p>
      <h2 class="ex-stage__title" id="stage-finance-h" tabindex="-1">{stages.finance.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.finance.lead))} />
      <p class="ex-lens" data-lens hidden></p>
      <figure class="bb-exhibit" aria-labelledby="ex-pl-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 1</span><h3 class="bb-exhibit__title" id="ex-pl-h">Statement of profit or loss, {span}</h3><ProvenanceTag kind="simulated-data" /></div>
        <Fragment set:html={statementHtml(PL_ROWS, view.statements.pl, `Statement of profit or loss, ${unit}`, unit, 'ex-pl')} />
        <figcaption class="bb-exhibit__source">In {sc.currency.name}, thousands; figures in brackets are negative. Cost of sales is the materials, delivery and other inputs bought for each {sc.units.singular}, with returns and remakes; the makers' wages are expenses.</figcaption>
      </figure>
      <figure class="bb-exhibit" aria-labelledby="ex-sofp-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 2</span><h3 class="bb-exhibit__title" id="ex-sofp-h">Statement of financial position</h3><ProvenanceTag kind="simulated-data" /></div>
        <Fragment set:html={statementHtml(POSITION_ROWS, view.statements.position, `Statement of financial position, ${unit}`, unit, 'ex-sofp')} />
        <figcaption class="bb-exhibit__source">In {sc.currency.name}, thousands. Net assets equal total equity in every column; the tests check it.</figcaption>
      </figure>
      <figure class="bb-exhibit" aria-labelledby="ex-cf-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 3</span><h3 class="bb-exhibit__title" id="ex-cf-h">Cash flow, {span}</h3><ProvenanceTag kind="simulated-data" /></div>
        <Fragment set:html={statementHtml(CASH_ROWS, view.statements.cash, `Cash flow, ${unit}`, unit, 'ex-cf')} />
        <figcaption class="bb-exhibit__source">Starting from profit and adjusting for depreciation and working capital (the indirect method). Upkeep is what was spent keeping the mill's machinery in repair.</figcaption>
      </figure>
      <figure class="bb-exhibit" aria-labelledby="ex-trends-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 4</span><h3 class="bb-exhibit__title" id="ex-trends-h">Four years in four lines</h3><ProvenanceTag kind="simulated-data" /></div>
        <div class="bb-trends">
          {
            trends.map((t) => (
              <div class="bb-trend-cell">
                <p class="bb-trend-cell__label">{KPI_DEFS[t.k].label}</p>
                <Fragment set:html={t.svg} />
              </div>
            ))
          }
        </div>
        <details class="disclosure">
          <summary>The figures behind the lines</summary>
          <div class="disclosure__body" set:html={figuresTable(history, TRENDS, ctx, 'Revenue, operating profit, profit margin and net cash by year', history.length)} />
        </details>
      </figure>
      <div class="ex-questions">
        {stages.finance.questions.map((q, i) => <Question q={q} fill={view.fill} answerText={answerText(q)} toleranceText={toleranceText(q)} no={i + 1} />)}
      </div>
      <figure class="bb-exhibit ex-after" data-after aria-labelledby="ex-ratios-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 5</span><h3 class="bb-exhibit__title" id="ex-ratios-h">Ratios, {span}</h3><ProvenanceTag kind="simulated-data" /></div>
        <p class="ex-after__note js-only">This exhibit opens once you have checked both answers above, so that you work the margin out first.</p>
        <div class="ex-after__body" data-after-body>
          <Fragment set:html={ratiosHtml(history, ctx, 'ex-ratios', `Ratios, ${span}`)} />
          <p class="hl-notice"><span class="tag tag--hl">HL</span> The efficiency ratios and gearing are HL only, and are hidden while you are viewing SL content.</p>
          <figcaption class="bb-exhibit__source">The guide's formulas (pp. 64 to 65). Stock days use closing stock.</figcaption>
        </div>
      </figure>
      {stages.finance.hlNote && <div class="ex-hl small" data-level="HL"><span class="tag tag--hl">HL</span> <span set:html={inline(view.fill(stages.finance.hlNote))} /></div>}
      <p class="ex-ib small">In the IB course: {ibList(stages.finance.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
      <div class="bb-actions js-only"><button type="button" class="btn btn--primary" data-act="next" data-stage="finance">Continue to stage 2</button><span class="field__error" data-next-msg></span></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 2 */}
  <section class="ex-stage" data-stage="causes" id="stage-causes" aria-labelledby="stage-causes-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 2 of 9</p>
      <h2 class="ex-stage__title" id="stage-causes-h" tabindex="-1">{stages.causes.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.causes.lead))} />
      <p class="ex-lens" data-lens hidden></p>
      <fieldset class="ex-q ex-evidence" data-q="causes" data-kind="causes" aria-describedby="q-causes-msg">
        <legend class="ex-q__prompt">Which of these explain the fall in Corvell's profitability? Choose at least {stages.causes.min}.</legend>
        <ul class="ex-cards" role="list">
          {
            stages.causes.evidence.map((e) => (
              <li class={`ex-card ex-card--${e.area}`} data-ev={e.id}>
                <input type="checkbox" name="ev" id={`ev-${e.id}`} value={e.id} />
                <label for={`ev-${e.id}`}>
                  <span class="ex-card__area">{AREA_WORDS[e.area]}</span>
                  <span class="ex-card__title">{e.title}</span>
                  <span class="ex-card__text" set:html={inline(view.fill(e.text))} />
                </label>
                <p class="ex-card__mark" data-mark hidden />
                <details class="ex-answer" data-answer>
                  <summary>Cause or not?<span class="sr-only"> {e.title}</span></summary>
                  <div class="ex-answer__body">
                    <p class={`ex-verdict-tag ex-verdict-tag--${e.verdict}`}>{VERDICT[e.verdict]}</p>
                    <p set:html={inline(view.fill(e.feedback))} />
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
        <div class="ex-q__actions js-only"><button type="button" class="btn btn--small" data-act="check" data-q="causes">Check my diagnosis</button><span class="field__error" id="q-causes-msg" data-msg></span></div>
        <div class="ex-verdict" data-verdict hidden></div>
      </fieldset>
      {stages.causes.hlNote && <div class="ex-hl small" data-level="HL"><span class="tag tag--hl">HL</span> <span set:html={inline(view.fill(stages.causes.hlNote))} /></div>}
      <p class="ex-ib small">In the IB course: {ibList(stages.causes.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
      <div class="bb-actions js-only"><button type="button" class="btn btn--primary" data-act="next" data-stage="causes">Continue to stage 3</button><span class="field__error" data-next-msg></span></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 3 */}
  <section class="ex-stage" data-stage="market" id="stage-market" aria-labelledby="stage-market-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 3 of 9</p>
      <h2 class="ex-stage__title" id="stage-market-h" tabindex="-1">{stages.market.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.market.lead))} />
      <p class="ex-lens" data-lens hidden></p>
      <figure class="bb-exhibit" aria-labelledby="ex-mkt-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 6</span><h3 class="bb-exhibit__title" id="ex-mkt-h">The home market and Corvell's place in it</h3><ProvenanceTag kind="simulated-data" /></div>
        <Fragment set:html={figuresTable(history, ['marketSize', 'homeVolume', 'marketShare', 'price', 'competitorPrice', 'relativePrice', 'marketing', 'brand'], ctx, 'The home market by year', history.length)} />
        <figcaption class="bb-exhibit__source">The market is the premium solid-wood furniture market at home, in pieces. Brand strength is from the annual customer survey.</figcaption>
      </figure>
      <figure class="bb-exhibit" aria-labelledby="ex-comp-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 7</span><h3 class="bb-exhibit__title" id="ex-comp-h">Competitors in {last.label}</h3><ProvenanceTag kind="simulated-data" /></div>
        <div class="table-scroll" role="region" aria-labelledby="ex-comp-h" tabindex="0">
          <table class="table">
            <thead><tr><th scope="col">Maker</th><th scope="col">Position</th><th scope="col" class="n">Average price</th><th scope="col" class="n">Market share</th></tr></thead>
            <tbody>
              {
                stages.market.competitors.map((c) => (
                  <tr>
                    <th scope="row">{c.name}</th>
                    <td set:html={inline(view.fill(c.position))} />
                    <td class="n">{fmtPrice(c.priceRatio * compAvg, ctx.symbol)}</td>
                    <td class="n">{fmtNumber(c.share, 1)}%</td>
                  </tr>
                ))
              }
              <tr class="bb-mkt__us"><th scope="row">{sc.company.name}</th><td>Made to order in oak and walnut at Wexley Bridge.</td><td class="n">{fmtKpi('price', last.kpis.price, ctx)}</td><td class="n">{fmtKpi('marketShare', last.kpis.marketShare, ctx)}</td></tr>
              <tr><th scope="row">Other makers</th><td>Many small workshops and importers.</td><td class="n">n/a</td><td class="n">{fmtNumber(othersShare, 1)}%</td></tr>
            </tbody>
          </table>
        </div>
        <figcaption class="bb-exhibit__source">Every competitor is fictional. Prices are averages across comparable pieces.</figcaption>
      </figure>
      <figure class="bb-exhibit" aria-labelledby="ex-offer-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 8</span><h3 class="bb-exhibit__title" id="ex-offer-h">The offer from abroad</h3><ProvenanceTag kind="simulated-data" /></div>
        <div class="prose" set:html={rich(view.fill(stages.market.opportunity))} />
      </figure>
      <div class="ex-questions">
        {stages.market.questions.map((q, i) => <Question q={q} fill={view.fill} answerText={answerText(q)} toleranceText={toleranceText(q)} no={i + 1} />)}
      </div>
      {stages.market.hlNote && <div class="ex-hl small" data-level="HL"><span class="tag tag--hl">HL</span> <span set:html={inline(view.fill(stages.market.hlNote))} /></div>}
      <p class="ex-ib small">In the IB course: {ibList(stages.market.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
      <div class="bb-actions js-only"><button type="button" class="btn btn--primary" data-act="next" data-stage="market">Continue to stage 4</button><span class="field__error" data-next-msg></span></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 4 */}
  <section class="ex-stage" data-stage="operations" id="stage-operations" aria-labelledby="stage-operations-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 4 of 9</p>
      <h2 class="ex-stage__title" id="stage-operations-h" tabindex="-1">{stages.operations.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.operations.lead))} />
      <p class="ex-lens" data-lens hidden></p>
      <figure class="bb-exhibit" aria-labelledby="ex-ops-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 9</span><h3 class="bb-exhibit__title" id="ex-ops-h">The workshop, {span}</h3><ProvenanceTag kind="simulated-data" /></div>
        <Fragment set:html={figuresTable(history, ['plantCapacity', 'normalCapacity', 'capacity', 'volume', 'load', 'utilization', 'overtimeHours', 'productivity', 'returnsRate', 'quality'], ctx, 'The workshop by year', history.length)} />
        <figcaption class="bb-exhibit__source">
          Capacity in normal hours is what the workforce can make at its current skill and morale, or the plant's limit if that is lower; productive capacity adds the overtime allowed, up to {fmtNumber(sc.model.overtimeMax * 100, 0)}% more hours. Utilization is output as a share of productive capacity; load is output as a share of normal-hours capacity.
        </figcaption>
      </figure>
      <div class="ex-questions">
        {stages.operations.questions.map((q, i) => <Question q={q} fill={view.fill} answerText={answerText(q)} toleranceText={toleranceText(q)} no={i + 1} />)}
      </div>
      {stages.operations.hlNote && <div class="ex-hl small" data-level="HL"><span class="tag tag--hl">HL</span> <span set:html={inline(view.fill(stages.operations.hlNote))} /></div>}
      <p class="ex-ib small">In the IB course: {ibList(stages.operations.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
      <div class="bb-actions js-only"><button type="button" class="btn btn--primary" data-act="next" data-stage="operations">Continue to stage 5</button><span class="field__error" data-next-msg></span></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 5 */}
  <section class="ex-stage" data-stage="people" id="stage-people" aria-labelledby="stage-people-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 5 of 9</p>
      <h2 class="ex-stage__title" id="stage-people-h" tabindex="-1">{stages.people.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.people.lead))} />
      <p class="ex-lens" data-lens hidden></p>
      <figure class="bb-exhibit" aria-labelledby="ex-ppl-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 10</span><h3 class="bb-exhibit__title" id="ex-ppl-h">The workforce, {span}</h3><ProvenanceTag kind="simulated-data" /></div>
        <Fragment set:html={figuresTable(history, ['headcount', 'leavers', 'turnover', 'morale', 'skill', 'productivity'], ctx, 'The workforce by year', history.length)} />
        <figcaption class="bb-exhibit__source">Morale is from the annual staff survey. Every leaver was replaced; a new starter makes about half as much as an experienced maker in the first year.</figcaption>
      </figure>
      <figure class="bb-exhibit" aria-labelledby="ex-stake-h">
        <div class="bb-exhibit__head"><span class="bb-exhibit__no">Exhibit 11</span><h3 class="bb-exhibit__title" id="ex-stake-h">The stakeholders and what they say</h3><ProvenanceTag kind="simulated-data" /></div>
        <ul class="bb-stakes" role="list">
          {
            sc.stakeholders.map((s) => (
              <li class="bb-stake">
                <p class="bb-stake__name">{s.name}</p>
                <p class="bb-stake__meta">{POWER[s.power]}</p>
                <p class="bb-stake__interest" set:html={inline(view.fill(s.interest))} />
                <blockquote class="bb-stake__view" set:html={rich(view.fill(s.view))} />
              </li>
            ))
          }
        </ul>
        <figcaption class="bb-exhibit__source">Every person and organization here is fictional.</figcaption>
      </figure>
      <div class="ex-questions">
        {stages.people.questions.map((q, i) => <Question q={q} fill={view.fill} answerText={answerText(q)} toleranceText={toleranceText(q)} no={i + 1} />)}
      </div>
      {stages.people.hlNote && <div class="ex-hl small" data-level="HL"><span class="tag tag--hl">HL</span> <span set:html={inline(view.fill(stages.people.hlNote))} /></div>}
      <p class="ex-ib small">In the IB course: {ibList(stages.people.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
      <div class="bb-actions js-only"><button type="button" class="btn btn--primary" data-act="next" data-stage="people">Continue to stage 6</button><span class="field__error" data-next-msg></span></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 6 */}
  <section class="ex-stage" data-stage="strategy" id="stage-strategy" aria-labelledby="stage-strategy-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 6 of 9</p>
      <h2 class="ex-stage__title" id="stage-strategy-h" tabindex="-1">{stages.strategy.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.strategy.lead))} />
      <p class="ex-lens" data-lens hidden></p>
      <fieldset class="ex-q ex-strategies" data-q="strategy" data-kind="strategy" aria-describedby="q-strategy-msg">
        <legend class="ex-q__prompt">Which strategy will you lead with?</legend>
        <ol class="ex-strats" role="list">
          {
            sc.strategies.map((s) => (
              <li class="ex-strat" data-strat={s.id}>
                <div class="ex-strat__pick">
                  <input type="radio" name="ex-strategy" id={`st-${s.id}`} value={s.id} aria-describedby={`st-${s.id}-s`} />
                  <label for={`st-${s.id}`}>{s.label}</label>
                </div>
                <div class="prose small" id={`st-${s.id}-s`} set:html={rich(view.fill(s.summary))} />
                <p class="ex-strat__label">What it would take</p>
                <ul class="bb-involves">{s.involves.map((x) => <li set:html={inline(view.fill(x))} />)}</ul>
                <p class="ex-strat__label">The risks</p>
                <div class="prose small" set:html={rich(view.fill(s.risks))} />
                <details class="disclosure ex-strat__plan">
                  <summary>Its plan, year by year<span class="sr-only">: {s.label}</span></summary>
                  <div class="disclosure__body" set:html={planTableHtml(labelled(sc, s.plan), ctx, `The plan for ${s.label}`, sc.rules.budget)} />
                </details>
                <details class="ex-answer" data-answer>
                  <summary>How well it fits the evidence<span class="sr-only">: {s.label}</span></summary>
                  <div class="ex-answer__body">
                    <p class={`ex-verdict-tag ex-verdict-tag--${s.fit}`}>{FIT[s.fit]}</p>
                    <div class="prose small" set:html={rich(view.fill(s.feedback))} />
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
        <div class="ex-q__actions js-only"><button type="button" class="btn btn--small" data-act="check" data-q="strategy">Lead with this strategy</button><span class="field__error" id="q-strategy-msg" data-msg></span></div>
        <div class="ex-verdict" data-verdict hidden></div>
      </fieldset>
      <p class="ex-ib small">In the IB course: {ibList(stages.strategy.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
      <div class="bb-actions js-only"><button type="button" class="btn btn--primary" data-act="next" data-stage="strategy">Continue to stage 7</button><span class="field__error" data-next-msg></span></div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 7 */}
  <section class="ex-stage" data-stage="allocate" id="stage-allocate" aria-labelledby="stage-allocate-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 7 of 9</p>
      <h2 class="ex-stage__title" id="stage-allocate-h" tabindex="-1">{stages.allocate.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.allocate.lead))} />
      <div class="ex-rules">
        <section aria-labelledby="ex-levers-h">
          <h3 class="label label--ink" id="ex-levers-h">The six levers</h3>
          <div class="table-scroll" role="region" aria-labelledby="ex-levers-h" tabindex="0">
            <table class="table ex-levers">
              <thead><tr><th scope="col">Lever</th><th scope="col">Range</th><th scope="col">In {last.label}</th><th scope="col">What it does</th></tr></thead>
              <tbody>
                {
                  LEVER_IDS.map((l) => (
                    <tr>
                      <th scope="row">{LEVER_LABELS[l]}</th>
                      <td class="ex-levers__range">{leverValue(l, sc.rules[l].min, ctx)} to {leverValue(l, sc.rules[l].max, ctx)}</td>
                      <td>{leverValue(l, sc.history[sc.history.length - 1]?.levers[l] ?? 0, ctx)}</td>
                      <td>{LEVER_HINTS[l]}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="small">Marketing, capacity, people and international share the year's budget of {fmtMoneyCompact(sc.rules.budget, ctx.symbol)}: {BUDGET_LEVERS.length} levers, one pot. Whatever is not spent stays in the bank.</p>
        </section>
        <aside class="ex-assume" aria-labelledby="ex-assume-h">
          <h3 class="label label--ink" id="ex-assume-h">The board's planning assumptions</h3>
          <div class="prose small" set:html={rich(view.fill(sc.assumptions))} />
          <div class="prose small" set:html={rich(view.fill(sc.mandate))} />
        </aside>
      </div>
      <div class="js-only" data-form-slot></div>
      <div class="nojs-only ex-walkplan">
        <h3 class="ex-sub">In the worked example: {walk.s.label}</h3>
        <div class="prose small" set:html={rich(view.fill(sc.walkthrough.intro))} />
        <Fragment set:html={planTableHtml(labelled(sc, walk.s.plan), ctx, `The worked example's plan: ${walk.s.label}`, sc.rules.budget)} />
      </div>
      <p class="ex-ib small">In the IB course: {ibList(stages.allocate.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 8 */}
  <section class="ex-stage" data-stage="implement" id="stage-implement" aria-labelledby="stage-implement-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 8 of 9</p>
      <h2 class="ex-stage__title" id="stage-implement-h" tabindex="-1">{stages.implement.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.implement.lead))} />
      <div class="js-only" data-years></div>
      <div class="nojs-only ex-walk">
        <h3 class="ex-sub">The worked example, year by year</h3>
        {
          walkYears.map((r, k) => {
            const prev = k === 0 ? last : walkYears[k - 1] ?? last;
            const news = config.news[r.label];
            return <Fragment set:html={yearResultHtml(r, prev, ctx, { level: 4, id: `wk-${r.label}`, news })} />;
          })
        }
        <h4 class="label label--ink">The dashboard at the end of the worked example</h4>
        <div class="bb-board bb-board--pack" set:html={kpiTiles(walkAll, sc.dashboard as KpiId[], [], ctx, 'wk-tile', history.length)} />
      </div>
      <p class="ex-ib small">In the IB course: {ibList(stages.implement.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
    </div>
  </section>

  {/* ------------------------------------------------------------ Stage 9 */}
  <section class="ex-stage" data-stage="evaluate" id="stage-evaluate" aria-labelledby="stage-evaluate-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">Stage 9 of 9</p>
      <h2 class="ex-stage__title" id="stage-evaluate-h" tabindex="-1">{stages.evaluate.title}</h2>
      <div class="ex-stage__state js-only" data-state></div>
    </header>
    <div class="ex-stage__body" data-body>
      <div class="prose ex-stage__lead" set:html={rich(view.fill(stages.evaluate.lead))} />
      <div class="js-only" data-eval></div>
      <div class="nojs-only ex-walkeval">
        <h3 class="ex-sub">The worked example, {last.label} against {walkFinal.label}</h3>
        <Fragment set:html={beforeAfterHtml(last, walkFinal, EVAL_KPIS, ctx, `The worked example: ${last.label} against ${walkFinal.label}`)} />
        <h4 class="label label--ink">How each role's goals came out</h4>
        <div class="bb-scores">{ROLE_IDS.map((r) => <Fragment set:html={scorecardHtml(r, scorecard(sc, walk.run, r), ctx, 5)} />)}</div>
        <Question q={{ ...evalQ, id: `walk-${evalQ.id}` }} fill={walkFill} answerText={answerText(evalQ, walkAll)} toleranceText={toleranceText(evalQ)} no={1} />
        <ol class="ex-reflect">
          {stages.evaluate.reflections.map((r) => <li><strong>{r.label}.</strong> {r.hint}</li>)}
        </ol>
      </div>
      <p class="ex-ib small">In the IB course: {ibList(stages.evaluate.ib).map((x, i) => <>{i > 0 && ', '}<a href={x.href}><span class="num">{x.code}</span> {x.title}</a>{x.hl && <span class="tag tag--hl">HL</span>}</>)}</p>
    </div>
  </section>

  {/* ------------------------------------------------------------ Debrief */}
  <section class="ex-stage ex-debrief" data-stage="debrief" id="debrief" aria-labelledby="debrief-h">
    <header class="ex-stage__head">
      <p class="ex-stage__no">After the plan</p>
      <h2 class="ex-stage__title" id="debrief-h" tabindex="-1">The debrief</h2>
    </header>
    <div class="ex-stage__body" data-body>
      <p class="bb-locked js-only" data-debrief-locked>The debrief opens when the evaluation is done, so that the comparisons do not steer your plan.</p>
      <div class="js-only" data-yours></div>
      <div class="ex-debrief__fixed" data-debrief-body>
        <div class="bb-debrief__summary prose" set:html={rich(view.fill(sc.debrief.summary))} />

        <div class="nojs-only ex-walkdebrief">
          <h3 class="bb-debrief__h">The worked example against the other strategies</h3>
          <p class="small muted">Each plan is played from the same start by the same engine.</p>
          <Fragment set:html={comparisonHtml(view.compareRows.map((r) => ({ ...r, mine: r.label === walk.s.label })), ctx, 'Every strategy compared')} />
          <figure class="ex-figure">
            <Fragment set:html={profitBarsHtml(view.compareRows.map((r) => ({ ...r, mine: r.label === walk.s.label })), ctx, 'ex-bars-walk')} />
            <figcaption class="bb-exhibit__source">Profit after tax over the three years; the worked example is marked. The figures are in the table above.</figcaption>
          </figure>
          <h4 class="label label--ink">The worked example, lever by lever</h4>
          <p class="small">Each row runs the worked example again with one lever kept at its {last.label} level in every year, and shows what that lever added. The levers work on each other, so the rows need not add up.</p>
          <Fragment set:html={attributionHtml(view.walkAttribution, ctx, 'What each lever of the worked example did', sc.plan[0]?.label ?? '', sc.plan[sc.plan.length - 1]?.label ?? '')} />
        </div>

        {
          intl && intlFx && (
            <>
              <h3 class="bb-debrief__h">The exchange rate as a risk</h3>
              <Fragment set:html={fxHtml(intl.s.label, intl.summary, intlFx.stronger, intlFx.weaker, 8, ctx)} />
            </>
          )
        }

        <h3 class="bb-debrief__h">The trade-offs</h3>
        <div class="bb-lessons">
          {
            sc.debrief.tradeoffs.map((t) => (
              <section class="bb-lesson">
                <h4 class="bb-lesson__title">{t.title}</h4>
                <div class="prose small" set:html={rich(view.fill(t.body))} />
              </section>
            ))
          }
        </div>

        <h3 class="bb-debrief__h">What each strategy teaches</h3>
        <div class="bb-lessons">
          {
            view.strategies.map((x) => (
              <section class="bb-lesson">
                <h4 class="bb-lesson__title">{x.s.label}</h4>
                <div class="prose small" set:html={rich(x.fill(x.s.lesson))} />
              </section>
            ))
          }
        </div>

        <h3 class="bb-debrief__h">In the IB course</h3>
        {sc.debrief.ib.some((t) => t.level === 'HL') && <p class="hl-notice"><span class="tag tag--hl">HL</span> Some of the theory below is HL only, and is hidden while you are viewing SL content.</p>}
        <div class="bb-theory">
          {
            sc.debrief.ib.map((t) => (
              <section class="bb-theory__card" data-level={t.level === 'HL' ? 'HL' : undefined}>
                <h4 class="bb-theory__title">
                  {t.title}
                  {t.level === 'HL' && <span class="tag tag--hl">HL</span>}
                </h4>
                <div class="prose small" set:html={rich(view.fill(t.body))} />
                <p class="bb-theory__codes">
                  {ibList(t.syllabus).map((x) => (
                    <a href={x.href} class="tag tag--plain">
                      {x.code} {x.title}
                    </a>
                  ))}
                </p>
              </section>
            ))
          }
        </div>

        <h3 class="bb-debrief__h">Beyond the IB course</h3>
        <p class="small"><ProvenanceTag kind="enrichment" /> Ideas from management research that the IB course does not require, for undergraduate, MBA and professional readers and for curious IB students.</p>
        <div class="bb-theory ex-beyond">
          {
            sc.debrief.beyond.map((b) => (
              <section class="bb-theory__card">
                <h4 class="bb-theory__title">{b.title}</h4>
                <div class="prose small" set:html={rich(view.fill(b.body))} />
                <p class="ex-cite small">
                  {b.sources.map((s) => {
                    const src = sources[s];
                    const by = `${src?.author ?? ''}${src?.year ? ` (${src.year})` : ''}, `;
                    const where = src?.publisher ? `, ${src.publisher}` : '';
                    return (
                      <a href={href.source(s)}>{by}<em>{src?.title}</em>{where}</a>
                    );
                  })}
                </p>
              </section>
            ))
          }
        </div>

        <h3 class="bb-debrief__h">Misconceptions this tests</h3>
        <ul class="bb-misc">
          {
            sc.debrief.misconceptions.map((m) => (
              <li class="bb-misc__item">
                <p class="bb-misc__claim"><span class="bb-misc__label">The claim</span> {m.claim}</p>
                <div class="bb-misc__fix"><span class="bb-misc__label">The correction</span><div class="prose small" set:html={rich(view.fill(m.correction))} /></div>
              </li>
            ))
          }
        </ul>

        <h3 class="bb-debrief__h">Practice</h3>
        <p class="small"><ProvenanceTag kind="original-practice" /> The platform's own questions, written for this simulation; they are not IB questions. The questions in the stages above are the platform's own too.</p>
        {sc.debrief.practice.some((p) => p.level === 'HL') && <p class="hl-notice"><span class="tag tag--hl">HL</span> One or more questions are HL only, and are hidden while you are viewing SL content.</p>}
        <ol class="bb-practice">
          {
            sc.debrief.practice.map((p) => (
              <li data-level={p.level === 'HL' ? 'HL' : undefined}>
                <span set:html={inline(view.fill(p.prompt))} />{' '}
                <span class="bb-practice__meta">
                  [{p.marks} marks] <a href={href.commandTerm(commandTerms[p.command] ?? p.command)}>{commandTerms[p.command] ?? p.command}</a>
                  {p.level === 'HL' && <span class="tag tag--hl">HL</span>}
                </span>
              </li>
            ))
          }
        </ol>

        <h3 class="bb-debrief__h">Key terms</h3>
        <ul class="bb-terms">{sc.debrief.terms.map((t) => <li><a href={href.glossary(t)}>{glossary[t] ?? t}</a></li>)}</ul>

        <h3 class="bb-debrief__h">How the figures were made</h3>
        <div class="prose small" set:html={rich(view.fill(sc.method))} />
        <p class="small"><a href="/boardroom/executive/#model">How the executive simulation's model works: every link and lag</a></p>
      </div>
    </div>
  </section>
  <p class="sr-only" aria-live="polite" data-status></p>
</div>

<script>
  import '../../scripts/executive';
</script>
