---
/**
 * The board pack: every exhibit generated by the engine from the scenario's
 * starting position and history, so no figure here can disagree with the
 * simulation. Key figures with sparklines, the two statements in the guide's
 * order, the ratios, the trends with their table, the market and what
 * happened before the first decision.
 */
import ProvenanceTag from '../ui/ProvenanceTag.astro';
import Statement from './Statement.astro';
import { describeSeries, trendChart } from '../../lib/boardroom/charts';
import type { KpiId } from '../../lib/boardroom/engine';
import { fmtKpi, KPI_DEFS } from '../../lib/boardroom/kpis';
import { figuresTable, kpiTiles } from '../../lib/boardroom/render';
import { fillTokens } from '../../lib/boardroom/narrate';
import type { Scenario } from '../../lib/boardroom/schema';
import { packMeasures, PL_ROWS, POSITION_ROWS, RATIO_ROWS, type ScenarioView } from '../../lib/boardroom/view';
import { fmtNumber } from '../../lib/format';
import { inline, rich } from '../../lib/markup';

interface Props {
  id: string;
  sc: Scenario;
  view: ScenarioView;
}
const { id, sc, view } = Astro.props;
const { ctx, history, last } = view;
const labels = history.map((h) => h.label);
const unit = `${sc.currency.symbol}000`;
const trendIds: KpiId[] = ['revenue', 'pbit', 'netCash', 'utilization', 'morale', sc.sustainability ? 'emissionsPerUnit' : 'brand'];
const trends = trendIds.map((k) => {
  const values = history.map((h) => h.kpis[k]);
  const fmt = (v: number) => fmtKpi(k, v, ctx);
  // Axis ticks are round numbers: drop decimals that are only zeros (£1.00m to £1m, 50.0% to 50%).
  const tick = (v: number) => fmt(v).replace(/\.0+(?=m\b|%|$)/, '');
  return { id: k, svg: trendChart(values, { id: `bp-${id}-${k}`, title: KPI_DEFS[k].label, desc: describeSeries(KPI_DEFS[k].label, labels, values, fmt), labels: labels.map((l) => l.replace(/^Q(\d) (\d{4})$/, 'Q$1')), fmt: tick }) };
});
const share = last.kpis.marketShare;
const others = Math.max(0, 100 - share - sc.market.competitors.reduce((a, c) => a + c.share, 0));
const ratioCols = history;
---

<div class="bb-pack">
  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-k`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 1</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-k`}>Key figures at the end of {last.label}</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <div class="bb-board bb-board--pack">
      <Fragment set:html={kpiTiles(history, sc.dashboard as KpiId[], [], ctx, `bp-${id}-tile`, 0)} />
    </div>
    <figcaption class="bb-exhibit__source">
      Each line runs from {labels[0]} to {last.label}; changes are against {history[history.length - 2]?.label}. The full figures are in Exhibit 6.
    </figcaption>
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-pl-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 2</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-pl-h`}>Statement of profit or loss</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <Statement rows={PL_ROWS} columns={view.plColumns} caption={`Statement of profit or loss, ${unit}`} unit={unit} id={`bp-${id}-pl`} />
    <figcaption class="bb-exhibit__source">
      In {sc.currency.name}, thousands; figures in brackets are negative. Cost of sales is the materials, energy and other inputs bought for each {sc.units.singular}; all staff costs are in expenses.
    </figcaption>
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-sofp-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 3</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-sofp-h`}>Statement of financial position</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <Statement rows={POSITION_ROWS} columns={view.positionColumns} caption={`Statement of financial position, ${unit}`} unit={unit} id={`bp-${id}-sofp`} />
    <figcaption class="bb-exhibit__source">In {sc.currency.name}, thousands. Net assets equal total equity in every column; the tests check it.</figcaption>
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-ratios-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 4</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-ratios-h`}>Ratios</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <div class="table-scroll" role="region" aria-labelledby={`bp-${id}-ratios-h`} tabindex="0">
      <table class="table bb-figures">
        <thead>
          <tr>
            <th scope="col">Ratio</th>
            {ratioCols.map((h) => <th scope="col" class="n">{h.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            RATIO_ROWS.map(([k, hl]) => (
              <tr data-level={hl ? 'HL' : undefined}>
                <th scope="row">
                  {KPI_DEFS[k].label}
                  {hl && <span class="tag tag--hl">HL</span>}
                  <span class="bb-formula">{KPI_DEFS[k].formula}</span>
                </th>
                {ratioCols.map((h) => (
                  <td class="n">{fmtKpi(k, h.kpis[k], ctx)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="hl-notice"><span class="tag tag--hl">HL</span> The efficiency ratios and gearing are HL only, and are hidden while you are viewing SL content.</p>
    <figcaption class="bb-exhibit__source">
      The guide's formulas (pp. 64 to 65). {sc.model.period.perYear > 1 ? 'Return on capital employed uses each quarter’s profit at an annual rate; stock, debtor and creditor days use the days in the quarter.' : 'Stock days use closing stock.'}
    </figcaption>
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-trend-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 5</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-trend-h`}>Six measures, {labels[0]} to {last.label}</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <ul class="bb-trends" role="list">
      {
        trends.map((t) => (
          <li class="bb-trend-cell">
            <p class="bb-trend-cell__label">{KPI_DEFS[t.id].label}</p>
            <Fragment set:html={t.svg} />
          </li>
        ))
      }
    </ul>
    <figcaption class="bb-exhibit__source">The figures behind these charts are in Exhibit 6.</figcaption>
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-fig-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 6</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-fig-h`}>Key figures by {sc.model.period.unit}</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <Fragment set:html={figuresTable(history, packMeasures(sc), ctx, `Key figures by ${sc.model.period.unit}`, history.length)} />
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-mkt-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 7</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-mkt-h`}>The market in {last.label}</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <div class="prose bb-exhibit__lede" set:html={rich(fillTokens(sc.market.summary, last.kpis, history[history.length - 2]?.kpis, ctx))} />
    <div class="table-scroll" role="region" aria-labelledby={`bp-${id}-mkt-h`} tabindex="0">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Seller</th>
            <th scope="col" class="n">Share of the market</th>
            <th scope="col" class="n">Typical price</th>
            <th scope="col">Position</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bb-mkt__us">
            <th scope="row">{sc.company.name} (fictional)</th>
            <td class="n">{fmtNumber(share, 1)}%</td>
            <td class="n">{fmtKpi('avgPrice', last.kpis.avgPrice, ctx)}</td>
            <td>Average across its channels</td>
          </tr>
          {
            sc.market.competitors.map((c) => (
              <tr>
                <th scope="row">{c.name}</th>
                <td class="n">{fmtNumber(c.share, 1)}%</td>
                <td class="n">{fmtKpi('avgPrice', c.price, ctx)}</td>
                <td>{c.position}</td>
              </tr>
            ))
          }
          <tr>
            <th scope="row">All other sellers</th>
            <td class="n">{fmtNumber(others, 1)}%</td>
            <td class="n">Various</td>
            <td>Smaller firms</td>
          </tr>
        </tbody>
      </table>
    </div>
    <ul class="bb-trendlist">
      {sc.market.trends.map((t) => <li set:html={inline(t)} />)}
    </ul>
    <figcaption class="bb-exhibit__source">
      The whole market: {fmtKpi('volume', history[history.length - 1] ? last.kpis.volume / (share / 100) : 0, ctx)} {sc.units.plural} a {sc.model.period.unit}, growing about {fmtNumber(sc.start.marketGrowth * 100, 1)}% a {sc.model.period.unit}. Shares by volume.
    </figcaption>
  </figure>

  <figure class="bb-exhibit" aria-labelledby={`bp-${id}-hist-h`}>
    <div class="bb-exhibit__head">
      <span class="bb-exhibit__no">Exhibit 8</span>
      <h3 class="bb-exhibit__title" id={`bp-${id}-hist-h`}>What happened before the first decision</h3>
      <ProvenanceTag kind="simulated-data" />
    </div>
    <ol class="bb-timeline">
      {
        sc.history.map((h) => (
          <li>
            <span class="bb-timeline__when">{h.label}</span>
            <span class="bb-timeline__what" set:html={inline(h.note)} />
          </li>
        ))
      }
    </ol>
  </figure>
</div>
