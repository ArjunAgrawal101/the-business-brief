---
/**
 * The opening: a five-second brand reveal on the reader's first visit to the
 * home page. It is built from the logo's own vector master, read at build
 * time, so nothing is redrawn: the monogram rises from a fine gold line, the
 * name and the logo's rule and tagline follow, then the platform's name, and a
 * curtain lifts on the page.
 *
 * Rules it keeps: shown once per browser (bb:intro-seen), never under reduced
 * motion, skippable at any moment (button, Escape, or a click), and finished by
 * CSS alone if its script never runs. BaseLayout's head script decides whether
 * it shows before the first paint, so the page never flashes behind it.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const master = readFileSync(join(process.cwd(), 'public/brand/creator/arjun-agrawal-logo.svg'), 'utf8');
// The master's six parts, in order: monogram (navy), monogram (gold), name,
// rule with its diamond, tagline letters, tagline full stops.
const parts = [...master.matchAll(/<(path|g)\b[^>]*?(?:\/>|>[\s\S]*?<\/g>)/g)].map((m) => m[0]);
if (parts.length !== 6) throw new Error(`BrandIntro: expected 6 parts in the logo master, found ${parts.length}`);
const CLASSES = ['bi-mono bi-mono--a', 'bi-mono bi-mono--b', 'bi-name', 'bi-rule', 'bi-tag', 'bi-tag bi-tag--dots'];
const strip = (s: string) => s.replace(/\sfill="[^"]*"/g, '');
const body = parts
  .map((p, i) => {
    const cls = CLASSES[i];
    return `<g class="${cls}">${strip(p)}</g>`;
  })
  .join('');
---

<div class="brand-intro" data-brand-intro>
  <div class="brand-intro__stage" aria-hidden="true">
    <span class="brand-intro__glow"></span>
    <svg class="brand-intro__logo" viewBox="0 0 760 462" width="760" height="462" focusable="false">
      <defs>
        <linearGradient id="bi-glint" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#c9a866" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="#f6e7c4" stop-opacity="1"></stop>
          <stop offset="1" stop-color="#c9a866" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <line class="bi-line" x1="40" x2="720" y1="263" y2="263"></line>
      <rect class="bi-glint" x="40" y="261.5" width="120" height="3" fill="url(#bi-glint)"></rect>
      <g set:html={body} />
    </svg>
    <p class="brand-intro__product">The Business Brief</p>
    <p class="brand-intro__tagline">Strategy <span>·</span> Leadership <span>·</span> Decisions</p>
  </div>
  <button class="brand-intro__skip" type="button" data-intro-skip>
    <span class="brand-intro__bar" aria-hidden="true"></span>
    Skip intro
  </button>
</div>

<style is:global>
  .brand-intro {
    display: none;
  }

  html.intro-on {
    overflow: hidden;
  }

  html.intro-on .brand-intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    color: #f4efe4;
    background:
      var(--grain),
      radial-gradient(ellipse at 50% 42%, #16305a 0%, #0b1a33 48%, #050d1d 100%);
    cursor: pointer;
    animation: bi-exit 0.8s cubic-bezier(0.7, 0, 0.3, 1) 4.25s forwards;
  }

  html.intro-on .brand-intro.is-skipping {
    animation: bi-exit 0.45s cubic-bezier(0.7, 0, 0.3, 1) forwards;
  }

  /* Until the curtain lifts, the page does not start its own arrivals. */
  html.intro-hold main *,
  html.intro-hold main *::before,
  html.intro-hold main *::after {
    animation-play-state: paused !important;
  }

  .brand-intro__stage {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(100%, 38rem);
  }

  .brand-intro__glow {
    position: absolute;
    inset: -30% -20%;
    background: radial-gradient(closest-side, rgba(201, 168, 102, 0.16), transparent 70%);
    opacity: 0;
    animation: bi-glow 3.6s ease-out 0.5s forwards;
    pointer-events: none;
  }

  .brand-intro__logo {
    position: relative;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bi-line {
    stroke: #c9a866;
    stroke-width: 1.2;
    stroke-dasharray: 680;
    stroke-dashoffset: 680;
    transform-box: fill-box;
    transform-origin: center;
    animation:
      bi-draw 1s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards,
      bi-fade 0.7s ease 2s forwards;
  }

  .bi-glint {
    opacity: 0;
    animation: bi-glint 1s cubic-bezier(0.45, 0, 0.2, 1) 0.75s forwards;
  }

  .bi-mono--a,
  .bi-mono--b {
    clip-path: inset(100% 0 0 0);
    animation: bi-rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.95s forwards;
  }

  .bi-mono--b {
    animation-delay: 1.15s;
  }

  .bi-mono--a path,
  .bi-name path,
  .bi-tag path {
    fill: #f4efe4;
  }

  .bi-mono--b path,
  .bi-rule path,
  .bi-tag--dots path {
    fill: #c9a866;
  }

  .bi-name {
    clip-path: inset(0 50% 0 50%);
    opacity: 0;
    animation: bi-open 0.9s cubic-bezier(0.16, 1, 0.3, 1) 2.05s forwards;
  }

  .bi-rule {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleX(0);
    animation: bi-extend 0.8s cubic-bezier(0.16, 1, 0.3, 1) 2.55s forwards;
  }

  .bi-tag {
    opacity: 0;
    transform: translateY(8px);
    animation: bi-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 2.85s forwards;
  }

  .brand-intro__product,
  .brand-intro__tagline {
    margin: 0;
    opacity: 0;
    text-align: center;
  }

  .brand-intro__product {
    margin-top: clamp(1.25rem, 4vh, 2.25rem);
    font-family: var(--font-brand);
    font-size: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.5em;
    color: #f4efe4;
    animation: bi-track 1.1s cubic-bezier(0.16, 1, 0.3, 1) 3.15s forwards;
  }

  .brand-intro__tagline {
    margin-top: 0.75rem;
    font-family: var(--font-ui);
    font-size: clamp(0.6875rem, 0.62rem + 0.3vw, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c9a866;
    animation: bi-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 3.5s forwards;
  }

  .brand-intro__tagline span {
    margin-inline: 0.35em;
    color: rgba(244, 239, 228, 0.5);
  }

  .brand-intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    display: inline-grid;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(244, 239, 228, 0.32);
    border-radius: 999px;
    background: rgba(11, 26, 51, 0.6);
    color: #f4efe4;
    font: 600 0.75rem/1 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .brand-intro__skip:hover {
    border-color: #c9a866;
  }

  .brand-intro__skip:focus-visible {
    outline: 3px solid #c9a866;
    outline-offset: 3px;
  }

  .brand-intro__bar {
    display: block;
    height: 1px;
    background: #c9a866;
    transform-origin: left;
    transform: scaleX(0);
    animation: bi-progress 4.25s linear forwards;
  }

  @keyframes bi-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes bi-fade {
    to {
      opacity: 0;
    }
  }

  @keyframes bi-glint {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(560px);
    }
  }

  @keyframes bi-glow {
    to {
      opacity: 1;
    }
  }

  @keyframes bi-rise {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes bi-open {
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @keyframes bi-extend {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes bi-up {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes bi-track {
    to {
      opacity: 1;
      letter-spacing: 0.22em;
    }
  }

  @keyframes bi-progress {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes bi-exit {
    0% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.intro-on .brand-intro {
      display: none;
    }
  }

  @media print {
    .brand-intro {
      display: none !important;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-brand-intro]');
  if (el && root.classList.contains('intro-on')) {
    const skipBtn = el.querySelector<HTMLButtonElement>('[data-intro-skip]');
    const page = ['#site-header', 'main', '#site-footer', '.skip-link']
      .map((s) => document.querySelector<HTMLElement>(s))
      .filter((n): n is HTMLElement => Boolean(n));
    page.forEach((n) => (n.inert = true));
    try {
      localStorage.setItem('bb:intro-seen', new Date().toISOString().slice(0, 10));
    } catch {
      /* private browsing: the intro simply shows again next time */
    }
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      page.forEach((n) => (n.inert = false));
      root.classList.remove('intro-on', 'intro-hold');
      el.remove();
      if (/[?&]intro\b/.test(location.search)) history.replaceState(null, '', location.pathname + location.hash);
    };
    const skip = () => {
      if (!done) el.classList.add('is-skipping');
    };
    // As the curtain starts to lift, the page begins its own arrivals beneath it.
    el.addEventListener('animationstart', (e) => {
      if (e.target === el) root.classList.remove('intro-hold');
    });
    el.addEventListener('animationend', (e) => {
      if (e.target === el) finish();
    });
    el.addEventListener('click', skip);
    document.addEventListener('keydown', (e) => {
      if (!done && (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        skip();
      }
    });
    skipBtn?.focus({ preventScroll: true });
    // A backstop in case animation events are not delivered.
    window.setTimeout(finish, 6000);
  }
</script>
