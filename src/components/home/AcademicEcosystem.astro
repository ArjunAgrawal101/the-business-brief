---
/**
 * Explore the Arjun Agrawal Academic Ecosystem: the three platforms by the
 * same educator, each panel in its own platform's colours (Economics on
 * charcoal and gold, The Business Brief on its own paper and navy, Political
 * Studies & Global Affairs on midnight with burgundy). This platform is
 * marked as the current one; the other two open in a new tab. The panels are
 * typographic, each with a small drawn mark: no screenshots of the other
 * platforms are used. The list is src/lib/ecosystem.ts.
 */
import { ECOSYSTEM, hostOf } from '../../lib/ecosystem';
---

<ol class="aae" role="list">
  {
    ECOSYSTEM.map((p) => (
      <li class={`aae__panel aae__panel--${p.key}`} aria-current={p.current ? 'true' : undefined}>
        <div class="aae__top">
          <p class="aae__kicker">{p.current ? 'This platform' : 'Sister platform'}</p>
          <span class="aae__mark" aria-hidden="true">
            {p.key === 'economics' && (
              <svg viewBox="0 0 64 48" focusable="false">
                <path d="M6 6C22 18 38 30 58 42" />
                <path d="M6 42C22 30 38 18 58 6" opacity=".6" />
                <circle class="aae__dot" cx="32" cy="24" r="3" />
              </svg>
            )}
            {p.key === 'business' && (
              <svg viewBox="0 0 64 48" focusable="false">
                <path d="M4 44H60" />
                <rect x="10" y="32" width="8" height="12" />
                <rect x="22" y="24" width="8" height="20" />
                <rect x="34" y="16" width="8" height="28" />
                <rect x="46" y="8" width="8" height="36" />
              </svg>
            )}
            {p.key === 'politics' && (
              <svg viewBox="0 0 64 48" focusable="false">
                <circle cx="32" cy="24" r="19" />
                <ellipse cx="32" cy="24" rx="8" ry="19" opacity=".7" />
                <path d="M13 24H51M16 14H48M16 34H48" opacity=".55" />
              </svg>
            )}
          </span>
        </div>
        <h3 class="aae__name">{p.name}</h3>
        <p class="aae__line">{p.line}</p>
        <p class="aae__text">{p.text}</p>
        <div class="aae__foot">
          {p.current ? (
            <>
              <span class="aae__here">You are here</span>
              <a class="aae__go" href="/topics/">
                Explore the topic library <span aria-hidden="true">&rarr;</span>
              </a>
            </>
          ) : (
            <>
              <a class="aae__go" href={p.url} target="_blank" rel="noopener noreferrer">
                Visit {p.name} <span aria-hidden="true">&nearr;</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              <span class="aae__url">{hostOf(p.url)}</span>
            </>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .aae {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .aae__panel {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(1.4rem, 2.6vw, 2.1rem);
  }

  .aae__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-4);
  }

  .aae__kicker {
    margin: 0;
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .aae__mark svg {
    display: block;
    width: 4rem;
    height: 3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .aae__mark .aae__dot {
    fill: currentColor;
    stroke: none;
  }

  .aae__name {
    margin: var(--sp-5) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 560;
    line-height: 1.1;
    color: inherit;
  }

  .aae__line {
    margin: var(--sp-3) 0 0;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .aae__text {
    margin: var(--sp-3) 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .aae__foot {
    display: grid;
    justify-items: start;
    gap: var(--sp-1);
    margin-top: auto;
    padding-top: var(--sp-5);
  }

  .aae__foot::before {
    content: '';
    justify-self: stretch;
    height: 1px;
    margin-bottom: var(--sp-3);
    background: currentColor;
    opacity: 0.22;
  }

  .aae__go {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-block: 0.6rem;
    font-weight: 650;
    line-height: 1.5;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .aae__go:hover {
    text-decoration-thickness: 2px;
  }

  .aae__go:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .aae__url {
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .aae__here {
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  /* Economics: charcoal and gold */
  .aae__panel--economics {
    background: #1a1d22;
    color: #f4efe4;
    border-top: 3px solid #b08a47;
  }

  .aae__panel--economics .aae__kicker,
  .aae__panel--economics .aae__mark {
    color: #d9c28f;
  }

  .aae__panel--economics .aae__line,
  .aae__panel--economics .aae__text,
  .aae__panel--economics .aae__url {
    color: rgba(244, 239, 228, 0.8);
  }

  /* The Business Brief, this platform: its own paper, navy and green, ringed in gold */
  .aae__panel--business {
    background: var(--surface-sheet);
    color: var(--navy-900);
    outline: 2px solid var(--gold-500);
    outline-offset: 3px;
    box-shadow: var(--shadow-sheet);
  }

  .aae__panel--business .aae__kicker,
  .aae__panel--business .aae__mark,
  .aae__panel--business .aae__line {
    color: var(--green-text);
  }

  .aae__panel--business .aae__text {
    color: var(--text-body);
  }

  .aae__panel--business .aae__here {
    color: var(--brass-text);
  }

  /* Political Studies & Global Affairs: midnight, ivory, antique gold and a burgundy rule */
  .aae__panel--politics {
    background: #101d32;
    color: #f7f5ef;
    border-top: 3px solid #713d4c;
  }

  .aae__panel--politics .aae__kicker,
  .aae__panel--politics .aae__mark {
    color: #c9ad6e;
  }

  .aae__panel--politics .aae__line,
  .aae__panel--politics .aae__text,
  .aae__panel--politics .aae__url {
    color: rgba(247, 245, 239, 0.8);
  }

  @media (max-width: 62rem) {
    .aae {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aae__go {
      transition: none;
    }
  }
</style>
