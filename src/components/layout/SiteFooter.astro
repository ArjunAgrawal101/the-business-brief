---
/**
 * The footer carries both identities: the full Arjun Agrawal logo (the
 * creator, from the brand's own reversed master) and The Business Brief (the
 * product). Below them, the Arjun Agrawal Academic Ecosystem: the three
 * platforms by the same educator, this one marked as current, the other two
 * opening in a new tab.
 */
import { NAV } from '../../lib/navigation';
import { ECOSYSTEM, ECOSYSTEM_MOTTO, ECOSYSTEM_NAME } from '../../lib/ecosystem';

/** The footer's columns are the five groups of the header, from one list. */
const COLUMNS = NAV.map((g) => ({ title: g.label, links: g.links.map((l) => [l.label, l.href] as const) }));
const year = new Date().getFullYear();
---

<footer class="site-footer on-ink" id="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="/about/">
          <img src="/brand/creator/arjun-agrawal-logo-reversed.svg" width="220" height="134" alt="Arjun Agrawal. Knowledge. Insight. Impact." loading="lazy" decoding="async" />
        </a>
        <div class="site-footer__product">
          <p class="site-footer__name">The Business Brief</p>
          <p class="site-footer__tagline">Strategy. Leadership. Decisions.</p>
          <p class="site-footer__about">
            A Business Management learning platform: read the situation, weigh the evidence, make the decision, follow the consequence.
          </p>
        </div>
      </div>

      <nav class="site-footer__nav" id="footer-nav" aria-label="Site">
        {
          COLUMNS.map((col) => (
            <div>
              <h2 class="site-footer__h">{col.title}</h2>
              <ul>
                {col.links.map(([label, url]) => (
                  <li>
                    <a href={url}>{label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <nav class="site-footer__series" aria-labelledby="footer-eco-h">
      <div>
        <p class="site-footer__series-name" id="footer-eco-h">{ECOSYSTEM_NAME}</p>
        <p class="site-footer__series-text">
          Three independent platforms by <a href="/about/">Arjun Agrawal</a>, IB Diploma Programme educator in Economics, Business Management and
          Global Politics. {ECOSYSTEM_MOTTO}
        </p>
      </div>
      <ul class="site-footer__eco" role="list">
        {
          ECOSYSTEM.map((p) => (
            <li class={`site-footer__eco-item site-footer__eco-item--${p.key}`}>
              {p.current ? (
                <a href="/">
                  <span class="site-footer__eco-name">{p.name}</span>
                  <span class="site-footer__eco-line">{p.line}</span>
                  <span class="site-footer__eco-here">You are here</span>
                </a>
              ) : (
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  <span class="site-footer__eco-name">
                    {p.name} <span aria-hidden="true">&nearr;</span>
                  </span>
                  <span class="site-footer__eco-line">{p.line}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__legal">
      <p>
        An independent educational resource. It is not affiliated with, endorsed by or produced by the International Baccalaureate Organization.
        "International Baccalaureate", "IB" and "Diploma Programme" are trademarks of the International Baccalaureate Organization. Organizations in the
        teaching cases are fictional unless a case says otherwise, and their figures are simulated.
      </p>
      <p class="site-footer__fine">
        <span>&copy; {year} Arjun Agrawal. Educational content and brand: all rights reserved. Code: MIT licence.</span>
        <a href="/privacy/">No account, no tracking: your saved work stays on this device.</a>
        <a href="/accessibility/">Accessibility</a>
        <a href="/search/">Search</a>
        <a href="/rooms/">Every room and tool</a>
        <a href="/?intro" data-replay-intro>Replay the opening</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--surface-ink);
    color: var(--text-on-ink-muted);
    padding-block: var(--sp-8) var(--sp-6);
    margin-top: var(--sp-9);
    font-size: 0.9375rem;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-400) 20%, var(--gold-400) 80%, transparent);
    opacity: 0.6;
  }

  .site-footer a {
    color: var(--text-on-ink);
    text-decoration-color: rgba(244, 239, 228, 0.35);
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration-color: var(--gold-400);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--sp-7);
    padding-bottom: var(--sp-7);
    border-bottom: 1px solid var(--rule-on-ink);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

  .site-footer__logo {
    display: inline-block;
    width: fit-content;
  }

  .site-footer__logo img {
    width: 13.75rem;
    height: auto;
  }

  .site-footer__product {
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule-on-ink);
    max-width: 24rem;
  }

  .site-footer__name {
    font-family: var(--font-brand);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-on-ink);
  }

  .site-footer__tagline {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold-400);
  }

  .site-footer__about {
    margin-top: var(--sp-3);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }

  .site-footer__h {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold-400);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--rule-on-ink);
  }

  .site-footer__nav ul {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
  }

  .site-footer__nav li + li {
    margin-top: 0.45rem;
  }

  .site-footer__nav a {
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
  }

  .site-footer__series {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--sp-7);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--rule-on-ink);
  }

  .site-footer__series-name {
    font-family: var(--font-brand);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-400);
  }

  .site-footer__series-text {
    margin-top: var(--sp-2);
    max-width: 32rem;
  }

  .site-footer__eco {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__eco-item {
    margin: 0;
  }

  .site-footer__eco a {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    height: 100%;
    padding: var(--sp-4);
    border: 1px solid var(--rule-on-ink);
    text-decoration: none;
  }

  .site-footer__eco a:hover {
    border-color: var(--gold-400);
  }

  .site-footer__eco-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 560;
    line-height: 1.2;
    color: var(--text-on-ink);
  }

  .site-footer__eco-line,
  .site-footer__eco-url {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-on-ink-muted);
  }

  .site-footer__eco-here {
    margin-top: var(--sp-1);
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  .site-footer__eco-item--business a {
    border-color: var(--gold-400);
    border-top-width: 3px;
  }

  .site-footer__eco-item--economics a {
    border-top: 3px solid #b08a47;
    background: rgba(26, 29, 34, 0.55);
  }

  .site-footer__eco-item--politics a {
    border-top: 3px solid #8b4a5c;
    background: rgba(16, 29, 50, 0.7);
  }

  .site-footer__legal {
    display: grid;
    gap: var(--sp-3);
    padding-top: var(--sp-5);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .site-footer__legal p {
    max-width: 64rem;
  }

  .site-footer__fine {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
  }

  @media (max-width: 62rem) {
    .site-footer__top,
    .site-footer__series {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (max-width: 40rem) {
    .site-footer__eco {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 52rem) {
    .site-footer__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media print {
    .site-footer {
      background: none;
      color: #000;
      margin-top: var(--sp-6);
      padding-block: var(--sp-4) 0;
    }

    .site-footer::before,
    .site-footer__top,
    .site-footer__series {
      display: none;
    }

    .site-footer a {
      color: #000;
    }
  }
</style>
