---
interface Props {
  trail: Array<{ label: string; href?: string }>;
}
const { trail } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {
      trail.map((t, i) => (
        <li>{t.href && i < trail.length - 1 ? <a href={t.href}>{t.label}</a> : <span aria-current="page">{t.label}</span>}</li>
      ))
    }
  </ol>
</nav>
