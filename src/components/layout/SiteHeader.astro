---
/**
 * The site header: the brand lockup, the five doors of the information
 * architecture (Explore, Practise, Tools, Assess, Discover) as a mega menu,
 * a Tutorials button and search. Every menu is a native disclosure (details
 * and summary), so it opens and closes without JavaScript; the script adds
 * the rest of a menu's manners: one open at a time, Escape returns focus, a
 * click outside or moving focus away closes it. Below 64rem the groups move
 * into a full-height drawer.
 *
 * Search opens a panel with a search box. Without JavaScript it submits to
 * the search page; with it, the box suggests the best matches as you type
 * (src/scripts/header-search.ts, ranking in src/lib/suggest.ts) and lists
 * the pages you opened most recently, read from this browser's own record.
 *
 * The groups and their links come from src/lib/navigation.ts.
 */
import BrandLockup from '../brand/BrandLockup.astro';
import Monogram from '../brand/Monogram.astro';
import { NAV, navPosition } from '../../lib/navigation';
import { corpus } from '../../lib/content';
import { subtopicCoverage } from '../../lib/coverage';
import { ECOSYSTEM } from '../../lib/ecosystem';

interface Props {
  current?: string;
}
const { current } = Astro.props;

/** Sections whose pages sit outside any listed link. */
const SECTION_GROUP: Record<string, string> = {
  'ia-studio': 'assess',
  'exam-desk': 'assess',
  assessment: 'assess',
  rooms: 'tools',
  toolkit: 'explore',
  revision: 'explore',
  topics: 'explore',
  advanced: 'discover',
  tutorials: 'discover',
};
const pos = navPosition(Astro.url.pathname);
const activeGroup = pos.group ?? (current ? SECTION_GROUP[current] : undefined);
const ariaCurrent = (href: string) => (pos.href === href ? (pos.exact ? 'page' : 'true') : undefined);

const c = await corpus();
const coverage = subtopicCoverage(c);
const units = c.curricula['ib-dp-bm']?.units ?? [];

const GUIDES = [
  { label: 'Internal assessment guide', href: '/downloads/guides/business-brief-ia-research-project-guide.pdf' },
  { label: 'Paper 1 guide', href: '/downloads/guides/business-brief-paper-1-assessment-guide.pdf' },
  { label: 'Paper 2 guide', href: '/downloads/guides/business-brief-paper-2-assessment-guide.pdf' },
  { label: 'Paper 3 guide (HL)', href: '/downloads/guides/business-brief-paper-3-assessment-guide-hl.pdf' },
];
const SISTERS = ECOSYSTEM.filter((p) => !p.current);
const QUICK = [
  { label: 'Topic library', href: '/topics/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Frameworks', href: '/frameworks/' },
  { label: 'Question bank', href: '/assessment/question-bank/' },
  { label: 'Paper 2 practice', href: '/assessment/paper-2/practice/' },
];
---

<header class="site-header" id="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href="/" aria-label="Arjun Agrawal, The Business Brief: home">
      <BrandLockup />
    </a>

    <nav class="mega-nav" aria-label="Primary" data-mega-nav>
      <ul class="mega-nav__list">
        {
          NAV.map((g) => (
            <li class="mega-nav__item">
              <details class:list={['mega', `mega--${g.id}`, { 'is-current': activeGroup === g.id }]} name="mega" data-menu>
                <summary class="mega__trigger">
                  {g.label}
                  {activeGroup === g.id && <span class="sr-only"> (current section)</span>}
                  <svg class="mega__chev" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                    <path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <div class="mega__panel">
                  <div class="wrap mega__grid">
                    <div class="mega__intro">
                      <p class="mega__kicker">{g.label}</p>
                      <p class="mega__lead">{g.intro}</p>
                    </div>
                    <ul class="mega__links" role="list">
                      {g.links.map((l) => (
                        <li>
                          <a href={l.href} aria-current={ariaCurrent(l.href)}>
                            <span class="mega__name">
                              {l.label}
                              {l.hl && <span class="tag tag--hl">HL</span>}
                            </span>
                            <span class="mega__text">{l.text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <aside class="mega__feature" aria-label={`${g.label}: featured`}>
                      {g.id === 'explore' && (
                        <>
                          <p class="mega__flabel">The course by unit</p>
                          <ol class="mega__units" role="list">
                            {units.map((u) => (
                              <li>
                                <a href={`/topics/#unit-${u.number}`}>
                                  <span class="mega__unit-no">{u.number}</span>
                                  <span>{u.title}</span>
                                </a>
                              </li>
                            ))}
                          </ol>
                          <a class="mega__cta" href="/ib/coverage/">
                            {coverage.length} subtopics, and how each is covered <span aria-hidden="true">&rarr;</span>
                          </a>
                        </>
                      )}
                      {g.id === 'practise' && (
                        <>
                          <p class="mega__flabel">Start here</p>
                          <p class="mega__ftitle">Halden Distribution: diagnose before you decide</p>
                          <p class="mega__ftext">A warehouse in trouble after a new system arrived. Five stages from the symptoms to a judgement, checked against the evidence. A fictional business.</p>
                          <a class="mega__cta" href="/case-room/halden-diagnosis/">
                            Open the case lab <span aria-hidden="true">&rarr;</span>
                          </a>
                        </>
                      )}
                      {g.id === 'tools' && (
                        <>
                          <p class="mega__flabel">The formula sheet</p>
                          <p class="mega__ftitle">Every formula in the course, in the guide's notation</p>
                          <p class="mega__ftext">On one printable page, with a note on when each is used and what it shows.</p>
                          <a class="mega__cta" href="/resources/formula-sheet/">
                            Open the formula sheet <span aria-hidden="true">&rarr;</span>
                          </a>
                          <a class="mega__cta mega__cta--quiet" href="/rooms/">
                            Every room and tool <span aria-hidden="true">&rarr;</span>
                          </a>
                        </>
                      )}
                      {g.id === 'assess' && (
                        <>
                          <p class="mega__flabel">The creator's assessment guides</p>
                          <ul class="mega__files" role="list">
                            {GUIDES.map((d) => (
                              <li>
                                <a href={d.href} download>
                                  {d.label} <span class="mega__fmt">PDF</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </>
                      )}
                      {g.id === 'discover' && (
                        <>
                          <p class="mega__flabel">Learn with Arjun</p>
                          <p class="mega__creator">
                            <Monogram height={30} reversed />
                            <span>
                              <span class="mega__ftitle">One-to-one tutoring</span>
                              <span class="mega__ftext">IB DP Business Management, SL and HL: US$20 for a one-hour online session.</span>
                            </span>
                          </p>
                          <a class="mega__cta" href="/tutorials/">
                            The tutorials <span aria-hidden="true">&rarr;</span>
                          </a>
                          <p class="mega__flabel mega__flabel--gap">The Arjun Agrawal Academic Ecosystem</p>
                          <ul class="mega__files" role="list">
                            {SISTERS.map((p) => (
                              <li>
                                <a href={p.url} target="_blank" rel="noopener noreferrer">
                                  {p.name}
                                  <span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">&nearr;</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </>
                      )}
                    </aside>
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="hdr-btn hdr-btn--cta" href="/tutorials/" aria-current={current === 'tutorials' ? 'page' : undefined}>Tutorials</a>

      <details class="hsearch" data-hsearch data-menu>
        <summary class="hdr-btn hsearch__toggle" aria-current={current === 'search' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
            <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          </svg>
          <span class="hdr-btn__text">Search</span>
        </summary>
        <div class="hsearch__panel">
          <div class="wrap hsearch__inner">
            <form class="hsearch__form" role="search" action="/search/" method="get" data-hs-form>
              <label class="hsearch__label" for="hsearch-q">Search the platform</label>
              <div class="hsearch__box">
                <input
                  id="hsearch-q"
                  name="q"
                  type="search"
                  autocomplete="off"
                  spellcheck="false"
                  enterkeyhint="search"
                  placeholder="A topic, framework, term, formula or paper"
                  aria-describedby="hsearch-status"
                  data-hs-input
                />
                <button class="hsearch__go" type="submit">Search</button>
              </div>
              <p class="hsearch__status" id="hsearch-status" aria-live="polite" data-hs-status>Type to see suggestions. The arrow keys move through them.</p>
            </form>
            <div class="hsearch__cols">
              <div class="hsearch__results" data-hs-results hidden>
                <p class="hsearch__k">Suggestions</p>
                <ul class="hsearch__list" role="list" data-hs-list></ul>
                <a class="hsearch__all" href="/search/" data-hs-all>Every result on the search page <span aria-hidden="true">&rarr;</span></a>
              </div>
              <div class="hsearch__recent" data-hs-recent hidden>
                <p class="hsearch__k">Recently viewed on this device</p>
                <ul class="hsearch__list" role="list" data-hs-recent-list></ul>
              </div>
              <nav class="hsearch__quick" aria-label="Popular places">
                <p class="hsearch__k">Popular places</p>
                <ul role="list">
                  {
                    QUICK.map((q) => (
                      <li>
                        <a href={q.href}>{q.label}</a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </div>
          </div>
        </div>
      </details>

      <details class="drawer" data-drawer>
        <summary class="hdr-btn hdr-btn--ink drawer__toggle">
          <span class="drawer__bars" aria-hidden="true"><span></span><span></span></span>
          <span>Menu</span>
        </summary>
        <div class="drawer__panel">
          <nav class="wrap drawer__nav" aria-label="Primary">
            <form class="drawer__search" role="search" action="/search/" method="get">
              <label class="sr-only" for="drawer-q">Search the platform</label>
              <input id="drawer-q" name="q" type="search" autocomplete="off" placeholder="Search the platform" />
              <button type="submit" class="hdr-btn hdr-btn--ink">Search</button>
            </form>
            <a class="drawer__tutorials" href="/tutorials/">
              <span class="drawer__name">Tutorials</span>
              <span class="drawer__text">One-to-one IB Business Management tutoring with Arjun Agrawal, US$20 for a one-hour online session</span>
            </a>
            {
              NAV.map((g) => (
                <details class:list={['drawer__group', { 'is-current': activeGroup === g.id }]} open={activeGroup === g.id}>
                  <summary>
                    {g.label}
                    {activeGroup === g.id && <span class="sr-only"> (current section)</span>}
                  </summary>
                  <p class="drawer__intro">{g.intro}</p>
                  <ul role="list">
                    {g.links.map((l) => (
                      <li>
                        <a href={l.href} aria-current={ariaCurrent(l.href)}>
                          <span class="drawer__name">
                            {l.label}
                            {l.hl && <span class="tag tag--hl">HL</span>}
                          </span>
                          <span class="drawer__text">{l.text}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))
            }
            <section class="drawer__eco" aria-labelledby="drawer-eco-h">
              <p class="drawer__eco-k" id="drawer-eco-h">The Arjun Agrawal Academic Ecosystem</p>
              <ul role="list">
                {
                  SISTERS.map((p) => (
                    <li>
                      <a href={p.url} target="_blank" rel="noopener noreferrer">
                        <span class="drawer__name">
                          {p.name} <span aria-hidden="true">&nearr;</span>
                        </span>
                        <span class="drawer__text">{p.line}</span>
                        <span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
            <p class="drawer__foot">
              <a href="/search/">The search page</a>
              <a href="/rooms/">Every room and tool</a>
            </p>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--rule-hair);
  }

  /* The ground sits on a layer of its own, opaque, so nothing on the page
     ghosts through the header as it scrolls past. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface-page);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    color: var(--text-strong);
    text-decoration: none;
  }

  /* ---------- The mega menu (wide screens) ---------- */

  .mega-nav {
    margin-left: auto;
  }

  .mega-nav__list {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega-nav__item {
    margin: 0;
  }

  .mega > summary {
    list-style: none;
  }

  .mega > summary::-webkit-details-marker {
    display: none;
  }

  .mega__trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: var(--header-h);
    padding: 0 0.8rem;
    color: var(--navy-900);
    font-size: 0.9375rem;
    font-weight: 560;
    letter-spacing: 0.005em;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
  }

  .mega__trigger::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 1.15rem;
    height: 1px;
    background: var(--navy-900);
    transform: scaleX(0);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .mega__trigger:hover::after,
  .mega[open] > .mega__trigger::after {
    transform: scaleX(1);
  }

  .mega.is-current > .mega__trigger::after {
    height: 2px;
    background: var(--gold-500);
    transform: scaleX(1);
  }

  .mega__trigger:focus-visible {
    outline-offset: -4px;
  }

  .mega__chev {
    color: var(--slate-600);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .mega[open] .mega__chev {
    transform: rotate(180deg);
  }

  .mega__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-top: 1px solid var(--rule-hair);
    background: var(--ivory-50);
    box-shadow: 0 28px 48px -30px rgba(11, 26, 51, 0.5);
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mega[open] > .mega__panel {
      animation: mega-in var(--dur-slow) var(--ease-out);
    }
  }

  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .mega__grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.95fr) minmax(0, 2.4fr) minmax(15rem, 1.15fr);
    gap: var(--sp-6);
    padding-block: var(--sp-6) var(--sp-6);
  }

  .mega__kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 560;
    line-height: 1.05;
    color: var(--navy-900);
  }

  .mega__kicker::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: var(--sp-3);
    background: var(--gold-500);
  }

  .mega__lead {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .mega__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--sp-5);
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--navy-900);
  }

  .mega__links li {
    margin: 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .mega__links a {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.25rem;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease);
  }

  .mega__links a:hover {
    background: rgba(201, 168, 102, 0.1);
  }

  .mega__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 620;
    color: var(--navy-900);
  }

  .mega__links a:hover .mega__name {
    color: var(--cobalt-text);
  }

  .mega__links a[aria-current] .mega__name {
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .mega__text {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .mega__feature {
    align-self: start;
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-5);
    color: var(--text-on-ink);
    background: var(--surface-ink);
    border-top: 2px solid var(--gold-400);
  }

  .mega__flabel {
    margin: 0;
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-gold-on-ink);
  }

  .mega__ftitle {
    display: block;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 560;
    line-height: 1.25;
    color: var(--text-on-ink);
  }

  .mega__ftext {
    display: block;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-on-ink-muted);
  }

  .mega__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    color: var(--cobalt-on-ink);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .mega__cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .mega__cta--quiet {
    color: var(--text-on-ink);
  }

  .mega__files {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega__files li {
    border-bottom: 1px solid var(--rule-on-ink);
  }

  .mega__files a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    min-height: 2.5rem;
    color: var(--text-on-ink);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .mega__files a:hover {
    color: var(--gold-300);
  }

  .mega__fmt {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-gold-on-ink);
  }

  .mega__creator {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    margin: 0;
  }

  .mega__creator > span {
    display: grid;
    gap: 0.2rem;
  }

  /* ---------- Header tools ---------- */

  .mega__flabel--gap {
    margin-top: var(--sp-5);
  }

  /* Explore: the five units, each a way into the topic library */
  .mega__units {
    display: grid;
    gap: 0.15rem;
    margin: 0 0 var(--sp-4);
    padding: 0;
    list-style: none;
  }

  .mega__units a {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--sp-2);
    align-items: baseline;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--rule-on-ink);
    color: var(--text-on-ink);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .mega__units a:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mega__unit-no {
    color: var(--text-gold-on-ink);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
  }

  /* ---------- Search: a panel under the header, with suggestions as you type ---------- */
  .hsearch > summary {
    list-style: none;
  }

  .hsearch > summary::-webkit-details-marker {
    display: none;
  }

  .hsearch[open] > .hsearch__toggle {
    border-color: var(--navy-900);
    background: var(--surface-sunk);
  }

  .hsearch__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    background: var(--surface-sheet);
    border-top: 1px solid var(--rule);
    border-bottom: 3px solid var(--navy-900);
    box-shadow: 0 24px 40px -32px rgba(11, 26, 51, 0.5);
  }

  /* Only while open, as the menus do: a closed panel carries no animation that could never run. */
  @media (prefers-reduced-motion: no-preference) {
    .hsearch[open] > .hsearch__panel {
      animation: mega-in var(--dur-slow) var(--ease-out);
    }
  }

  .hsearch__inner {
    padding-block: var(--sp-5) var(--sp-6);
  }

  .hsearch__label {
    display: block;
    margin-bottom: var(--sp-2);
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .hsearch__box {
    display: flex;
    gap: 0;
    border: 1px solid var(--navy-900);
    border-radius: var(--radius-1);
    background: var(--white);
  }

  .hsearch__box input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 var(--sp-4);
    border: 0;
    background: transparent;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
  }

  .hsearch__box input:focus-visible {
    outline: none;
  }

  .hsearch__box:focus-within {
    outline: var(--focus-ring);
