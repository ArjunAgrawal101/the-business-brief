---
import BrandLockup from '../brand/BrandLockup.astro';
import Icon from '../ui/Icon.astro';
import { modulesInOrder } from '../../lib/content';
import { isIcon } from '../../lib/icons';
import { STATUS_LABELS } from '../../lib/labels';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const rooms = (await modulesInOrder()).map((m) => ({ id: m.id, ...m.data }));

/** Older section names map onto the 2.0 navigation. */
const SECTION_OF: Record<string, string> = {
  'exam-desk': 'assessment',
  'ia-studio': 'assessment',
  revision: 'topics',
  toolkit: 'topics',
};
const active = current ? (SECTION_OF[current] ?? current) : undefined;

const PRIMARY = [
  { id: 'topics', label: 'Topics', href: '/topics/' },
  { id: 'mindmaps', label: 'Mindmaps', href: '/mindmaps/' },
  { id: 'glossary', label: 'Glossary', href: '/glossary/' },
  { id: 'assessment', label: 'Assessment', href: '/assessment/' },
  { id: 'resources', label: 'Resources', href: '/resources/' },
  { id: 'about', label: 'About', href: '/about/' },
];

const GROUPS = [
  {
    title: 'Learn',
    links: [
      { label: 'Topic library', href: '/topics/' },
      { label: 'Mindmaps', href: '/mindmaps/' },
      { label: 'Diagrams', href: '/diagrams/' },
      { label: 'Glossary', href: '/glossary/' },
      { label: 'Course map', href: '/ib/map/' },
      { label: 'Coverage tracker', href: '/ib/coverage/' },
      { label: 'Key concepts', href: '/ib/concepts/' },
      { label: 'Toolkit', href: '/toolkit/' },
      { label: 'Revision briefs', href: '/revision/' },
    ],
  },
  {
    title: 'Assess',
    links: [
      { label: 'Assessment Centre', href: '/assessment/' },
      { label: 'Internal assessment', href: '/assessment/internal-assessment/' },
      { label: 'Paper 1', href: '/assessment/paper-1/' },
      { label: 'Paper 2', href: '/assessment/paper-2/' },
      { label: 'Paper 3 Boardroom (HL)', href: '/assessment/paper-3/' },
      { label: 'Practice questions', href: '/exam-desk/practice/' },
    ],
  },
  {
    title: 'Practise',
    links: [
      { label: 'Case studies', href: '/cases/' },
      { label: 'Decision Room', href: '/decision-room/' },
      { label: 'Finance Desk', href: '/finance-desk/' },
      { label: 'Case Room lab', href: '/case-room/' },
      { label: 'All rooms', href: '/rooms/' },
    ],
  },
  {
    title: 'Platform',
    links: [
      { label: 'Resources Library', href: '/resources/' },
      { label: 'About Arjun Agrawal', href: '/about/' },
      { label: 'Pathways', href: '/pathways/' },
      { label: 'Search', href: '/search/' },
      { label: 'Your progress', href: '/progress/' },
      { label: 'Sources and evidence', href: '/sources/' },
      { label: 'Accessibility', href: '/accessibility/' },
    ],
  },
];
---

<header class="site-header" id="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href="/" aria-label="Arjun Agrawal, The Business Brief: home">
      <BrandLockup />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          PRIMARY.map((item) => (
            <li>
              <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="icon-link" href="/search/" aria-current={current === 'search' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
          <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
        <span class="icon-link__text">Search</span>
      </a>
      <a class="menu-toggle" href="/rooms/" data-menu-toggle aria-controls="menu-panel">
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-toggle__icon" aria-hidden="true"><Icon id="rooms" size={16} /></span>
        <span class="menu-toggle__text menu-toggle__text--narrow">Menu</span>
        <span class="menu-toggle__text menu-toggle__text--wide">Explore</span>
      </a>
    </div>
  </div>

  <div class="menu-panel" id="menu-panel" data-menu-panel hidden>
    <div class="wrap menu-panel__primary">
      <ul class="menu-primary">
        {
          PRIMARY.map((item) => (
            <li>
              <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="wrap menu-panel__inner">
      {
        GROUPS.map((g) => (
          <section class="menu-panel__group" aria-labelledby={`menu-${g.title.toLowerCase()}`}>
            <h2 class="label" id={`menu-${g.title.toLowerCase()}`}>
              {g.title}
            </h2>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <div class="wrap menu-panel__rooms">
      <h2 class="label" id="menu-rooms">Learning environments</h2>
      <ul class="rooms-menu" aria-labelledby="menu-rooms">
        {
          rooms.map((r) => (
            <li class:list={['rooms-menu__item', `is-${r.status}`]}>
              {r.href ? (
                <a href={r.href} class="rooms-menu__link" aria-current={current === r.id ? 'page' : undefined}>
                  {isIcon(r.id) && <Icon id={r.id} size={20} />}
                  <span class="rooms-menu__name">{r.name}</span>
                  <span class="rooms-menu__status">{STATUS_LABELS[r.status].label}</span>
                </a>
              ) : (
                <span class="rooms-menu__link">
                  {isIcon(r.id) && <Icon id={r.id} size={20} />}
                  <span class="rooms-menu__name">{r.name}</span>
                  <span class="rooms-menu__status">{STATUS_LABELS[r.status].label}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 241, 231, 0.94);
    border-bottom: 1px solid var(--rule-hair);
    backdrop-filter: saturate(1.15) blur(8px);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--text-strong);
    text-decoration: none;
    flex: none;
  }

  .primary-nav {
    margin-left: auto;
  }

  .primary-nav ul {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav li {
    margin: 0;
  }

  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--header-h);
    padding: 0 0.8rem;
    color: var(--navy-900);
    font-size: 0.9375rem;
    font-weight: 540;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 1.15rem;
    height: 1px;
    background: var(--navy-900);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .primary-nav a:hover::after {
    transform: scaleX(1);
  }

  .primary-nav a[aria-current='page']::after {
    height: 2px;
    background: var(--gold-500);
    transform: scaleX(1);
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .icon-link,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--navy-900);
    background: transparent;
    font-size: 0.875rem;
    font-weight: 560;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .icon-link svg {
    flex: none;
    max-width: none;
  }

  .icon-link:hover,
  .menu-toggle:hover {
    border-color: var(--navy-900);
    color: var(--navy-900);
  }

  .icon-link[aria-current='page'] {
    border-color: var(--gold-500);
  }

  .menu-toggle {
    cursor: pointer;
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--text-on-ink);
  }

  .menu-toggle:hover {
    background: var(--navy-800);
    color: var(--text-on-ink);
  }

  .menu-toggle__icon {
    display: inline-flex;
  }

  .menu-toggle__bars,
  .menu-toggle__text--narrow {
    display: none;
  }

  .menu-toggle__bars {
    gap: 4px;
    width: 16px;
  }

  /* Open, the button shows a close mark at every width. */
  :global(.menu-open) .menu-toggle__icon {
    display: none;
  }

  :global(.menu-open) .menu-toggle__bars {
    display: grid;
  }

  .menu-toggle__bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-base) var(--ease);
  }

  :global(.menu-open) .menu-toggle__bars span:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  :global(.menu-open) .menu-toggle__bars span:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  .menu-panel {
    border-top: 1px solid var(--rule-hair);
    background: var(--ivory-50);
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    box-shadow: 0 24px 40px -28px rgba(11, 26, 51, 0.45);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel {
      transition:
        opacity var(--dur-slow) var(--ease-out),
        transform var(--dur-slow) var(--ease-out),
        display var(--dur-slow) allow-discrete;
    }

    .menu-panel[hidden] {
      display: none;
      opacity: 0;
      transform: translateY(-6px);
    }

    @starting-style {
      .menu-panel:not([hidden]) {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }

  .menu-panel__primary {
    display: none;
    padding-top: var(--sp-5);
  }

  .menu-primary {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--navy-900);
  }

  .menu-primary li {
    margin: 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .menu-primary a {
    display: block;
    padding: 0.75rem 0;
    color: var(--navy-900);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 560;
    text-decoration: none;
  }

  .menu-primary a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .menu-panel__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--sp-5) var(--sp-6);
    padding-block: var(--sp-6) var(--sp-5);
  }

  .menu-panel__group ul {
    list-style: none;
    margin: var(--sp-2) 0 0;
    padding: 0;
    border-top: 1px solid var(--navy-900);
  }

  .menu-panel__group li {
    margin: 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .menu-panel__group a {
    display: block;
    padding: 0.55rem 0;
    color: var(--navy-900);
    font-weight: 540;
    text-decoration: none;
  }

  .menu-panel__group a:hover {
    color: var(--cobalt-text);
  }

  .menu-panel__rooms {
    padding-bottom: var(--sp-6);
  }

  .rooms-menu {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    gap: 0 var(--sp-5);
    margin: var(--sp-2) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--navy-900);
  }

  .rooms-menu__item {
    margin: 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .rooms-menu__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0 0.7rem;
    min-height: 3.25rem;
    padding: 0.5rem 0.75rem 0.5rem 0;
    color: var(--navy-900);
    text-decoration: none;
  }

  .rooms-menu__link :global(.icon) {
    grid-row: span 2;
    color: var(--brass-text);
  }

  .rooms-menu__name {
    font-weight: 580;
    line-height: 1.2;
  }

  .rooms-menu__status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  a.rooms-menu__link:hover .rooms-menu__name,
  a.rooms-menu__link[aria-current='page'] .rooms-menu__name {
    color: var(--cobalt-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .is-planned .rooms-menu__link {
    color: var(--text-muted);
  }

  .is-planned .rooms-menu__link :global(.icon) {
    color: var(--text-muted);
    opacity: 0.7;
  }

  @media (max-width: 75rem) {
    .primary-nav {
      display: none;
    }

    .menu-panel__primary {
      display: block;
    }

    .menu-toggle__bars,
    .menu-toggle__text--narrow {
      display: inline-flex;
    }

    .menu-toggle__bars {
      display: grid;
    }

    .menu-toggle__icon,
    .menu-toggle__text--wide {
      display: none;
    }

    .site-header__tools {
      margin-left: auto;
    }
  }

  @media (max-width: 30rem) {
    .icon-link__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .icon-link,
    .menu-toggle {
      padding: 0 0.7rem;
    }

    .menu-toggle__text--narrow {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .site-header__bar {
      gap: var(--sp-3);
    }

    .brand :global(.lockup) {
      gap: 0.5rem;
    }

    .brand :global(.lockup__creator) {
      font-size: 0.5625rem;
      letter-spacing: 0.18em;
    }

    .brand :global(.lockup__product) {
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
    }

    .brand :global(.monogram) {
      height: 28px;
      width: auto;
    }
  }

  @media print {
    .site-header {
      position: static;
      backdrop-filter: none;
    }

    .primary-nav,
    .site-header__tools,
    .menu-panel {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLAnchorElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  if (toggle && panel) {
    toggle.setAttribute('role', 'button');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.removeAttribute('href');
    toggle.tabIndex = 0;

    const setOpen = (open: boolean, returnFocus = false) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
      if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden === true));
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setOpen(panel.hidden === true);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false, true);
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!panel.hidden && !panel.contains(t) && !toggle.contains(t)) setOpen(false);
    });
    window.matchMedia('(min-width: 75.0625rem)').addEventListener('change', () => setOpen(false));
  }
</script>
