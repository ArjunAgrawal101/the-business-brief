---
/**
 * Statements about the IB assessment. The block carries its verification
 * status and its sources once, beneath the list; each statement keeps only
 * its page. A statement whose status differs from the rest shows its own.
 */
import VerifyTag from '../ui/VerifyTag.astro';
import { corpus, href } from '../../lib/content';
import type { Verification } from '../../lib/schemas';

interface Props {
  facts: Array<{ text: string; status: Verification; sources: string[]; location?: string }>;
}
const { facts } = Astro.props;
const c = await corpus();
const counts = new Map<Verification, number>();
for (const f of facts) counts.set(f.status, (counts.get(f.status) ?? 0) + 1);
const common = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? 'primary';
const sources = [...new Set(facts.flatMap((f) => f.sources))];
---

<div class="facts-block">
  <ul class="facts">
    {
      facts.map((f) => (
        <li class="fact">
          {f.text}
          {f.location && <span class="fact__loc">{f.location}</span>}
          {f.status !== common && <VerifyTag status={f.status} />}
        </li>
      ))
    }
  </ul>
  <p class="facts__src">
    <VerifyTag status={common} />
    {/* One line, so no space falls before the semicolons or the full stop. */}
    <span>Sources: {sources.map((s, k) => <>{k > 0 ? '; ' : ''}<a href={href.source(s)}>{c.sources[s]?.title ?? s}</a></>)}. The page follows each statement.</span>
  </p>
</div>

<style>
  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--rule-ink);
  }

  .fact {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--rule-hair);
    max-width: var(--text-max);
    color: var(--text-strong);
  }

  .fact__loc {
    margin-left: 0.4em;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .facts__src {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
    margin: var(--sp-3) 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
