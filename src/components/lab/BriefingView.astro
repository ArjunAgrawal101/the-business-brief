---
/**
 * A learning briefing of the Entrepreneurship and Innovation Lab: the
 * question, the introduction and where it sits in the IB course; numbered
 * sections, each labelled as IB content, enrichment or both; then common
 * mistakes, key terms, questions to check understanding, the tools to use and
 * the register of which ideas are IB content.
 */
import SectionHead from '../layout/SectionHead.astro';
import ProvenanceTag from '../ui/ProvenanceTag.astro';
import IbChips from './IbChips.astro';
import { corpus } from '../../lib/content';
import { labHref } from '../../lib/integrity-lab';
import { inline, rich } from '../../lib/markup';
import type { Briefing } from '../../lib/lab/schemas';
import type { LabTool } from '../../lib/lab/schemas';

interface Props {
  id: string;
  b: Briefing;
  tools: Record<string, LabTool>;
}
const { id, b, tools } = Astro.props;
const c = await corpus();
const ibCodes = [...new Set(b.sections.flatMap((s) => s.ib))].sort((x, y) => x.localeCompare(y, 'en', { numeric: true }));
const glossary = b.glossary.map((g) => ({ id: g, term: c.glossary[g]?.term ?? g })).sort((x, y) => x.term.localeCompare(y.term));
const extra = { mistakes: b.sections.length + 1, terms: b.sections.length + 2, check: b.sections.length + 3, use: b.sections.length + 4, register: b.sections.length + 5 };
const STATUS = { ib: 'IB content', toolkit: 'IB toolkit', enrichment: 'Enrichment' } as const;
const TONE = { caution: 'callout--caution', framework: 'callout--framework', exam: 'callout--exam', enrichment: 'callout--enrichment' } as const;
---

<article class="lab-brief" data-briefing={id}>
  <div class="lab-brief__opening">
    <div class="lab-brief__intro">
      <p class="lab-brief__question"><span class="lab-label">The question</span>{b.question}</p>
      <div class="prose" set:html={rich(b.introduction)} />
    </div>
    <aside class="lab-whiteboard lab-brief__aside" aria-labelledby={`${id}-ib-h`}>
      <h2 class="lab-label" id={`${id}-ib-h`}>Where this sits in the IB course</h2>
      <div class="prose small" set:html={rich(b.ibSummary)} />
      <IbChips codes={ibCodes} label="IB subtopics" />
      <h2 class="lab-label lab-brief__toc-h" id={`${id}-toc-h`}>In this briefing</h2>
      <ol class="lab-brief__toc" aria-labelledby={`${id}-toc-h`}>
        {
          b.sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.title}</a>
            </li>
          ))
        }
        <li><a href="#mistakes">Common mistakes</a></li>
        <li><a href="#check">Check your understanding</a></li>
      </ol>
    </aside>
  </div>

  {
    b.sections.map((s, i) => (
      <section class="lab-brief__section" id={s.id} aria-labelledby={`${s.id}-h`}>
        <SectionHead no={i + 1} title={s.title} id={`${s.id}-h`}>
          <div class="lab-brief__tags">
            {s.ib.length > 0 && (
              <span class="lab-brief__tagset">
                <span class="tag tag--ib">IB course</span>
                <IbChips codes={s.ib} />
              </span>
            )}
            {s.enrichment && <ProvenanceTag kind="enrichment" />}
            {s.connects.length > 0 && <IbChips codes={s.connects} label="Connects to" />}
          </div>
        </SectionHead>
        <div class="lab-brief__body">
          <div class="prose" set:html={rich(s.body)} />
          {s.points.length > 0 && (
            <dl class="lab-defs lab-brief__points">
              {s.points.map((p) => (
                <div>
                  <dt>{p.term}</dt>
                  <dd set:html={rich(p.text)} />
                </div>
              ))}
            </dl>
          )}
          {s.table && (
            <div class="lab-brief__table">
              <div class="table-scroll" role="region" aria-label={s.table.caption} tabindex="0">
                <table class="table compare">
                  <caption class="small muted">{s.table.caption}</caption>
                  <thead>
                    <tr>
                      <th scope="col">{s.table.corner}</th>
                      {s.table.columns.map((col) => (
                        <th scope="col">{col}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr>
                        <th scope="row">{r.label}</th>
                        {r.cells.map((cell) => (
                          <td set:html={inline(cell)} />
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
          {s.formulas.length > 0 && (
            <div class="lab-brief__formulas">
              {s.formulas.map((f) => (
                <div class="formula">
                  <p class="lab-label">{f.name}</p>
                  <p class="formula__expr">{f.expression}</p>
                  {f.note && <p class="small muted">{f.note}</p>}
                </div>
              ))}
            </div>
          )}
          {s.example && (
            <aside class="lab-example lab-whiteboard" aria-label={`Example: ${s.example.title}`}>
              <p class="lab-example__kicker">
                <span class="lab-label">Example</span>
                <ProvenanceTag kind="simulated-data" />
              </p>
              <h3 class="lab-example__title">{s.example.title}</h3>
              <div class="prose" set:html={rich(s.example.text)} />
            </aside>
          )}
          {s.callout && (
            <aside class={`callout ${TONE[s.callout.tone]}`}>
              <span class="callout__kicker">{s.callout.title}</span>
              <div class="prose" set:html={rich(s.callout.text)} />
            </aside>
          )}
        </div>
      </section>
    ))
  }

  <section class="lab-brief__section" id="mistakes" aria-labelledby="mistakes-h">
    <SectionHead no={extra.mistakes} title="Common mistakes" id="mistakes-h" />
    <div class="lab-brief__mistakes">
      {
        b.misconceptions.map((m) => (
          <div class="misconception">
            <div class="misconception__claim">
              <span class="misconception__label">The mistake</span>
              <p>{m.claim}</p>
            </div>
            <div class="misconception__fix">
              <span class="misconception__label">Why it is wrong</span>
              <div set:html={rich(m.correction)} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lab-brief__section" id="terms" aria-labelledby="terms-h">
    <SectionHead no={extra.terms} title="Key terms" dek="Start-up terms the IB course does not use are defined here, as enrichment. Terms from the course link to the platform's glossary." id="terms-h" />
    {
      b.terms.length > 0 && (
        <dl class="lab-defs">
          {b.terms.map((t) => (
            <div>
              <dt>
                {t.term} <ProvenanceTag kind="enrichment" />
              </dt>
              <dd set:html={rich(t.definition)} />
            </div>
          ))}
        </dl>
      )
    }
    {
      glossary.length > 0 && (
        <div class="lab-brief__glossary">
          <h3 class="lab-label">From the IB course glossary</h3>
          <ul class="lab-ib" role="list">
            {glossary.map((g) => (
              <li>
                <a class="lab-chip" href={`/glossary/${g.id}/`}>
                  {g.term}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="lab-brief__section" id="check" aria-labelledby="check-h">
    <SectionHead no={extra.check} title="Check your understanding" dek="The platform's own questions, not IB questions. Try each one before opening the answer." id="check-h" />
    <ol class="lab-brief__questions">
      {
        b.questions.map((q) => (
          <li>
            <p class="lab-brief__q">{q.q}</p>
            <details class="disclosure">
              <summary>Answer</summary>
              <div class="disclosure__body prose" set:html={rich(q.a)} />
            </details>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="lab-brief__section" id="use" aria-labelledby="use-h">
    <SectionHead no={extra.use} title="Use it" dek="Put the briefing to work on Refill Round's example, then on your own idea." id="use-h" />
    <ul class="lab-brief__tools" role="list">
      {
        b.tools.map((t) => {
          const tool = tools[t];
          return (
            tool && (
              <li class="lab-brief__tool">
                <a href={labHref(t)} class="lab-brief__tool-link">
                  {tool.title}
                </a>
                <span class="small">{tool.summary}</span>
              </li>
            )
          );
        })
      }
    </ul>
  </section>

  <section class="lab-brief__section" id="register" aria-labelledby="register-h">
    <SectionHead no={extra.register} title="What is IB content here, and what is not" dek="Each idea in this briefing, checked against the IB Business management guide (first assessment 2024)." id="register-h" />
    <div class="table-scroll" role="region" aria-label="IB status of each idea in this briefing" tabindex="0">
      <table class="table">
        <caption class="sr-only">Each idea, whether it is IB content, a toolkit tool or enrichment, and where it sits in the guide</caption>
        <thead>
          <tr><th scope="col">Idea</th><th scope="col">Status</th><th scope="col">In the guide</th></tr>
        </thead>
        <tbody>
          {
            b.ideas.map((x) => (
              <tr>
                <th scope="row">{x.idea}</th>
                <td>
                  {x.status === 'enrichment' ? <ProvenanceTag kind="enrichment" /> : <span class="tag tag--ib">{STATUS[x.status]}</span>}
                </td>
                <td>
                  <div class="lab-brief__where">
                    {x.status === 'enrichment' ? (
                      <span class="small">{x.codes.length ? 'Not in the guide. Related to:' : 'Not in the guide.'}</span>
                    ) : x.status === 'toolkit' ? (
                      <span class="small">
                        <a href="/toolkit/">Toolkit</a>, guide p. {x.page}
                      </span>
                    ) : (
                      <span class="small">Guide, p. {x.page}{x.codes.length ? ':' : ''}</span>
                    )}
                    <IbChips codes={x.codes} />
                    <span class="small muted">{x.note}</span>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="small muted lab-brief__basis">
      Written in the platform's own words. Checked against: {b.basis.map((x) => `${c.sources[x.source]?.title ?? x.source}${x.pages ? `, pp. ${x.pages}` : ''}`).join('; ')}. Every business named is fictional and every figure simulated. Updated {new Date(`${b.updated}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}.
    </p>
  </section>
</article>

<style>
  .lab-brief {
    display: grid;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
  }

  .lab-brief__opening {
    display: grid;
    gap: var(--sp-6);
  }

  @media (min-width: 64rem) {
    .lab-brief__opening {
      grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 1fr);
      align-items: start;
    }
  }

  .lab-brief__question {
    display: grid;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-5);
    padding: var(--sp-4) 0 var(--sp-4) var(--sp-5);
    border-left: 3px solid var(--lab-accent);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--text-strong);
  }

  .lab-brief__question .lab-label {
    margin: 0;
    font-style: normal;
  }

  .lab-brief__intro .prose {
    max-width: var(--text-max);
  }

  .lab-brief__aside {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
  }

  .lab-brief__aside .lab-label {
    margin: 0;
  }

  .lab-brief__toc-h {
    margin-top: var(--sp-3) !important;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule-hair);
  }

  .lab-brief__toc {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding-left: 1.3em;
    font-size: 0.9375rem;
  }

  .lab-brief__toc li {
    padding: 0.15rem 0;
  }

  .lab-brief__section {
    scroll-margin-top: calc(var(--header-h) + var(--sp-4));
  }

  .lab-brief__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-3);
  }

  .lab-brief__tagset {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }

  .lab-brief__body {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--sp-5);
  }

  .lab-brief__body > .prose {
    max-width: var(--text-max);
  }

  .lab-brief__points {
    max-width: 56rem;
  }

  .lab-brief__table caption {
    padding-bottom: var(--sp-2);
  }

  .lab-brief__formulas {
    display: grid;
    gap: var(--sp-3);
  }

  @media (min-width: 52rem) {
    .lab-brief__formulas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .lab-brief__formulas .formula p {
    margin: 0;
  }

  .lab-brief__formulas .formula .lab-label {
    margin-bottom: var(--sp-2);
  }

  .lab-example {
    max-width: 52rem;
    padding: var(--sp-5);
    border-left: 3px solid var(--bb-ink);
  }

  .lab-example__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    margin: 0;
  }

  .lab-example__kicker .lab-label {
    margin: 0;
  }

  .lab-example__title {
    margin: var(--sp-2) 0 var(--sp-3);
    font-size: var(--fs-h4);
  }

  .lab-brief .callout {
    max-width: 52rem;
  }

  .lab-brief__mistakes {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }

  @media (min-width: 64rem) {
    .lab-brief__mistakes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lab-brief__mistakes p {
    margin: 0;
  }

  .lab-brief__glossary {
    margin-top: var(--sp-5);
  }

  .lab-brief__questions {
    display: grid;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    padding-left: 1.4em;
    max-width: 52rem;
  }

  .lab-brief__q {
    margin: 0 0 var(--sp-2);
    font-weight: 600;
    color: var(--text-strong);
  }

  .lab-brief__tools {
    display: grid;
    gap: var(--sp-3);
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .lab-brief__tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .lab-brief__tool {
    position: relative;
    display: grid;
    gap: var(--sp-1);
    margin: 0;
    padding: var(--sp-4);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--lab-accent);
    background: var(--surface-sheet);
  }

  .lab-brief__tool:hover {
    border-color: var(--bb-ink);
  }

  .lab-brief__tool:focus-within {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .lab-brief__tool-link {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--text-strong);
    text-decoration: none;
  }

  .lab-brief__tool-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .lab-brief__tool-link:focus-visible {
    outline: none;
  }

  .lab-brief__where {
    display: grid;
    gap: var(--sp-1);
    justify-items: start;
  }

  .lab-brief__basis {
    margin-top: var(--sp-4);
    max-width: var(--text-max);
  }
</style>
