---
/**
 * The inputs of a Financial Laboratory calculator: labelled fields with the
 * example business's figures, hints and error slots tied to each field, and
 * the reader's choice of currency (and, for break-even, of unit and period).
 * The form is shown only once the page's script runs; without JavaScript the
 * same figures appear as a list beside the worked result.
 */
import { BREAK_EVEN_DEFAULTS } from '../../lib/finance-lab/breakeven';
import { BUDGET_DEFAULTS } from '../../lib/finance-lab/budget';
import { BUSINESS, SETTINGS } from '../../lib/finance-lab/business';
import { CASH_DEFAULTS, MAX_MONTHS, MONTH_NAMES } from '../../lib/finance-lab/cash';
import type { Family } from '../../lib/finance-lab/catalogue';
import { BREAK_EVEN_FIELDS, CURRENCIES, PERIODS, PL_FIELDS, RATIO_FIELDS, YEARS, fillLabel } from '../../lib/finance-lab/fields';
import { budgetGridHtml, cashGridHtml, yearsHtml } from '../../lib/finance-lab/forms';
import { INVESTMENT_DEFAULTS } from '../../lib/finance-lab/investment';
import { RATES } from '../../lib/investment';
import { ratioDefaults, type RatioLabId } from '../../lib/finance-lab/ratios';
import { STATEMENT_DEFAULTS } from '../../lib/finance-lab/statement';
import type { FieldSpec } from '../../lib/finance-lab/types';

interface Props {
  id: string;
  family: Family;
  uid: string;
}
const { id, family, uid } = Astro.props;
const S = SETTINGS;

interface FieldView {
  spec: FieldSpec;
  name: string;
  value: number;
  fid: string;
  label: string;
}
const view = (spec: FieldSpec, name: string, value: number, label = fillLabel(spec.label, S)): FieldView => ({ spec, name, value, fid: `${uid}-${name.replace(/\./g, '-')}`, label });
/** A default as it appears in its field: money that is not a whole number keeps two decimals (14.40, not 14.4). */
const shown = (f: FieldView) => (f.spec.kind === 'money' && !Number.isInteger(f.value) ? f.value.toFixed(2) : String(f.value));

const simple: FieldView[] =
  family === 'breakeven'
    ? (BREAK_EVEN_FIELDS[id] ?? []).map((f) => view(f, f.key, BREAK_EVEN_DEFAULTS[f.key as keyof typeof BREAK_EVEN_DEFAULTS]))
    : family === 'statement'
      ? [PL_FIELDS.salesRevenue].map((f) => view(f, f.key, STATEMENT_DEFAULTS.salesRevenue))
      : [];
const plStock = family === 'statement' ? [PL_FIELDS.openingStock, PL_FIELDS.purchases, PL_FIELDS.closingStock].map((f) => view(f, f.key, STATEMENT_DEFAULTS[f.key as 'openingStock'])) : [];
const plDirect = family === 'statement' ? [view(PL_FIELDS.costOfSales, 'costOfSales', STATEMENT_DEFAULTS.costOfSales)] : [];
const plRest = family === 'statement' ? [PL_FIELDS.expenses, PL_FIELDS.interest, PL_FIELDS.tax, PL_FIELDS.dividends].map((f) => view(f, f.key, STATEMENT_DEFAULTS[f.key as 'expenses'])) : [];
const ratioYears =
  family === 'ratios'
    ? YEARS.map((y) => ({ ...y, fields: (RATIO_FIELDS[id] ?? []).map((f) => view(f, `${y.key}.${f.key}`, ratioDefaults(id as RatioLabId)[y.key][f.key] ?? 0, f.label)) }))
    : [];
const negativeOk = (f: FieldSpec) => f.min === undefined;
const errId = `${uid}-grid-err`;
const cashModel = {
  startMonth: CASH_DEFAULTS.startMonth,
  months: CASH_DEFAULTS.months,
  inflows: CASH_DEFAULTS.inflows.map((l) => ({ id: l.id, label: l.label, values: l.values.map(String) })),
  outflows: CASH_DEFAULTS.outflows.map((l) => ({ id: l.id, label: l.label, values: l.values.map(String) })),
};
const budgetModel = { lines: BUDGET_DEFAULTS.lines.map((l) => ({ id: l.id, label: l.label, kind: l.kind, budget: String(l.budget), actual: String(l.actual) })) };
const showUnits = family === 'breakeven';
---

<form class="fl-form js-only" data-fl-form novalidate aria-label="Your figures">
  {
    (family === 'breakeven' || family === 'statement') && (
      <fieldset class="fl-fields">
        <legend class="label label--ink">Your figures</legend>
        {simple.map((f) => (
          <div class="field">
            <label for={f.fid}>
              <span data-tpl={f.spec.label}>{f.label}</span>
            </label>
            <div class="affix">
              {f.spec.kind === 'money' && (
                <span class="affix__pre" aria-hidden="true" data-affix="currency">
                  {S.currency.trim()}
                </span>
              )}
              <input
                class="input input--num"
                type="text"
                inputmode={negativeOk(f.spec) ? undefined : 'decimal'}
                autocomplete="off"
                id={f.fid}
                name={f.name}
                value={shown(f)}
                data-default={shown(f)}
                data-num
                aria-invalid="false"
                aria-describedby={`${f.fid}-err${f.spec.hint ? ` ${f.fid}-hint` : ''}`}
              />
              {f.spec.kind === 'count' && (
                <span class="affix__post" aria-hidden="true" data-affix="units">
                  {S.units}
                </span>
              )}
            </div>
            {f.spec.hint && (
              <span class="field__hint" id={`${f.fid}-hint`}>
                {f.spec.hint}
              </span>
            )}
            <span class="field__error" id={`${f.fid}-err`} data-err={f.name} />
          </div>
        ))}
        {family === 'statement' && (
          <>
            <fieldset class="fl-choice">
              <legend class="field__label">Cost of sales</legend>
              <label class="fl-choice__opt">
                <input type="radio" name="stockMode" value="1" checked data-num data-default="1" />
                <span>Work it out from stock and purchases</span>
              </label>
              <label class="fl-choice__opt">
                <input type="radio" name="stockMode" value="0" data-num data-default="1" />
                <span>Enter it directly</span>
              </label>
            </fieldset>
            {[
              { mode: '1', fields: plStock },
              { mode: '0', fields: plDirect },
            ].map((g) => (
              <div class="fl-fields__group" data-mode={g.mode} hidden={g.mode === '0'}>
                {g.fields.map((f) => (
                  <div class="field">
                    <label for={f.fid}>{f.label}</label>
                    <div class="affix">
                      <span class="affix__pre" aria-hidden="true" data-affix="currency">
                        {S.currency.trim()}
                      </span>
                      <input class="input input--num" type="text" inputmode="decimal" autocomplete="off" id={f.fid} name={f.name} value={shown(f)} data-default={shown(f)} data-num aria-invalid="false" aria-describedby={`${f.fid}-err`} />
                    </div>
                    <span class="field__error" id={`${f.fid}-err`} data-err={f.name} />
                  </div>
                ))}
              </div>
            ))}
            {plRest.map((f) => (
              <div class="field">
                <label for={f.fid}>{f.label}</label>
                <div class="affix">
                  <span class="affix__pre" aria-hidden="true" data-affix="currency">
                    {S.currency.trim()}
                  </span>
                  <input
                    class="input input--num"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    id={f.fid}
                    name={f.name}
                    value={shown(f)}
                    data-default={shown(f)}
                    data-num
                    aria-invalid="false"
                    aria-describedby={`${f.fid}-err${f.spec.hint ? ` ${f.fid}-hint` : ''}`}
                  />
                </div>
                {f.spec.hint && (
                  <span class="field__hint" id={`${f.fid}-hint`}>
                    {f.spec.hint}
                  </span>
                )}
                <span class="field__error" id={`${f.fid}-err`} data-err={f.name} />
              </div>
            ))}
            <div class="field fl-fields__wide">
              <label for={`${uid}-entity`}>Name of the business</label>
              <input class="input" type="text" autocomplete="off" maxlength="80" id={`${uid}-entity`} name="entity" value={STATEMENT_DEFAULTS.entity} data-default={STATEMENT_DEFAULTS.entity} data-text />
            </div>
            <div class="field fl-fields__wide">
              <label for={`${uid}-period`}>Period</label>
              <input class="input" type="text" autocomplete="off" maxlength="80" id={`${uid}-period`} name="period" value={STATEMENT_DEFAULTS.period} data-default={STATEMENT_DEFAULTS.period} data-text aria-describedby={`${uid}-period-hint`} />
              <span class="field__hint" id={`${uid}-period-hint`}>
                As it heads the statement, for example “for the year ended 31 December 2025”.
              </span>
            </div>
          </>
        )}
      </fieldset>
    )
  }

  {
    family === 'ratios' && (
      <div class="fl-yeargrid">
        {ratioYears.map((y) => (
          <fieldset class="fl-fields fl-fields--year">
            <legend class="label label--ink">{y.label}</legend>
            {y.fields.map((f) => (
              <div class="field">
                <label for={f.fid}>{f.label}</label>
                <div class="affix">
                  <span class="affix__pre" aria-hidden="true" data-affix="currency">
                    {S.currency.trim()}
                  </span>
                  <input
                    class="input input--num"
                    type="text"
                    inputmode={negativeOk(f.spec) ? undefined : 'decimal'}
                    autocomplete="off"
                    id={f.fid}
                    name={f.name}
                    value={shown(f)}
                    data-default={shown(f)}
                    data-num
                    aria-invalid="false"
                    aria-describedby={`${f.fid}-err${f.spec.hint ? ` ${f.fid}-hint` : ''}`}
                  />
                </div>
                {f.spec.hint && (
                  <span class="field__hint" id={`${f.fid}-hint`}>
                    {f.spec.hint}
                  </span>
                )}
                <span class="field__error" id={`${f.fid}-err`} data-err={f.name} />
              </div>
            ))}
          </fieldset>
        ))}
      </div>
    )
  }

  {
    family === 'cash' && (
      <fieldset class="fl-fields">
        <legend class="label label--ink">Your forecast</legend>
        <div class="field">
          <label for={`${uid}-start`}>First month</label>
          <select class="select" id={`${uid}-start`} name="startMonth">
            {MONTH_NAMES.map((m, k) => (
              <option value={String(k)} selected={k === CASH_DEFAULTS.startMonth}>
                {m}
              </option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for={`${uid}-months`}>Number of months</label>
          <select class="select" id={`${uid}-months`} name="months" aria-describedby={`${uid}-months-err`}>
            {Array.from({ length: MAX_MONTHS }, (_, k) => k + 1).map((n) => (
              <option value={String(n)} selected={n === CASH_DEFAULTS.months}>
                {n}
              </option>
            ))}
          </select>
          <span class="field__error" id={`${uid}-months-err`} data-err="months" />
        </div>
        <div class="field">
          <label for={`${uid}-opening`}>Opening balance</label>
          <div class="affix">
            <span class="affix__pre" aria-hidden="true" data-affix="currency">
              {S.currency.trim()}
            </span>
            <input class="input input--num" type="text" autocomplete="off" id={`${uid}-opening`} name="opening" value={String(CASH_DEFAULTS.opening)} aria-invalid="false" aria-describedby={`${uid}-opening-err ${uid}-opening-hint`} />
          </div>
          <span class="field__hint" id={`${uid}-opening-hint`}>
            Negative if the account starts overdrawn.
          </span>
          <span class="field__error" id={`${uid}-opening-err`} data-err="opening" />
        </div>
        <div class="field">
          <label for={`${uid}-limit`}>Agreed overdraft limit</label>
          <div class="affix">
            <span class="affix__pre" aria-hidden="true" data-affix="currency">
              {S.currency.trim()}
            </span>
            <input class="input input--num" type="text" inputmode="decimal" autocomplete="off" id={`${uid}-limit`} name="overdraftLimit" value={String(CASH_DEFAULTS.overdraftLimit)} aria-invalid="false" aria-describedby={`${uid}-limit-err`} />
          </div>
          <span class="field__error" id={`${uid}-limit-err`} data-err="overdraftLimit" />
        </div>
      </fieldset>
    )
  }

  {
    family === 'budget' && (
      <fieldset class="fl-fields">
        <legend class="label label--ink">Your budget</legend>
        <div class="field fl-fields__wide">
          <label for={`${uid}-period`}>Period</label>
          <input class="input" type="text" autocomplete="off" maxlength="80" id={`${uid}-period`} name="period" value={BUDGET_DEFAULTS.period} aria-describedby={`${uid}-period-hint ${uid}-period-err`} />
          <span class="field__hint" id={`${uid}-period-hint`}>
            As it heads the budget, after “Budget for”.
          </span>
          <span class="field__error" id={`${uid}-period-err`} data-err="period" />
        </div>
      </fieldset>
    )
  }

  {
    family === 'investment' && (
      <fieldset class="fl-fields">
        <legend class="label label--ink">Your project</legend>
        <div class="field fl-fields__wide">
          <label for={`${uid}-label`}>Name of the project</label>
          <input class="input" type="text" autocomplete="off" maxlength="60" id={`${uid}-label`} name="label" value={INVESTMENT_DEFAULTS.label} />
        </div>
        <div class="field">
          <label for={`${uid}-cost`}>Capital cost (year 0)</label>
          <div class="affix">
            <span class="affix__pre" aria-hidden="true" data-affix="currency">
              {S.currency.trim()}
            </span>
            <input class="input input--num" type="text" inputmode="decimal" autocomplete="off" id={`${uid}-cost`} name="cost" value={String(INVESTMENT_DEFAULTS.capitalCost)} aria-invalid="false" aria-describedby={`${uid}-cost-err`} />
          </div>
          <span class="field__error" id={`${uid}-cost-err`} data-err="cost" />
        </div>
        {id === 'net-present-value' && (
          <div class="field">
            <label for={`${uid}-rate`}>Discount rate</label>
            <select class="select" id={`${uid}-rate`} name="rate" aria-describedby={`${uid}-rate-hint ${uid}-rate-err`}>
              {RATES.map((r) => (
                <option value={String(r)} selected={r === INVESTMENT_DEFAULTS.rate}>
                  {r}%
                </option>
              ))}
            </select>
            <span class="field__hint" id={`${uid}-rate-hint`}>
              The rates in the guide’s discount table (p. 66).
            </span>
            <span class="field__error" id={`${uid}-rate-err`} data-err="rate" />
          </div>
        )}
        <ol class="fl-years" data-years data-uid={uid} set:html={yearsHtml(INVESTMENT_DEFAULTS.returns.map(String), uid, S.currency)} />
        <p class="cluster fl-grid__actions">
          <button type="button" class="btn btn--small" data-act="add-year">Add a year</button>
          <button type="button" class="btn btn--small" data-act="remove-year">Remove the last year</button>
        </p>
        <p class="field__hint">A negative figure is a year in which more cash goes out than comes in.</p>
      </fieldset>
    )
  }

  {
    family === 'cash' && (
      <div class="fl-gridblock">
        <p class="label label--ink" id={`${uid}-grid-h`}>Inflows and outflows by month</p>
        <div class="table-scroll fl-grid-wrap" role="region" aria-labelledby={`${uid}-grid-h`} tabindex="0" data-grid data-err-id={errId} set:html={cashGridHtml(cashModel, errId)} />
        <p class="cluster fl-grid__actions">
          <button type="button" class="btn btn--small" data-act="add-inflow">Add an inflow</button>
          <button type="button" class="btn btn--small" data-act="add-outflow">Add an outflow</button>
        </p>
        <ul class="fl-errlist" id={errId} data-err-list hidden />
      </div>
    )
  }

  {
    family === 'budget' && (
      <div class="fl-gridblock">
        <p class="label label--ink" id={`${uid}-grid-h`}>Budgeted and actual figures</p>
        <div class="table-scroll fl-grid-wrap" role="region" aria-labelledby={`${uid}-grid-h`} tabindex="0" data-grid data-err-id={errId} set:html={budgetGridHtml(budgetModel, errId)} />
        <p class="cluster fl-grid__actions">
          <button type="button" class="btn btn--small" data-act="add-revenue">Add a revenue line</button>
          <button type="button" class="btn btn--small" data-act="add-cost">Add a cost line</button>
        </p>
        <ul class="fl-errlist" id={errId} data-err-list hidden />
      </div>
    )
  }

  <details class="fl-settings">
    <summary>Currency{showUnits && ', units and period'}</summary>
    <div class="fl-settings__body">
      <div class="field">
        <label for={`${uid}-currency`}>Currency</label>
        <select class="select" id={`${uid}-currency`} data-setting="currency">
          {
            CURRENCIES.map((c) => (
              <option value={c.value} selected={c.value === S.currency}>
                {c.label}
              </option>
            ))
          }
        </select>
      </div>
      {
        showUnits && (
          <>
            <div class="field">
              <label for={`${uid}-unit`}>One unit is called</label>
              <input class="input" type="text" autocomplete="off" maxlength="24" id={`${uid}-unit`} data-setting="unit" value={S.unit} />
            </div>
            <div class="field">
              <label for={`${uid}-units`}>More than one are called</label>
              <input class="input" type="text" autocomplete="off" maxlength="24" id={`${uid}-units`} data-setting="units" value={S.units} />
            </div>
            <div class="field">
              <label for={`${uid}-per`}>Period</label>
              <select class="select" id={`${uid}-per`} data-setting="period">
                {PERIODS.map((p) => (
                  <option value={p} selected={p === S.period}>
                    {p}
                  </option>
                ))}
              </select>
            </div>
          </>
        )
      }
      <p class="field__hint fl-settings__note">The labels, workings and results use these words. {BUSINESS.name}’s figures are in dollars{showUnits && ', bags and months'}.</p>
    </div>
  </details>
</form>
