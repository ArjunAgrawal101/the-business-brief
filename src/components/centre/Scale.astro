---
/** Parts of a paper or a mark total, drawn to scale. */
interface Part {
  label: string;
  marks: number;
  note?: string;
  tone?: 'navy' | 'gold' | 'slate';
}
interface Props {
  parts: Part[];
  total: number;
  caption: string;
}
const { parts, total, caption } = Astro.props;
---

<figure class="sc">
  <div class="sc__bar" role="img" aria-label={`${caption}: ${parts.map((p) => `${p.label}, ${p.marks} marks`).join('; ')}.`}>
    {
      parts.map((p) => (
        <div class:list={['sc__part', `sc__part--${p.tone ?? 'navy'}`]} style={`flex:${p.marks}`}>
          <span class="sc__label">{p.label}</span>
          <span class="sc__marks">{p.marks}</span>
        </div>
      ))
    }
  </div>
  <ol class="sc__axis" aria-hidden="true">
    {Array.from({ length: Math.floor(total / 5) + 1 }, (_, i) => i * 5).map((t) => <li style={`left:${(t / total) * 100}%`}>{t}</li>)}
  </ol>
  <figcaption class="sc__cap">
    {caption}
    {parts.some((p) => p.note) && <span class="sc__notes">{parts.filter((p) => p.note).map((p) => `${p.label}: ${p.note}`).join(' · ')}</span>}
  </figcaption>
</figure>

<style>
  .sc {
    margin: 0;
  }

  .sc__bar {
    display: flex;
    gap: 3px;
    min-height: 4.25rem;
  }

  .sc__part {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 2.5rem;
    padding: 0.5rem 0.6rem;
    color: var(--text-on-ink);
    background: var(--navy-900);
  }

  .sc__part--gold {
    background: var(--gold-500);
    color: var(--navy-950);
  }

  .sc__part--slate {
    background: var(--slate-500);
  }

  .sc__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.25;
  }

  .sc__marks {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
  }

  .sc__axis {
    position: relative;
    height: 1.25rem;
    margin: 0.3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .sc__axis li {
    position: absolute;
    top: 0.15rem;
    margin: 0;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .sc__axis li:first-child {
    transform: none;
  }

  .sc__cap {
    display: grid;
    gap: 0.2rem;
    margin-top: var(--sp-2);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
