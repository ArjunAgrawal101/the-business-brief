---
/**
 * The Paper 2 answer builder. Choose a calculation, enter the figures, and see
 * the answer laid out in full: formula, substitution, working, answer with its
 * unit. Without JavaScript the break-even example is shown worked in full.
 */
import GuideLabel from './GuideLabel.astro';
import { CALCS, calcById } from '../../lib/answer-builder';

const groups = [...new Set(CALCS.map((c) => c.group))];
const first = calcById('break-even')!;
const firstValues = Object.fromEntries(first.fields.map((f) => [f.id, f.value]));
const sol = first.solve(firstValues);
---

<div class="ab" data-ix="answer-builder">
  <div class="ab__head">
    <h3 class="ab__title">The answer builder</h3>
    <GuideLabel kind="strategy" />
    <GuideLabel kind="example" />
  </div>
  <p class="small muted">Formula, substitution, working, answer: the four stages examiners look for. Defaults are the Paper 2 guide's invented Kestrel Kayaks; change any figure.</p>
  <div class="ab__grid">
    <div class="ab__in">
      <label class="ab__f js-only">
        <span>Calculation</span>
        <select data-calc>
          {
            groups.map((g) => (
              <optgroup label={g}>
                {CALCS.filter((c) => c.group === g).map((c) => (
                  <option value={c.id} selected={c.id === first.id}>
                    {c.name}
                    {c.level === 'HL' ? ' (HL)' : ''}
                  </option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>
      <div class="ab__fields js-only" data-fields></div>
      <p class="nojs-only small">With JavaScript you can choose any of {CALCS.length} calculations and change the figures. Here is break-even, worked.</p>
    </div>
    <div class="ab__out" aria-live="polite" data-out>
      <dl class="ab__steps">
        <div><dt>Formula</dt><dd data-formula>{first.formula}</dd></div>
        {
          typeof sol !== 'string' && (
            <>
              <div><dt>Substitute</dt><dd data-sub>{sol.substitution}</dd></div>
              <div><dt>Working</dt><dd data-work>{sol.working.map((w) => <span>{w}</span>)}</dd></div>
              <div class="ab__answer"><dt>Answer</dt><dd data-answer>{sol.answer}</dd></div>
            </>
          )
        }
      </dl>
      <p class="ab__check small" data-check>{typeof sol !== 'string' ? sol.check : ''}</p>
      <p class="ab__meaning" data-meaning>{typeof sol !== 'string' ? sol.meaning : ''}</p>
      <div class="ab__errors">
        <p class="label">Where marks are lost</p>
        <ul data-errors>{first.errors.map((e) => <li>{e}</li>)}</ul>
      </div>
    </div>
  </div>
</div>

<style>
  .ab {
    padding: var(--sp-5);
    background: var(--surface-sheet);
    border-top: 3px solid var(--bb-cobalt);
    box-shadow: var(--shadow-sheet);
  }

  .ab__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-2);
  }

  .ab__title {
    font-size: 1.375rem;
    margin-right: var(--sp-2);
  }

  .ab__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--sp-6);
    margin-top: var(--sp-4);
  }

  .ab__in,
  .ab__fields {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }

  .ab__f,
  .ab__fields :global(label) {
    display: grid;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .ab select,
  .ab__fields :global(input) {
    min-height: 2.5rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--rule-control);
    border-radius: var(--radius-2);
    background: #fff;
    color: var(--text-strong);
    font: 400 1rem/1.3 var(--font-ui);
    font-variant-numeric: tabular-nums;
  }

  .ab__out {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    background: var(--ivory-50);
    border-left: 3px solid var(--navy-900);
  }

  .ab__steps {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .ab__steps > :global(div) {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--sp-3);
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .ab__steps :global(dt) {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--brass-text);
    padding-top: 0.15rem;
  }

  .ab__steps :global(dd) {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--navy-900);
  }

  .ab__steps :global(.ab__answer dd) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .ab__check {
    color: var(--green-text);
  }

  .ab__meaning:empty,
  .ab__check:empty {
    display: none;
  }

  .ab__errors ul {
    margin: var(--sp-2) 0 0;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
  }

  .ab__steps :global(.ab__error) {
    color: var(--signal-text);
  }

  @media (max-width: 52rem) {
    .ab__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ab__steps > :global(div) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>

<script>
  import '../../scripts/centre/answer-builder';
</script>
