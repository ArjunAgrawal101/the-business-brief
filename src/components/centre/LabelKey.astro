---
/**
 * How to read the labels, and where the assessment content comes from. Open
 * on the Assessment Centre's front page; a closed disclosure on each
 * component's page, so the key is there without repeating in full.
 */
import GuideLabel from './GuideLabel.astro';
import { LABEL_MEANING, type Standing } from '../../lib/guide-labels';

interface Props {
  /** A closed disclosure instead of an open panel. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const ORDER: Standing[] = ['ib', 'examiner', 'strategy', 'example', 'tsm'];
---

{
  compact ? (
    <details class="lk lk--compact">
      <summary class="lk__sum">How to read the labels</summary>
      <dl class="lk__list">
        {ORDER.map((k) => (
          <div>
            <dt>
              <GuideLabel kind={k} />
            </dt>
            <dd>{LABEL_MEANING[k]}</dd>
          </div>
        ))}
      </dl>
      <p class="lk__src">
        Requirements were checked against the IB guide itself. Examiner emphasis is given as the creator's assessment guides state it, with the guide named
        beside it; the subject reports they cite were not supplied to this platform. <a href="/assessment/#ac-labels-h">More on the sources</a>
      </p>
    </details>
  ) : (
    <aside class="lk" aria-labelledby="lk-h">
      <h2 id="lk-h" class="lk__h">
        How to read the labels
      </h2>
      <dl class="lk__list">
        {ORDER.map((k) => (
          <div>
            <dt>
              <GuideLabel kind={k} />
            </dt>
            <dd>{LABEL_MEANING[k]}</dd>
          </div>
        ))}
      </dl>
      <p class="lk__src">
        The explanations are built from the creator's four assessment guides (IA, Paper 1, Paper 2, Paper 3). Every requirement was checked against the IB
        Business management guide itself, first assessment 2024, in the edition supplied to the platform (published February 2022, updated May 2022), and
        is given with its page; the assessment guides cite the guide as updated July 2024. Examiner emphasis is given as the assessment guides state it,
        with the guide named beside it: they cite IB subject reports from May 2024 to May 2026, which were not supplied to this platform, so it has not
        checked them. Markbands and criteria appear only as brief paraphrases with their pages, never in the guide's wording. Nothing here predicts a
        grade or approves a piece of work.
      </p>
    </aside>
  )
}

<style>
  .lk {
    padding: var(--sp-5);
    background: var(--surface-sheet);
    border-top: 3px solid var(--navy-900);
  }

  .lk__h {
    font-size: 1.25rem;
  }

  .lk--compact {
    padding: 0;
    border-top: 0;
    border-bottom: 1px solid var(--rule-hair);
    background: transparent;
  }

  .lk__sum {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-strong);
    cursor: pointer;
  }

  .lk--compact[open] {
    padding-bottom: var(--sp-4);
  }

  .lk__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--sp-3) var(--sp-5);
    margin: var(--sp-4) 0 0;
  }

  .lk__list dd {
    margin: var(--sp-2) 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .lk__src {
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule-hair);
    max-width: 60rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
