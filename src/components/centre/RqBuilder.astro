---
/**
 * The research question builder: from an organization, a real issue, the
 * decision and one key concept to a draft question, checked as the reader
 * types against the guide's requirements for the question (p. 53, through
 * checkQuestion in src/lib/ia-tools.ts), with the IA research guide's six
 * tests to tick before the teacher approves it. Each check says its standing.
 * It drafts nothing the reader cannot change, and approves nothing.
 */
import GuideLabel from './GuideLabel.astro';
import { CONCEPTS, CONCEPT_NAMES, QUESTION_TESTS } from '../../lib/ia-tools';
---

<div class="rq" data-ix="rq-builder">
  <p class="state state--error" data-error hidden>The builder could not start. The six tests below still work on paper.</p>
  <div class="rq__head">
    <h3 class="rq__title">Build your research question</h3>
    <GuideLabel kind="ib" />
    <GuideLabel kind="strategy" />
  </div>
  <p class="nojs-only state">The builder needs JavaScript. The six tests below work on paper: write your question, then check it against each one.</p>
  <div class="rq__grid js-only">
    <div class="rq__form">
      <label class="rq__f">
        <span>1 · The organization</span>
        <input type="text" data-f="org" placeholder="One real organization you can research" autocomplete="off" />
      </label>
      <label class="rq__f">
        <span>2 · The real issue it faces</span>
        <input type="text" data-f="issue" placeholder="For example: turns customers away at weekends" autocomplete="off" />
      </label>
      <fieldset class="rq__f">
        <legend>3 · The kind of question</legend>
        <label class="rq__opt"><input type="radio" name="rq-form" value="forward" checked /> Forward looking: a decision still to be made</label>
        <label class="rq__opt"><input type="radio" name="rq-form" value="backward" /> Backward looking: a decision already taken</label>
      </fieldset>
      <label class="rq__f" data-when="forward">
        <span>4 · The decision to be made</span>
        <input type="text" data-f="decision" placeholder="For example: open a second shop in Eastgate" autocomplete="off" />
      </label>
      <label class="rq__f" data-when="backward" hidden>
        <span>4 · The decision already taken</span>
        <input type="text" data-f="taken" placeholder="For example: its seasonal range" autocomplete="off" />
      </label>
      <label class="rq__f" data-when="backward" hidden>
        <span>What it was meant to achieve</span>
        <input type="text" data-f="aim" placeholder="For example: attracted new customers" autocomplete="off" />
      </label>
      <label class="rq__f">
        <span>5 · The key concept that is your lens</span>
        <select data-f="concept">{CONCEPTS.map((k) => <option value={k}>{CONCEPT_NAMES[k]}</option>)}</select>
      </label>
    </div>
    <div class="rq__out">
      <p class="label">Your question, to refine</p>
      <textarea class="rq__q" data-q rows="3" aria-label="Your research question" aria-describedby="rq-checks-h"></textarea>
      <p class="rq__lens" data-lens></p>
      <p class="rq__warn" data-warn hidden></p>
      <p class="small muted" data-alt></p>
      <p class="label" id="rq-checks-h">Checked against the guide</p>
      <ul class="it-list" data-guide aria-live="polite" aria-labelledby="rq-checks-h"></ul>
    </div>
  </div>
  <fieldset class="rq__tests">
    <legend>Six tests before your teacher approves it</legend>
    <ul>
      {
        QUESTION_TESTS.map((t) => (
          <li>
            <label>
              <input type="checkbox" value={t.id} /> <b>{t.name}:</b> {t.text}.
            </label>
          </li>
        ))
      }
    </ul>
    <p class="rq__count js-only" data-count aria-live="polite"></p>
  </fieldset>
  <p class="small muted">
    The checks against the guide test the question's form, never its quality: your teacher approves the question before work starts (guide, p. 53). The six
    tests come from the creator's IA research guide, and the drafting is the platform's technique: a recommended strategy, not IB rules. Your work stays on
    this device.
  </p>
</div>

<style>
  .rq {
    padding: var(--sp-5);
    background: var(--surface-sheet);
    border-top: 3px solid var(--navy-900);
  }

  .rq__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }

  .rq__title {
    font-size: 1.375rem;
  }

  .rq__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-6);
    margin-top: var(--sp-4);
  }

  .rq__form {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }

  .rq__f {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rq__f > span,
  .rq__f legend {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .rq__f input[type='text'],
  .rq__f select,
  .rq__q {
    min-height: 2.5rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--rule-control);
    border-radius: var(--radius-2);
    background: var(--surface-sheet);
    color: var(--text-strong);
    font: 400 0.9375rem/1.4 var(--font-ui);
  }

  .rq__opt {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .rq__out {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background: var(--ivory-50);
    border-left: 3px solid var(--navy-900);
  }

  .rq__q {
    width: 100%;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    color: var(--navy-900);
    resize: vertical;
  }

  .rq__lens {
    font-size: 0.9375rem;
  }

  .rq__warn {
    padding: 0.5rem 0.7rem;
    background: var(--surface-partial);
    border-left: 3px solid var(--gold-500);
    font-size: 0.875rem;
  }

  .rq__tests {
    margin: var(--sp-5) 0 var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--rule-hair);
  }

  .rq__tests legend {
    padding: 0 0.3rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .rq__tests ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rq__tests li {
    margin: 0;
  }

  .rq__tests label {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .rq__count {
    margin-top: var(--sp-3);
    font-weight: 600;
    color: var(--navy-900);
  }

  @media (max-width: 52rem) {
    .rq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import '../../scripts/centre/rq-builder';
</script>
