---
/**
 * One label of standing (src/lib/guide-labels.ts): IB requirement, examiner
 * emphasis, recommended strategy, illustrative example, or advice from the
 * IB teacher support material. The words say the standing; the colour only
 * repeats it.
 */
import { LABEL_TEXT, type Standing } from '../../lib/guide-labels';

export type LabelKind = Standing;
interface Props {
  kind: Standing;
}
const { kind } = Astro.props;
---

<span class:list={['gl-label', `gl-label--${kind}`]}>{LABEL_TEXT[kind]}</span>

<style>
  .gl-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 100%;
    padding: 0.125rem 0.45rem;
    border: 1px solid transparent;
    border-radius: var(--radius-1);
    font: 600 0.75rem/1.3 var(--font-ui);
    letter-spacing: 0.04em;
  }

  .gl-label::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }

  .gl-label--ib {
    background: var(--navy-900);
    color: var(--text-on-ink);
  }

  .gl-label--ib::before {
    background: var(--gold-400);
  }

  .gl-label--examiner {
    background: var(--surface-gold-wash);
    color: var(--brass-text);
    border-color: var(--gold-500);
  }

  .gl-label--strategy {
    background: var(--surface-cobalt-wash);
    color: var(--cobalt-deep);
  }

  .gl-label--example {
    background: transparent;
    color: var(--text-muted);
    border: 1px dashed var(--rule-control);
  }

  .gl-label--tsm {
    background: var(--surface-sheet);
    color: var(--text-strong);
    border-color: var(--navy-900);
  }
</style>
