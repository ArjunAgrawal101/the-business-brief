---
/**
 * The four labels the creator's assessment guides use, so a reader always
 * knows the standing of what they are reading:
 *   IB requirement        the IB guide or examiner instructions
 *   Examiner emphasis     IB subject reports, as cited in the guides
 *   Recommended strategy  the platform's technique, not a rule
 *   Illustrative example  invented for teaching
 */
export type LabelKind = 'ib' | 'examiner' | 'strategy' | 'example';
interface Props {
  kind: LabelKind;
}
const { kind } = Astro.props;
const TEXT: Record<LabelKind, string> = {
  ib: 'IB requirement',
  examiner: 'Examiner emphasis',
  strategy: 'Recommended strategy',
  example: 'Illustrative example',
};
---

<span class:list={['gl-label', `gl-label--${kind}`]}>{TEXT[kind]}</span>

<style>
  .gl-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font: 600 0.6875rem/1.3 var(--font-ui);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .gl-label::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }

  .gl-label--ib {
    background: var(--navy-900);
    color: var(--text-on-ink);
  }

  .gl-label--ib::before {
    background: var(--gold-400);
  }

  .gl-label--examiner {
    background: var(--surface-gold-wash);
    color: var(--brass-text);
    border: 1px solid var(--gold-500);
  }

  .gl-label--strategy {
    background: var(--surface-cobalt-wash);
    color: var(--cobalt-deep);
  }

  .gl-label--example {
    background: transparent;
    color: var(--text-muted);
    border: 1px dashed var(--rule-control);
  }
</style>
